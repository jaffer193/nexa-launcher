ickListener(v ->
+                mPicker.launch(new String[]{"application/zip", "application/octet-stream", "*/*"}));
+        refresh();
+    }
+
+    private void refresh() {
+        mPacks.clear();
+        mLabels.clear();
+        try {
+            File gameDir = getGameDir();
+            List<String> enabled = ResourcePackManager.readEnabled(gameDir);
+            for (String name : ResourcePackManager.listPacks(gameDir)) {
+                mPacks.add(name);
+                mLabels.add(enabled.contains(name) ? name + getString(R.string.nexa_rp_enabled_suffix) : name);
+            }
+        } catch (RuntimeException ignored) { }
+        mAdapter.notifyDataSetChanged();
+        mEmpty.setVisibility(mPacks.isEmpty() ? View.VISIBLE : View.GONE);
+    }
+
+    private void showActions(String packName) {
+        final File gameDir = getGameDir();
+        boolean isEnabled = ResourcePackManager.readEnabled(gameDir).contains(packName);
+        String[] actions = {
+                getString(isEnabled ? R.string.nexa_rp_disable : R.string.nexa_rp_enable),
+                getString(R.string.nexa_rp_delete)
+        };
+        new AlertDialog.Builder(requireContext())
+                .setTitle(packName)
+                .setItems(actions, (dialog, which) -> {
+                    try {
+                        if (which == 0) ResourcePackManager.setEnabled(gameDir, packName, !isEnabled);
+                        else ResourcePackManager.delete(gameDir, packName);
+                    } catch (IOException e) {
+                        Tools.showError(requireContext(), e);
+                    }
+                    refresh();
+                })
+                .show();
+    }
+
+    private void importPack(@Nullable Uri uri) {
+        if (uri == null) return;
+        final ContentResolver resolver = requireContext().getContentResolver();
+        final File packDir = ResourcePackManager.getPackDir(getGameDir());
+        PojavApplication.sExecutorService.execute(() -> {
+            boolean ok = false;
+            try {
+                String name = queryName(resolver, uri);
+                if (name == null || name.isEmpty()) name = "pack.zip";
+                name = name.replaceAll("[\\\\/:*?\"<>|]", "_");
+                packDir.mkdirs();
+                try (InputStream in = resolver.openInputStream(uri);
+                     OutputStream out = new FileOutputStream(new File(packDir, name))) {
+                    if (in != null) {
+                        byte[] buffer = new byte[8192];
+                        int read;
+                        while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+                        ok = true;
+                    }
+                }
+            } catch (IOException | RuntimeException e) {
+                e.printStackTrace();
+            }
+            final boolean success = ok;
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                Toast.makeText(requireContext(),
+                        success ? R.string.nexa_rp_added : R.string.nexa_rp_failed,
+                        Toast.LENGTH_SHORT).show();
+                refresh();
+            });
+        });
+    }
+
+    @Nullable
+    private static String queryName(ContentResolver resolver, Uri uri) {
+        try (Cursor cursor = resolver.query(uri, new String[]{OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) return cursor.getString(0);
+        } catch (RuntimeException ignored) { }
+        return null;
+    }
+}
