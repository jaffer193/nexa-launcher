+            return;
+        }
+        String fileName = mPrefs.getString(modKey(feature, modsDir), null);
+        if (fileName != null) {
+            File enabled = new File(modsDir, fileName);
+            File disabled = new File(modsDir, fileName + ".disabled");
+            if (enabled.exists()) {
+                if (enabled.renameTo(disabled)) toast(mActivity.getString(R.string.nexa_client_mod_disabled, feature.name));
+                refreshCards();
+                return;
+            }
+            if (disabled.exists()) {
+                if (disabled.renameTo(enabled)) toast(mActivity.getString(R.string.nexa_client_mod_enabled, feature.name));
+                refreshCards();
+                return;
+            }
+        }
+        installMod(feature, modsDir);
+    }
+
+    /** Looks the mod up on Modrinth for the profile's Minecraft version and loader, then downloads it */
+    private void installMod(final Feature feature, final File modsDir) {
+        if (!sInstalling.compareAndSet(false, true)) {
+            toast(mActivity.getString(R.string.nexa_pack_busy));
+            return;
+        }
+        toast(mActivity.getString(R.string.nexa_client_installing, feature.name));
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            boolean offerReplayPage = false;
+            try {
+                String versionId = LauncherProfiles.getCurrentProfile().lastVersionId;
+                String loader = QuickPackInstaller.detectLoader(versionId);
+                String mcVersion = QuickPackInstaller.detectMcVersion(versionId, loader);
+                if (loader == null || mcVersion == null) {
+                    message = mActivity.getString(R.string.nexa_client_need_modded);
+                } else {
+                    String savedName = null;
+                    String savedTitle = null;
+                    for (ModrinthHelper.Hit hit : ModrinthHelper.search(feature.query, "mod", mcVersion, loader, "downloads", 6)) {
+                        if (feature.mustContain != null
+                                && !hit.title.toLowerCase().contains(feature.mustContain)) continue;
+                        String name = QuickPackInstaller.installProject(hit.slug, mcVersion, loader, modsDir);
+                        if (name != null) {
+                            savedName = name;
+                            savedTitle = hit.title;
+                            break;
+                        }
+                    }
+                    if (savedName != null) {
+                        mPrefs.edit().putString(modKey(feature, modsDir), savedName).apply();
+                        message = mActivity.getString(R.string.nexa_client_installed, savedTitle);
+                    } else if ("replay".equals(feature.id)) {
+                        message = mActivity.getString(R.string.nexa_client_replay_unsupported);
+                        offerReplayPage = true;
+                    } else {
+                        message = mActivity.getString(R.string.nexa_client_not_available, feature.name);
+                    }
+                }
+            } catch (Exception e) {
+                e.printStackTrace();
+                message = mActivity.getString(R.string.nexa_client_install_failed, feature.name);
+            } finally {
+                sInstalling.set(false);
+            }
+            final String finalMessage = message;
+            final boolean showReplayPage = offerReplayPage;
+            mActivity.runOnUiThread(() -> {
+                refreshCards();
+                if (showReplayPage) {
+                    new AlertDialog.Builder(mActivity)
+                            .setTitle(feature.name)
+                            .setMessage(finalMessage)
+                            .setPositiveButton(R.string.nexa_client_open_page,
+                                    (d, w) -> Tools.openURL(mActivity, REPLAY_PAGE))
+                            .setNegativeButton(android.R.string.cancel, null)
+                            .show();
+                } else {
+                    toast(finalMessage);
+                }
+            });
+        });
+    }
+
+    // ---- Options dialog ------------------------------------------------------------------------
+
+    private void showOptions(final Feature feature) {
+        AlertDialog.Builder builder = new AlertDialog.Builder(mActivity).setTitle(feature.name);
+        if (feature.hud) {
+            boolean background = mPrefs.getBoolean(NexaHudView.bgKey(feature.id), true);
+            float scale = mPrefs.getFloat(NexaHudView.scaleKey(feature.id), 1f);
+            String[] items = {
+                    mActivity.getString(background ? R.string.nexa_client_bg_on : R.string.nexa_client_bg_off),
+                    mActivity.getString(R.string.nexa_client_size, Math.round(scale * 100))
+            };
+            builder.setItems(items, (dialog, which) -> {
+                SharedPreferences.Editor editor = mPrefs.edit();
+                if (which == 0) {
+                    editor.putBoolean(NexaHudView.bgKey(feature.id), !background);
+                } else {
+                    int next = 0;
+                    for (int i = 0; i < SCALES.length; i++) {
+                        if (Math.abs(SCALES[i] - scale) < 0.01f) next = (i + 1) % SCALES.length;
+                    }
+                    editor.putFloat(NexaHudView.scaleKey(feature.id), SCALES[next]);
+                }
+                editor.apply();
+                mHud.reloadConfig();
+            });
+        } else if (feature.builtIn) {
+            builder.setMessage(mActivity.getString(R.string.nexa_client_toggle_help, feature.name));
+        } else {
+            File modsDir = getModsDir();
+            String fileName = modsDir == null ? null : mPrefs.getString(modKey(feature, modsDir), null);
+            String status = fileName == null
+                    ? mActivity.getString(R.string.nexa_client_mod_not_installed)
+                    : mActivity.getString(R.string.nexa_client_mod_file, fileName);
+            builder.setMessage(mActivity.getString(feature.descRes) + "\n\n" + status);
+        }
+        builder.setPositiveButton(android.R.string.ok, null).show();
+    }
+
+    private void toast(String text) {
+        mActivity.runOnUiThread(() -> Toast.makeText(mActivity, text, Toast.LENGTH_LONG).show());
+    }
+}
