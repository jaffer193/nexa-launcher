new file mode 100644
index 0000000..3968b41
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/QuickPackInstaller.java
@@ -0,0 +1,138 @@
+package net.kdt.pojavlaunch.modloaders.modpacks.api;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.modloaders.NeoForgeUtils;
+import net.kdt.pojavlaunch.nexa.ModGuard;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.regex.Pattern;
+
+/**
+ * Installs a fixed list of Modrinth mods (by project slug) into the mods folder of a profile.
+ * For each mod the newest version matching the profile's Minecraft version and loader is used.
+ * Mods that have no matching version are skipped.
+ */
+public final class QuickPackInstaller {
+    public static final String[] PACK_PERFORMANCE = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "entityculling", "immediatelyfast", "dynamic-fps"
+    };
+    public static final String[] PACK_PVP = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "modmenu", "appleskin", "logical-zoom", "freelook", "mouse-tweaks"
+    };
+    public static final String[] PACK_SURVIVAL = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "appleskin", "xaeros-minimap", "xaeros-world-map", "jade", "mouse-tweaks"
+    };
+
+    private static final Pattern VERSION_PATTERN = Pattern.compile("^\\d+\\.\\d+(\\.\\d+)?$");
+
+    public interface Listener {
+        void onProgress(String slug, int index, int total);
+    }
+
+    public static final class Result {
+        public int installed;
+        public int skipped;
+        /** True when the selected profile is not a modded one (or cannot be understood) */
+        public boolean needModdedProfile;
+    }
+
+    private QuickPackInstaller() {}
+
+    /** @return fabric, quilt, forge, neoforge or null when the profile is vanilla/unknown */
+    public static @Nullable String detectLoader(@Nullable String versionId) {
+        if (versionId == null) return null;
+        String id = versionId.toLowerCase();
+        if (id.contains("fabric-loader") || id.startsWith("fabric")) return "fabric";
+        if (id.contains("quilt-loader") || id.startsWith("quilt")) return "quilt";
+        if (id.contains("neoforge")) return "neoforge";
+        if (id.contains("forge")) return "forge";
+        return null;
+    }
+
+    /** Extracts the Minecraft version out of a modded version id such as fabric-loader-0.15.11-1.20.1 */
+    public static @Nullable String detectMcVersion(@Nullable String versionId, @Nullable String loader) {
+        if (versionId == null || loader == null) return null;
+        String[] parts = versionId.split("-");
+        if (loader.equals("fabric") || loader.equals("quilt")) {
+            for (int i = parts.length - 1; i >= 0; i--) {
+                if (VERSION_PATTERN.matcher(parts[i]).matches()) return parts[i];
+            }
+        } else if (loader.equals("neoforge")) {
+            // neoforge-21.1.172: the number is the NeoForge version, the Minecraft one is derived from it
+            for (String part : parts) {
+                if (VERSION_PATTERN.matcher(part).matches()) return NeoForgeUtils.toMinecraftVersion(part);
+            }
+        } else {
+            for (String part : parts) {
+                if (VERSION_PATTERN.matcher(part).matches()) return part;
+            }
+        }
+        return null;
+    }
+
+    /** @return the Minecraft version of a profile (vanilla or modded), or null when it is unknown */
+    public static @Nullable String resolveMcVersion(@Nullable String versionId) {
+        String loader = detectLoader(versionId);
+        if (loader != null) return detectMcVersion(versionId, loader);
+        if (versionId != null && VERSION_PATTERN.matcher(versionId).matches()) return versionId;
+        return null;
+    }
+
+    public static @NonNull Result install(@NonNull MinecraftProfile profile, @NonNull String[] slugs,
+                                          @Nullable Listener listener) {
+        Result result = new Result();
+        String loader = detectLoader(profile.lastVersionId);
+        String mcVersion = detectMcVersion(profile.lastVersionId, loader);
+        if (loader == null || mcVersion == null) {
+            result.needModdedProfile = true;
+            return result;
+        }
+
+        File modsDir = new File(Tools.getGameDirPath(profile), "mods");
+        for (int i = 0; i < slugs.length; i++) {
+            String slug = slugs[i];
+            if (listener != null) listener.onProgress(slug, i + 1, slugs.length);
+            try {
+                if (installProject(slug, mcVersion, loader, modsDir) != null) result.installed++;
+                else result.skipped++;
+            } catch (Exception e) {
+                e.printStackTrace();
+                result.skipped++;
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Installs the newest version of a Modrinth project for the Minecraft version and loader.
+     * @return the file name that was saved, or null when there is no matching version
+     */
+    public static @Nullable String installProject(@NonNull String slug, @NonNull String mcVersion,
+                                                  @NonNull String loader, @NonNull File modsDir) throws IOException {
+        ModrinthHelper.FileInfo file = ModrinthHelper.findFile(slug, mcVersion, loader);
+        if (file == null) return null;
+        // Download to a temporary folder first, so a wrong or duplicate mod never reaches the mods folder
+        File tempDir = new File(Tools.DIR_CACHE, "mod_check_" + System.nanoTime());
+        try {
+            File downloaded = ModrinthHelper.download(file, tempDir);
+            ModGuard.admit(downloaded, file.fileName, modsDir, new ModGuard.Target(loader, mcVersion));
+            return file.fileName;
+        } catch (ModGuard.RejectedException e) {
+            // Already installed counts as installed; anything else is simply not available here
+            return e.reason == ModGuard.Reason.ALREADY_INSTALLED ? e.existingFile : null;
+        } finally {
+            File[] left = tempDir.listFiles();
+            if (left != null) for (File f : left) f.delete();
+            //noinspection ResultOfMethodCallIgnored
+            tempDir.delete();
+        }
+    }
+}
