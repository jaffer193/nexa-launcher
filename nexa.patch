@@ -0,0 +1,210 @@
+package net.kdt.pojavlaunch.fragments;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.PojavProfile;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.nexa.NexaTheme;
+import net.kdt.pojavlaunch.nexa.SkinEditor;
+import net.kdt.pojavlaunch.nexa.SkinPreview;
+import net.kdt.pojavlaunch.nexa.SkinUploader;
+import net.kdt.pojavlaunch.value.MinecraftAccount;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+
+/**
+ * Skin screen: shows the skin of the account, lets the user draw on it or pick a PNG file,
+ * and puts it where the game will use it (Mojang for official accounts, CustomSkinLoader for
+ * local ones, a saved file for Ely.by accounts).
+ */
+public class SkinFragment extends Fragment {
+    public static final String TAG = "SkinFragment";
+
+    private ImageView mPreview;
+    private TextView mStatus;
+    private @Nullable Bitmap mSkin;
+    private boolean mBack = false;
+
+    private final ActivityResultLauncher<String> mPicker =
+            registerForActivityResult(new ActivityResultContracts.GetContent(), this::onFilePicked);
+
+    public SkinFragment() {
+        super(R.layout.fragment_skin);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        NexaTheme.applyBackground(view);
+        mPreview = view.findViewById(R.id.skin_preview);
+        mStatus = view.findViewById(R.id.skin_status);
+        view.findViewById(R.id.skin_edit).setOnClickListener(v -> editSkin());
+        view.findViewById(R.id.skin_choose).setOnClickListener(v -> mPicker.launch("image/png"));
+        view.findViewById(R.id.skin_turn).setOnClickListener(v -> {
+            mBack = !mBack;
+            showSkin();
+        });
+        view.findViewById(R.id.skin_apply).setOnClickListener(v -> askApply());
+
+        loadCurrentSkin();
+    }
+
+    private void loadCurrentSkin() {
+        final MinecraftAccount account = PojavProfile.getCurrentProfileContent(requireContext(), null);
+        if (account == null) {
+            mStatus.setText(R.string.nexa_skin_no_account);
+            return;
+        }
+        mStatus.setText(getString(R.string.nexa_skin_for, account.username, accountType(account)));
+        PojavApplication.sExecutorService.execute(() -> {
+            Bitmap loaded = null;
+            try {
+                Bitmap downloaded = SkinPreview.loadSkin(account);
+                if (downloaded != null) loaded = SkinPreview.normalize(downloaded);
+            } catch (IOException | RuntimeException e) {
+                e.printStackTrace();
+            }
+            final Bitmap result = loaded;
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                if (result == null) {
+                    // No skin on the server: start from an empty texture the user can draw on
+                    mSkin = Bitmap.createBitmap(64, 64, Bitmap.Config.ARGB_8888);
+                    Toast.makeText(requireContext(), R.string.nexa_skin_empty_start, Toast.LENGTH_LONG).show();
+                } else {
+                    mSkin = result;
+                }
+                showSkin();
+            });
+        });
+    }
+
+    private String accountType(MinecraftAccount account) {
+        if (account.isElyBy) return "Ely.by";
+        return account.isMicrosoft ? "Microsoft" : "Local";
+    }
+
+    private void showSkin() {
+        if (mSkin != null) mPreview.setImageBitmap(SkinPreview.render(mSkin, mBack));
+    }
+
+    private void editSkin() {
+        if (mSkin == null) {
+            Toast.makeText(requireContext(), R.string.nexa_skin_loading, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        SkinEditor.show(requireActivity(), mSkin, edited -> {
+            mSkin = edited;
+            showSkin();
+        });
+    }
+
+    private void onFilePicked(@Nullable android.net.Uri uri) {
+        if (uri == null) return;
+        try (InputStream in = requireContext().getContentResolver().openInputStream(uri)) {
+            Bitmap picked = in == null ? null : BitmapFactory.decodeStream(in);
+            if (picked == null || picked.getWidth() < 64 || (picked.getHeight() != picked.getWidth()
+                    && picked.getHeight() * 2 != picked.getWidth())) {
+                Toast.makeText(requireContext(), R.string.nexa_skin_bad_file, Toast.LENGTH_LONG).show();
+                return;
+            }
+            mSkin = SkinPreview.normalize(picked);
+            showSkin();
+        } catch (IOException | RuntimeException e) {
+            Toast.makeText(requireContext(), R.string.nexa_skin_bad_file, Toast.LENGTH_LONG).show();
+        }
+    }
+
+    // ---- Applying ------------------------------------------------------------------------------
+
+    private void askApply() {
+        final Bitmap skin = mSkin;
+        final MinecraftAccount account = PojavProfile.getCurrentProfileContent(requireContext(), null);
+        if (skin == null || account == null) {
+            Toast.makeText(requireContext(), R.string.nexa_skin_no_account, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        if (account.isElyBy) {
+            applyElyBy(account, skin);
+        } else if (account.isMicrosoft) {
+            new AlertDialog.Builder(requireContext())
+                    .setTitle(R.string.nexa_skin_variant)
+                    .setItems(new String[]{getString(R.string.nexa_skin_classic), getString(R.string.nexa_skin_slim)},
+                            (dialog, which) -> applyMojang(account, skin, which == 1))
+                    .show();
+        } else {
+            applyLocal(account, skin);
+        }
+    }
+
+    private void applyMojang(final MinecraftAccount account, final Bitmap skin, final boolean slim) {
+        final Context appContext = requireContext().getApplicationContext();
+        Toast.makeText(appContext, R.string.nexa_skin_uploading, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            try {
+                SkinUploader.uploadToMojang(account, skin, slim);
+                message = appContext.getString(R.string.nexa_skin_uploaded);
+            } catch (IOException | RuntimeException e) {
+                message = appContext.getString(R.string.nexa_skin_upload_failed, String.valueOf(e.getMessage()));
+            }
+            final String finalMessage = message;
+            Tools.runOnUiThread(() -> Toast.makeText(appContext, finalMessage, Toast.LENGTH_LONG).show());
+        });
+    }
+
+    private void applyLocal(final MinecraftAccount account, final Bitmap skin) {
+        final Context appContext = requireContext().getApplicationContext();
+        Toast.makeText(appContext, R.string.nexa_skin_saving, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            try {
+                message = SkinUploader.saveForCustomSkinLoader(account.username, skin);
+            } catch (IOException | RuntimeException e) {
+                message = appContext.getString(R.string.nexa_skin_upload_failed, String.valueOf(e.getMessage()));
+            }
+            final String finalMessage = message;
+            Tools.runOnUiThread(() -> Toast.makeText(appContext, finalMessage, Toast.LENGTH_LONG).show());
+        });
+    }
+
+    private void applyElyBy(final MinecraftAccount account, final Bitmap skin) {
+        final Context appContext = requireContext().getApplicationContext();
+        final android.app.Activity activity = requireActivity();
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            boolean saved = false;
+            try {
+                File file = SkinUploader.saveForUpload(account.username, skin);
+                message = appContext.getString(R.string.nexa_skin_ely_saved, file.getName(),
+                        file.getParentFile().getAbsolutePath());
+                saved = true;
+            } catch (IOException | RuntimeException e) {
+                message = appContext.getString(R.string.nexa_skin_upload_failed, String.valueOf(e.getMessage()));
+            }
+            final String finalMessage = message;
+            final boolean openPage = saved;
+            Tools.runOnUiThread(() -> {
+                Toast.makeText(appContext, finalMessage, Toast.LENGTH_LONG).show();
+                if (openPage) Tools.openURL(activity, "https://ely.by/skins");
+            });
+        });
+    }
+}
