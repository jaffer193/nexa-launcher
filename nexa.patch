@@ -0,0 +1,154 @@
+package net.kdt.pojavlaunch.nexa;
+
+import android.content.Context;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.extra.ExtraConstants;
+import net.kdt.pojavlaunch.extra.ExtraCore;
+import net.kdt.pojavlaunch.modloaders.FabricVersion;
+import net.kdt.pojavlaunch.modloaders.FabriclikeUtils;
+import net.kdt.pojavlaunch.modloaders.ForgeUtils;
+import net.kdt.pojavlaunch.modloaders.ModloaderDownloadListener;
+import net.kdt.pojavlaunch.modloaders.NeoForgeUtils;
+import net.kdt.pojavlaunch.modloaders.modpacks.ModloaderInstallTracker;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.ModLoader;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.List;
+
+/**
+ * Installs Fabric, Quilt, Forge or NeoForge for a profile, reusing the launcher's own mod loader
+ * pipeline (the same one the modpack installer uses):
+ * - Fabric/Quilt only need a version json, which is written right away.
+ * - Forge/NeoForge download the installer, and the {@link ModloaderInstallTracker} starts it.
+ * The profile is switched to the loader version once the loader is ready.
+ */
+public final class LoaderInstaller {
+    public static final int VANILLA = 0;
+    public static final int FABRIC = 1;
+    public static final int FORGE = 2;
+    public static final int NEOFORGE = 3;
+    public static final int QUILT = 4;
+
+    public static final String[] LABELS = {"Vanilla", "Fabric", "Forge", "NeoForge", "Quilt"};
+
+    private LoaderInstaller() {}
+
+    /** Forge-like loaders open a graphical installer, so they are installed when the wizard ends */
+    public static boolean needsGuiInstaller(int loader) {
+        return loader == FORGE || loader == NEOFORGE;
+    }
+
+    /**
+     * Finds the newest build of the loader for a Minecraft version.
+     * @return null when the loader does not support that Minecraft version
+     */
+    public static @Nullable ModLoader resolve(int loader, @NonNull String mcVersion) throws IOException {
+        switch (loader) {
+            case FABRIC:
+                return fabriclike(FabriclikeUtils.FABRIC_UTILS, ModLoader.MOD_LOADER_FABRIC, mcVersion);
+            case QUILT:
+                return fabriclike(FabriclikeUtils.QUILT_UTILS, ModLoader.MOD_LOADER_QUILT, mcVersion);
+            case FORGE: {
+                List<String> versions = ForgeUtils.downloadForgeVersions();
+                if (versions == null) return null;
+                String prefix = mcVersion + "-";
+                String newest = null;
+                // The metadata is sorted from the oldest to the newest build
+                for (String version : versions) {
+                    if (version.startsWith(prefix)) newest = version;
+                }
+                if (newest == null) return null;
+                return new ModLoader(ModLoader.MOD_LOADER_FORGE, newest.substring(prefix.length()), mcVersion);
+            }
+            case NEOFORGE: {
+                String version = NeoForgeUtils.findLatestVersion(NeoForgeUtils.downloadNeoForgeVersions(), mcVersion);
+                if (version == null) return null;
+                return new ModLoader(ModLoader.MOD_LOADER_NEOFORGE, version, mcVersion);
+            }
+            default:
+                return null;
+        }
+    }
+
+    private static @Nullable ModLoader fabriclike(FabriclikeUtils utils, int type, String mcVersion) throws IOException {
+        FabricVersion[] versions = utils.downloadLoaderVersions(mcVersion);
+        if (versions == null || versions.length == 0) return null;
+        FabricVersion chosen = versions[0];
+        for (FabricVersion version : versions) {
+            if (version.stable) {
+                chosen = version;
+                break;
+            }
+        }
+        return new ModLoader(type, chosen.version, mcVersion);
+    }
+
+    /**
+     * Installs the loader on top of the profile's current (vanilla) version in the background.
+     * Results are reported with toasts, so this can safely outlive the screen that started it.
+     */
+    public static void installAsync(@NonNull Context context, @NonNull String profileKey,
+                                    @NonNull MinecraftProfile profile, int loader) {
+        if (loader == VANILLA || profile.lastVersionId == null) return;
+        final Context app = context.getApplicationContext();
+        final String loaderName = LABELS[loader];
+        final String mcVersion = profile.lastVersionId;
+
+        toast(app, app.getString(R.string.cp_loader_installing, loaderName));
+        PojavApplication.sExecutorService.execute(() -> {
+            try {
+                final ModLoader modLoader = resolve(loader, mcVersion);
+                if (modLoader == null) {
+                    toast(app, app.getString(R.string.cp_loader_unavailable, loaderName, mcVersion));
+                    return;
+                }
+                ModloaderDownloadListener listener = new ModloaderDownloadListener() {
+                    @Override
+                    public void onDownloadFinished(File downloadedFile) {
+                        // The Forge/NeoForge installer fixes this id up if the real one differs
+                        // The profiles may have been reloaded meanwhile, so use the live object
+                        MinecraftProfile live = LauncherProfiles.mainProfileJson == null ? null
+                                : LauncherProfiles.mainProfileJson.profiles.get(profileKey);
+                        (live != null ? live : profile).lastVersionId = modLoader.getVersionId();
+                        LauncherProfiles.write();
+                        Tools.runOnUiThread(() ->
+                                ExtraCore.setValue(ExtraConstants.REFRESH_VERSION_SPINNER, profileKey));
+                        if (modLoader.requiresGuiInstallation()) {
+                            toast(app, app.getString(R.string.cp_loader_gui, loaderName));
+                            ModloaderInstallTracker.saveModLoader(app, modLoader, downloadedFile);
+                        } else {
+                            toast(app, app.getString(R.string.cp_loader_ready, loaderName));
+                        }
+                    }
+
+                    @Override
+                    public void onDataNotAvailable() {
+                        toast(app, app.getString(R.string.cp_loader_unavailable, loaderName, mcVersion));
+                    }
+
+                    @Override
+                    public void onDownloadError(Exception e) {
+                        toast(app, app.getString(R.string.cp_loader_failed, loaderName, String.valueOf(e.getMessage())));
+                    }
+                };
+                modLoader.getDownloadTask(listener).run();
+            } catch (IOException | RuntimeException e) {
+                toast(app, app.getString(R.string.cp_loader_failed, loaderName, String.valueOf(e.getMessage())));
+            }
+        });
+    }
+
+    private static void toast(Context context, String text) {
+        Tools.runOnUiThread(() -> Toast.makeText(context, text, Toast.LENGTH_LONG).show());
+    }
+}
diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/ModGuard.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/ModGuard.java
