+    /** Tap opens the menu, dragging moves the circle */
+    private final class BubbleTouchListener implements View.OnTouchListener {
+        private float mDownX, mDownY;
+        private int mStartLeft, mStartTop;
+        private boolean mMoved;
+        private final int mSlop = ViewConfiguration.get(mActivity).getScaledTouchSlop();
+
+        @Override
+        public boolean onTouch(View view, MotionEvent event) {
+            FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) view.getLayoutParams();
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    mDownX = event.getRawX();
+                    mDownY = event.getRawY();
+                    mStartLeft = params.leftMargin;
+                    mStartTop = params.topMargin;
+                    mMoved = false;
+                    return true;
+                case MotionEvent.ACTION_MOVE: {
+                    float dx = event.getRawX() - mDownX;
+                    float dy = event.getRawY() - mDownY;
+                    if (!mMoved && Math.hypot(dx, dy) > mSlop) mMoved = true;
+                    if (mMoved) {
+                        params.leftMargin = clamp(Math.round(mStartLeft + dx), 0, mParent.getWidth() - view.getWidth());
+                        params.topMargin = clamp(Math.round(mStartTop + dy), 0, mParent.getHeight() - view.getHeight());
+                        view.setLayoutParams(params);
+                    }
+                    return true;
+                }
+                case MotionEvent.ACTION_UP:
+                    if (!mMoved) {
+                        showPanel();
+                    } else if (mParent.getWidth() > 0 && mParent.getHeight() > 0) {
+                        mPrefs.edit()
+                                .putFloat("nexa_bubble_fx", params.leftMargin / (float) mParent.getWidth())
+                                .putFloat("nexa_bubble_fy", params.topMargin / (float) mParent.getHeight())
+                                .apply();
+                    }
+                    return true;
+                case MotionEvent.ACTION_CANCEL:
+                    return true;
+                default:
+                    return false;
+            }
+        }
+    }
