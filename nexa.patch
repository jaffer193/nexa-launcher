+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Helpers behind Settings > Advanced > FPS Booster */
+public final class FpsBooster {
+    public static final String PREF_JVM_FLAGS = "nexa_fps_jvm";
+
+    /** Lower-cost settings written to options.txt. Keys that a version does not know are ignored by Minecraft. */
+    private static final Map<String, String> OPTIONS = new LinkedHashMap<>();
+    static {
+        OPTIONS.put("renderDistance", "6");
+        OPTIONS.put("simulationDistance", "6");
+        OPTIONS.put("maxFps", "260");
+        OPTIONS.put("enableVsync", "false");
+        OPTIONS.put("entityShadows", "false");
+        OPTIONS.put("bobView", "false");
+        OPTIONS.put("particles", "2");
+        OPTIONS.put("mipmapLevels", "0");
+        OPTIONS.put("biomeBlendRadius", "0");
+        OPTIONS.put("entityDistanceScaling", "0.75");
+        OPTIONS.put("graphicsMode", "0");
+    }
+
+    private FpsBooster() {}
+
+    /** Adds safe JVM flags that reduce overhead on phones, unless the user already set them */
+    public static void addJvmFlags(@NonNull List<String> args) {
+        addIfAbsent(args, "-XX:+DisableExplicitGC");
+        addIfAbsent(args, "-XX:-UsePerfData");
+    }
+
+    private static void addIfAbsent(List<String> args, String flag) {
+        String opposite = flag.contains(":+") ? flag.replace(":+", ":-") : flag.replace(":-", ":+");
+        if (!args.contains(flag) && !args.contains(opposite)) args.add(flag);
+    }
+
+    /** Merges the performance options into the options.txt of a game directory */
+    public static void applyOptions(@NonNull File gameDir) throws IOException {
+        File file = new File(gameDir, "options.txt");
+        List<String> lines = new ArrayList<>();
+        if (file.exists()) {
+            try (BufferedReader reader = new BufferedReader(
+                    new InputStreamReader(new FileInputStream(file), StandardCharsets.UTF_8))) {
+                String line;
+                while ((line = reader.readLine()) != null) lines.add(line);
+            }
+        }
+        for (Map.Entry<String, String> option : OPTIONS.entrySet()) {
+            String prefix = option.getKey() + ":";
+            String newLine = prefix + option.getValue();
+            boolean replaced = false;
+            for (int i = 0; i < lines.size(); i++) {
+                if (lines.get(i).startsWith(prefix)) {
+                    lines.set(i, newLine);
+                    replaced = true;
+                    break;
+                }
+            }
+            if (!replaced) lines.add(newLine);
+        }
+        //noinspection ResultOfMethodCallIgnored
+        gameDir.mkdirs();
+        try (Writer writer = new OutputStreamWriter(new FileOutputStream(file), StandardCharsets.UTF_8)) {
+            for (String line : lines) writer.write(line + "\n");
+        }
+    }
+}
