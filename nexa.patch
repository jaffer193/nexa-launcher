+package net.kdt.pojavlaunch.nexa;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import net.kdt.pojavlaunch.JMinecraftVersionList;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.QuickPackInstaller;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Remembers the server the user wants to join, and adds the right launch arguments to the
+ * next start of the game: Minecraft 1.20 and newer use --quickPlayMultiplayer, older ones --server/--port.
+ */
+public final class FriendJoin {
+    private static volatile @Nullable String sPending = null;
+
+    private FriendJoin() {}
+
+    public static void setPending(@Nullable String address) {
+        sPending = address;
+    }
+
+    /** Called when the game arguments are built. The pending address is used only once. */
+    public static @NonNull String[] withJoinArgs(@NonNull String[] args, @NonNull JMinecraftVersionList.Version versionInfo) {
+        String address = sPending;
+        if (address == null) return args;
+        sPending = null;
+
+        String host = FriendStore.hostOf(address);
+        String port = String.valueOf(FriendStore.portOf(address));
+        String mc = QuickPackInstaller.resolveMcVersion(versionInfo.id);
+        if (mc == null && versionInfo.inheritsFrom != null) mc = QuickPackInstaller.resolveMcVersion(versionInfo.inheritsFrom);
+
+        boolean quickPlay;
+        try {
+            quickPlay = mc != null && ModGuard.compareVersions(mc, "1.20") >= 0;
+        } catch (NumberFormatException e) {
+            quickPlay = mc != null && !mc.startsWith("1."); // year based versions are newer than 1.20
+        }
+
+        List<String> list = new ArrayList<>(Arrays.asList(args));
+        if (quickPlay) {
+            list.add("--quickPlayMultiplayer");
+            list.add(host + ":" + port);
+        } else {
+            list.add("--server");
+            list.add(host);
+            list.add("--port");
+            list.add(port);
+        }
+        return list.toArray(new String[0]);
+    }
+}
diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/FriendStore.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/FriendStore.java
new file mode 100644
index 0000000..22a2f65
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/FriendStore.java
@@ -0,0 +1,115 @@
+package net.kdt.pojavlaunch.nexa;
+
+import android.content.Context;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.google.gson.Gson;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * The saved friends and servers. A friend is a name and the address to join (a server, a tunnel
+ * address, or the address of a world opened to LAN). Stored on the phone only.
+ */
+public final class FriendStore {
+    private static final String PREF_KEY = "nexa_friends";
+    private static final String CODE_PREFIX = "NEXA|";
+    public static final int DEFAULT_PORT = 25565;
+
+    private FriendStore() {}
+
+    public static final class Friend {
+        public String name;
+        public String address;
+
+        public Friend(String name, String address) {
+            this.name = name;
+            this.address = address;
+        }
+    }
+
+    public static @NonNull List<Friend> load(@NonNull Context context) {
+        String json = NexaClient.prefs(context).getString(PREF_KEY, null);
+        List<Friend> friends = new ArrayList<>();
+        if (json == null) return friends;
+        try {
+            Friend[] saved = new Gson().fromJson(json, Friend[].class);
+            if (saved != null) {
+                for (Friend friend : saved) {
+                    if (friend != null && friend.name != null && friend.address != null) friends.add(friend);
+                }
+            }
+        } catch (RuntimeException e) {
+            // A damaged list is dropped instead of crashing the screen
+        }
+        return friends;
+    }
+
+    public static void save(@NonNull Context context, @NonNull List<Friend> friends) {
+        NexaClient.prefs(context).edit().putString(PREF_KEY, new Gson().toJson(friends.toArray(new Friend[0]))).apply();
+    }
+
+    /** The text a friend can paste to add this entry */
+    public static @NonNull String toCode(@NonNull Friend friend) {
+        return CODE_PREFIX + friend.name.replace("|", " ") + "|" + friend.address;
+    }
+
+    /**
+     * Reads an invite code (NEXA|name|address) or a plain address (host or host:port).
+     * @return null when the text is empty
+     */
+    public static @Nullable Friend fromText(@NonNull String text) {
+        String value = text.trim();
+        if (value.isEmpty()) return null;
+        if (value.startsWith(CODE_PREFIX)) {
+            String[] parts = value.substring(CODE_PREFIX.length()).split("\\|", 2);
+            if (parts.length == 2 && !parts[1].trim().isEmpty()) {
+                return new Friend(parts[0].trim(), normalize(parts[1]));
+            }
+            return null;
+        }
+        String address = normalize(value);
+        return address.isEmpty() ? null : new Friend("", address);
+    }
+
+    public static @NonNull String normalize(@NonNull String address) {
+        String value = address.trim();
+        int scheme = value.indexOf("://");
+        if (scheme >= 0) value = value.substring(scheme + 3);
+        while (value.endsWith("/")) value = value.substring(0, value.length() - 1);
+        return value;
+    }
+
+    /** @return {host, port} with the default port when none is written */
+    public static @NonNull String[] splitAddress(@NonNull String address) {
+        String value = normalize(address);
+        int colon = value.lastIndexOf(':');
+        if (colon > 0 && colon < value.length() - 1 && value.indexOf(':') == colon) {
+            String port = value.substring(colon + 1);
+            try {
+                int number = Integer.parseInt(port);
+                if (number > 0 && number < 65536) return new String[]{value.substring(0, colon), String.valueOf(number)};
+            } catch (NumberFormatException ignored) {
+                // Not a port: the whole text is the host
+            }
+        }
+        return new String[]{value, String.valueOf(DEFAULT_PORT)};
+    }
+
+    public static int portOf(@NonNull String address) {
+        return Integer.parseInt(splitAddress(address)[1]);
+    }
+
+    public static String hostOf(@NonNull String address) {
+        return splitAddress(address)[0];
+    }
+
+    /** Used by tests of the parsing only */
+    static List<String> debugSplit(String address) {
+        return Arrays.asList(splitAddress(address));
+    }
+}
