+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Friends and servers: save the address of a friend's world or server, see if it is online, and
+ * join it with one tap. Worlds opened to LAN on the same Wi-Fi can be found automatically.
+ * There is no central server: the launcher only stores addresses and starts the game with them.
+ */
+public class FriendsFragment extends Fragment {
+    public static final String TAG = "FriendsFragment";
+
+    private final List<FriendStore.Friend> mFriends = new ArrayList<>();
+    private final Map<String, String> mStatus = new HashMap<>();
+    private ArrayAdapter<FriendStore.Friend> mAdapter;
+    private TextView mStatusText;
+
+    public FriendsFragment() {
+        super(R.layout.fragment_nexa_list);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        net.kdt.pojavlaunch.nexa.NexaTheme.applyBackground(view);
+        ((TextView) view.findViewById(R.id.nl_title)).setText(R.string.nexa_fr_title);
+        mStatusText = view.findViewById(R.id.nl_status);
+        ListView list = view.findViewById(R.id.nl_list);
+
+        mAdapter = new ArrayAdapter<FriendStore.Friend>(requireContext(), android.R.layout.simple_list_item_2,
+                android.R.id.text1, mFriends) {
+            @NonNull
+            @Override
+            public View getView(int position, @Nullable View convertView, @NonNull ViewGroup parent) {
+                View row = super.getView(position, convertView, parent);
+                FriendStore.Friend friend = getItem(position);
+                if (friend == null) return row;
+                TextView title = row.findViewById(android.R.id.text1);
+                TextView detail = row.findViewById(android.R.id.text2);
+                title.setText(friend.name);
+                title.setTextColor(ContextCompat.getColor(getContext(), R.color.primary_text));
+                String status = mStatus.get(friend.address);
+                detail.setText(friend.address + "\n" + (status == null ? getString(R.string.nexa_fr_checking) : status));
+                detail.setTextColor(ContextCompat.getColor(getContext(), R.color.secondary_text));
+                return row;
+            }
+        };
+        list.setAdapter(mAdapter);
+        list.setOnItemClickListener((parent, v, position, id) -> showActions(mFriends.get(position)));
+
+        TextView add = view.findViewById(R.id.nl_action1);
+        add.setText(R.string.nexa_fr_add);
+        add.setOnClickListener(v -> showEditDialog(null));
+        TextView scan = view.findViewById(R.id.nl_action2);
+        scan.setText(R.string.nexa_fr_scan);
+        scan.setOnClickListener(v -> scanLan());
+
+        refresh();
+    }
+
+    private void refresh() {
+        mFriends.clear();
+        mFriends.addAll(FriendStore.load(requireContext()));
+        mAdapter.notifyDataSetChanged();
+        mStatusText.setText(mFriends.isEmpty() ? R.string.nexa_fr_empty : R.string.nexa_fr_hint);
+        for (FriendStore.Friend friend : mFriends) checkStatus(friend);
+    }
+
+    /** Asks the server for its status in the background and shows the result in the list */
+    private void checkStatus(final FriendStore.Friend friend) {
+        PojavApplication.sExecutorService.execute(() -> {
+            String text;
+            try {
+                ServerPing.Result result = ServerPing.query(FriendStore.hostOf(friend.address),
+                        FriendStore.portOf(friend.address), 3000);
+                if (result.online) {
+                    text = "\u25CF " + getStringSafe(R.string.nexa_fr_online, result.pingMs, result.players, result.maxPlayers)
+                            + (result.motd.isEmpty() ? "" : "  " + result.motd);
+                } else {
+                    text = "\u25CB " + getStringSafe(R.string.nexa_fr_offline);
+                }
+            } catch (RuntimeException e) {
+                text = "\u25CB " + getStringSafe(R.string.nexa_fr_offline);
+            }
+            final String finalText = text;
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                mStatus.put(friend.address, finalText);
+                mAdapter.notifyDataSetChanged();
+            });
+        });
+    }
+
+    private String getStringSafe(int res, Object... args) {
+        Context context = getContext();
+        return context == null ? "" : context.getString(res, args);
+    }
+
+    // ---- Actions -------------------------------------------------------------------------------
+
+    private void showActions(final FriendStore.Friend friend) {
+        String[] actions = {
+                getString(R.string.nexa_fr_join),
+                getString(R.string.nexa_fr_share),
+                getString(R.string.nexa_fr_copy),
+                getString(R.string.nexa_fr_edit),
+                getString(R.string.nexa_fr_delete)
+        };
+        new AlertDialog.Builder(requireContext())
+                .setTitle(friend.name)
+                .setItems(actions, (dialog, which) -> {
+                    switch (which) {
+                        case 0: join(friend.address, friend.name); break;
+                        case 1: share(friend); break;
+                        case 2: copyCode(friend); break;
+                        case 3: showEditDialog(friend); break;
+                        default: delete(friend); break;
+                    }
+                })
+                .show();
+    }
+
+    /** Starts the game with the server address; the account and profile are the selected ones */
+    private void join(String address, String name) {
+        FriendJoin.setPending(address);
+        Toast.makeText(requireContext(), getString(R.string.nexa_fr_joining, name), Toast.LENGTH_LONG).show();
+        ExtraCore.setValue(ExtraConstants.LAUNCH_GAME, true);
+    }
+
+    private void share(FriendStore.Friend friend) {
+        Intent send = new Intent(Intent.ACTION_SEND);
+        send.setType("text/plain");
+        send.putExtra(Intent.EXTRA_TEXT, FriendStore.toCode(friend));
+        startActivity(Intent.createChooser(send, getString(R.string.nexa_fr_share)));
+    }
+
+    private void copyCode(FriendStore.Friend friend) {
+        ClipboardManager clipboard = (ClipboardManager) requireContext().getSystemService(Context.CLIPBOARD_SERVICE);
+        if (clipboard != null) {
+            clipboard.setPrimaryClip(ClipData.newPlainText("Nexa invite", FriendStore.toCode(friend)));
+            Toast.makeText(requireContext(), R.string.nexa_fr_copied, Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    private void delete(final FriendStore.Friend friend) {
+        new AlertDialog.Builder(requireContext())
+                .setTitle(friend.name)
+                .setMessage(R.string.nexa_fr_delete_confirm)
+                .setPositiveButton(R.string.nexa_fr_delete, (dialog, which) -> {
+                    List<FriendStore.Friend> all = FriendStore.load(requireContext());
+                    for (int i = all.size() - 1; i >= 0; i--) {
+                        if (all.get(i).address.equals(friend.address) && all.get(i).name.equals(friend.name)) {
+                            all.remove(i);
+                        }
+                    }
+                    FriendStore.save(requireContext(), all);
+                    refresh();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    /** Add or edit. The address field also accepts an invite code (NEXA|name|address). */
+    private void showEditDialog(@Nullable final FriendStore.Friend existing) {
+        final Context context = requireContext();
+        LinearLayout box = new LinearLayout(context);
+        box.setOrientation(LinearLayout.VERTICAL);
+        int pad = Math.round(20 * context.getResources().getDisplayMetrics().density);
+        box.setPadding(pad, pad / 2, pad, 0);
+        final EditText nameField = new EditText(context);
+        nameField.setHint(R.string.nexa_fr_name_hint);
+        nameField.setSingleLine(true);
+        final EditText addressField = new EditText(context);
+        addressField.setHint(R.string.nexa_fr_address_hint);
+        addressField.setSingleLine(true);
+        if (existing != null) {
+            nameField.setText(existing.name);
+            addressField.setText(existing.address);
+        }
+        box.addView(nameField);
+        box.addView(addressField);
+
+        new AlertDialog.Builder(context)
+                .setTitle(existing == null ? R.string.nexa_fr_add : R.string.nexa_fr_edit)
+                .setMessage(R.string.nexa_fr_add_note)
+                .setView(box)
+                .setPositiveButton(android.R.string.ok, (dialog, which) -> {
+                    FriendStore.Friend parsed = FriendStore.fromText(addressField.getText().toString());
+                    if (parsed == null) {
+                        Toast.makeText(context, R.string.nexa_fr_invalid, Toast.LENGTH_SHORT).show();
+                        return;
+                    }
+                    String name = nameField.getText().toString().trim();
+                    if (name.isEmpty()) name = parsed.name.isEmpty() ? FriendStore.hostOf(parsed.address) : parsed.name;
+                    List<FriendStore.Friend> all = FriendStore.load(context);
+                    if (existing != null) {
+                        for (int i = all.size() - 1; i >= 0; i--) {
+                            if (all.get(i).address.equals(existing.address) && all.get(i).name.equals(existing.name)) {
+                                all.remove(i);
+                            }
+                        }
+                    }
+                    all.add(new FriendStore.Friend(name, parsed.address));
+                    FriendStore.save(context, all);
+                    refresh();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    // ---- Worlds opened to LAN ------------------------------------------------------------------
+
+    private void scanLan() {
+        final Context appContext = requireContext().getApplicationContext();
+        Toast.makeText(appContext, R.string.nexa_fr_scanning, Toast.LENGTH_LONG).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            final List<LanScanner.LanWorld> worlds = LanScanner.scan(appContext, 6000);
+            Tools.runOnUiThread(() -> showLanResults(worlds));
+        });
+    }
+
+    private void showLanResults(List<LanScanner.LanWorld> worlds) {
+        if (!isAdded()) return;
+        if (worlds.isEmpty()) {
+            new AlertDialog.Builder(requireContext())
+                    .setTitle(R.string.nexa_fr_scan)
+                    .setMessage(R.string.nexa_fr_scan_none)
+                    .setPositiveButton(android.R.string.ok, null)
+                    .show();
+            return;
+        }
+        String[] labels = new String[worlds.size()];
+        for (int i = 0; i < labels.length; i++) labels[i] = worlds.get(i).motd + "\n" + worlds.get(i).address;
+        new AlertDialog.Builder(requireContext())
+                .setTitle(R.string.nexa_fr_scan_found)
+                .setItems(labels, (dialog, which) -> {
+                    final LanScanner.LanWorld world = worlds.get(which);
+                    new AlertDialog.Builder(requireContext())
+                            .setTitle(world.motd)
+                            .setItems(new String[]{getString(R.string.nexa_fr_join), getString(R.string.nexa_fr_save)},
+                                    (d, choice) -> {
+                                        if (choice == 0) {
+                                            join(world.address, world.motd);
+                                        } else {
+                                            List<FriendStore.Friend> all = FriendStore.load(requireContext());
+                                            all.add(new FriendStore.Friend(world.motd, world.address));
+                                            FriendStore.save(requireContext(), all);
+                                            refresh();
+                                        }
+                                    })
+                            .show();
+                })
+                .show();
+    }
+}
