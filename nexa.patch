diff --git a/app_pojavlauncher/src/main/res/layout/fragment_custom_profile.xml b/app_pojavlauncher/src/main/res/layout/fragment_custom_profile.xml
new file mode 100644
index 0000000..3d8a5b4
--- /dev/null
+++ b/app_pojavlauncher/src/main/res/layout/fragment_custom_profile.xml
@@ -0,0 +1,182 @@
+<?xml version="1.0" encoding="utf-8"?>
+<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/background_app"
+    android:fillViewport="true">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:padding="@dimen/_25sdp">
+
+        <TextView
+            android:id="@+id/cp_step_label"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:textColor="@color/secondary_text" />
+
+        <TextView
+            android:id="@+id/cp_title"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="@dimen/_4sdp"
+            android:textColor="@color/primary_text"
+            android:textSize="@dimen/_16ssp"
+            android:textStyle="bold" />
+
+        <TextView
+            android:id="@+id/cp_description"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="@dimen/_6sdp"
+            android:layout_marginBottom="@dimen/_12sdp"
+            android:textColor="@color/secondary_text" />
+
+        <TextView
+            android:id="@+id/cp_loader_note"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginBottom="@dimen/_8sdp"
+            android:textColor="@color/primary_text"
+            android:visibility="gone" />
+
+        <!-- Step 1: name and version -->
+        <LinearLayout
+            android:id="@+id/cp_group_version"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical">
+
+            <com.kdt.mcgui.MineEditText
+                android:id="@+id/cp_name"
+                android:layout_width="match_parent"
+                android:layout_height="@dimen/_37sdp"
+                android:hint="@string/cp_name_hint"
+                android:imeOptions="flagNoExtractUi"
+                android:inputType="text"
+                android:textSize="@dimen/_14ssp" />
+
+            <com.kdt.mcgui.MineButton
+                android:id="@+id/cp_version_button"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="@dimen/_10sdp"
+                android:text="@string/cp_pick_version" />
+
+            <TextView
+                android:id="@+id/cp_version_text"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="@dimen/_6sdp"
+                android:gravity="center"
+                android:textColor="@color/primary_text"
+                android:textSize="@dimen/_14ssp" />
+
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="@dimen/_10sdp"
+                android:text="@string/cp_loader_label"
+                android:textColor="@color/secondary_text" />
+
+            <Spinner
+                android:id="@+id/cp_loader_spinner"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content" />
+        </LinearLayout>
+
+        <!-- Step 2: mods -->
+        <LinearLayout
+            android:id="@+id/cp_group_mods"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical"
+            android:visibility="gone">
+
+            <com.kdt.mcgui.MineButton
+                android:id="@+id/cp_mods_add"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:text="@string/cp_mods_add" />
+
+            <com.kdt.mcgui.MineButton
+                android:id="@+id/cp_mods_browse"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="@dimen/_8sdp"
+                android:text="@string/cp_mods_browse" />
+
+            <TextView
+                android:id="@+id/cp_mods_count"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="@dimen/_6sdp"
+                android:gravity="center"
+                android:textColor="@color/secondary_text" />
+
+            <TextView
+                android:id="@+id/cp_mods_list"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="@dimen/_8sdp"
+                android:textColor="@color/primary_text"
+                android:textSize="12sp"
+                android:visibility="gone" />
+        </LinearLayout>
+
+        <!-- Step 3: resource packs -->
+        <LinearLayout
+            android:id="@+id/cp_group_packs"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical"
+            android:visibility="gone">
+
+            <com.kdt.mcgui.MineButton
+                android:id="@+id/cp_packs_add"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:text="@string/cp_packs_add" />
+
+            <TextView
+                android:id="@+id/cp_packs_count"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="@dimen/_6sdp"
+                android:gravity="center"
+                android:textColor="@color/secondary_text" />
+        </LinearLayout>
+
+        <!-- Step 4: world -->
+        <LinearLayout
+            android:id="@+id/cp_group_world"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical"
+            android:visibility="gone">
+
+            <com.kdt.mcgui.MineButton
+                android:id="@+id/cp_world_add"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:text="@string/cp_world_add" />
+
+            <TextView
+                android:id="@+id/cp_world_count"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="@dimen/_6sdp"
+                android:gravity="center"
+                android:textColor="@color/secondary_text" />
+        </LinearLayout>
+
+        <com.kdt.mcgui.MineButton
+            android:id="@+id/cp_next"
+            android:layout_width="match_parent"
+            android:layout_height="@dimen/_42sdp"
+            android:layout_marginTop="@dimen/_18sdp"
+            android:textColor="@android:color/white" />
+    </LinearLayout>
+</ScrollView>
