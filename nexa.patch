+                    mVersionId = id;
+                    mVersionText.setText(id);
+                }));
+        view.findViewById(R.id.cp_mods_add).setOnClickListener(v ->
+                mModPicker.launch(new String[]{"application/java-archive", "application/octet-stream", "*/*"}));
+        view.findViewById(R.id.cp_mods_browse).setOnClickListener(v -> {
+            mBrowsedMods = true; // mods installed from there are not counted, but the step is not "skipped"
+            Tools.swapFragment(requireActivity(), SearchModFragment.class, SearchModFragment.TAG, null);
+        });
+        view.findViewById(R.id.cp_packs_add).setOnClickListener(v ->
+                mPackPicker.launch(new String[]{"application/zip", "application/octet-stream", "*/*"}));
+        view.findViewById(R.id.cp_world_add).setOnClickListener(v ->
+                mWorldPicker.launch(new String[]{"application/zip", "application/octet-stream", "*/*"}));
