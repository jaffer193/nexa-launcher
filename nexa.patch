+import java.util.zip.ZipFile;
+import java.util.zip.ZipOutputStream;
+
+/** Worlds of the selected profile: back them up to a zip, restore a backup, or delete them */
+public class WorldsFragment extends Fragment {
+    public static final String TAG = "WorldsFragment";
+    private static final String BACKUP_FOLDER = "nexa_backups";
+
+    private final List<File> mWorlds = new ArrayList<>();
+    private final List<String> mLabels = new ArrayList<>();
+    private ArrayAdapter<String> mAdapter;
+    private TextView mStatus;
+    private @Nullable File mSavesDir;
+
+    public WorldsFragment() {
+        super(R.layout.fragment_nexa_list);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        net.kdt.pojavlaunch.nexa.NexaTheme.applyBackground(view);
+        ((TextView) view.findViewById(R.id.nl_title)).setText(R.string.nexa_wl_title);
+        mStatus = view.findViewById(R.id.nl_status);
+        view.findViewById(R.id.nl_actions).setVisibility(View.GONE);
+        ListView list = view.findViewById(R.id.nl_list);
+        mAdapter = new ArrayAdapter<>(requireContext(), android.R.layout.simple_list_item_1, mLabels);
+        list.setAdapter(mAdapter);
+        list.setOnItemClickListener((parent, v, position, id) -> showActions(mWorlds.get(position)));
+
+        try {
+            mSavesDir = new File(Tools.getGameDirPath(LauncherProfiles.getCurrentProfile()), "saves");
+        } catch (RuntimeException e) {
+            mSavesDir = null;
+        }
+        refresh();
+    }
+
+    private static File backupDir() {
+        return new File(Tools.DIR_GAME_HOME, BACKUP_FOLDER);
+    }
+
+    private void refresh() {
+        mWorlds.clear();
+        mLabels.clear();
+        File[] folders = mSavesDir == null ? null : mSavesDir.listFiles();
+        if (folders != null) {
+            Arrays.sort(folders, (a, b) -> a.getName().compareToIgnoreCase(b.getName()));
+            DateFormat format = DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT);
+            for (File folder : folders) {
+                if (!folder.isDirectory() || !new File(folder, "level.dat").exists()) continue;
+                mWorlds.add(folder);
+                mLabels.add(folder.getName() + "\n" + format.format(new Date(folder.lastModified())));
+            }
+        }
+        mAdapter.notifyDataSetChanged();
+        mStatus.setText(mWorlds.isEmpty() ? getString(R.string.nexa_wl_empty)
+                : getString(R.string.nexa_wl_hint, backupDir().getAbsolutePath()));
+    }
+
+    private void showActions(final File world) {
+        String[] actions = {
+                getString(R.string.nexa_wl_backup),
+                getString(R.string.nexa_wl_restore),
+                getString(R.string.nexa_wl_delete)
+        };
+        new AlertDialog.Builder(requireContext())
+                .setTitle(world.getName())
+                .setItems(actions, (dialog, which) -> {
+                    if (which == 0) backup(world);
+                    else if (which == 1) chooseBackup(world);
+                    else confirmDelete(world);
+                })
+                .show();
+    }
+
+    // ---- Backup --------------------------------------------------------------------------------
+
+    private void backup(final File world) {
+        final Context appContext = requireContext().getApplicationContext();
+        Toast.makeText(appContext, R.string.nexa_wl_working, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            try {
+                File folder = backupDir();
+                //noinspection ResultOfMethodCallIgnored
+                folder.mkdirs();
+                String stamp = new SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(new Date());
+                File zip = new File(folder, world.getName() + "_" + stamp + ".zip");
+                try (ZipOutputStream out = new ZipOutputStream(new FileOutputStream(zip))) {
+                    addFolder(out, world, world.getName() + "/");
+                }
+                message = appContext.getString(R.string.nexa_wl_backup_done, zip.getName());
+            } catch (IOException | RuntimeException e) {
+                e.printStackTrace();
+                message = appContext.getString(R.string.nexa_wl_failed, String.valueOf(e.getMessage()));
+            }
+            final String finalMessage = message;
+            Tools.runOnUiThread(() -> Toast.makeText(appContext, finalMessage, Toast.LENGTH_LONG).show());
+        });
+    }
+
+    private static void addFolder(ZipOutputStream out, File folder, String prefix) throws IOException {
+        File[] children = folder.listFiles();
+        if (children == null) return;
+        byte[] buffer = new byte[8192];
+        for (File child : children) {
+            if (child.isDirectory()) {
+                addFolder(out, child, prefix + child.getName() + "/");
+                continue;
+            }
+            out.putNextEntry(new ZipEntry(prefix + child.getName()));
+            try (InputStream in = new FileInputStream(child)) {
+                int read;
+                while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+            }
+            out.closeEntry();
+        }
+    }
+
+    // ---- Restore -------------------------------------------------------------------------------
+
+    private void chooseBackup(final File world) {
+        File[] all = backupDir().listFiles();
+        final List<File> backups = new ArrayList<>();
+        if (all != null) {
+            for (File file : all) {
+                String name = file.getName();
+                if (name.startsWith(world.getName() + "_") && name.endsWith(".zip")) backups.add(file);
+            }
+        }
+        if (backups.isEmpty()) {
+            Toast.makeText(requireContext(), R.string.nexa_wl_no_backups, Toast.LENGTH_LONG).show();
+            return;
+        }
+        Collections.sort(backups, (a, b) -> Long.compare(b.lastModified(), a.lastModified())); // newest first
+        String[] names = new String[backups.size()];
+        for (int i = 0; i < names.length; i++) names[i] = backups.get(i).getName();
+        new AlertDialog.Builder(requireContext())
+                .setTitle(R.string.nexa_wl_restore)
+                .setItems(names, (dialog, which) -> restore(world, backups.get(which)))
+                .show();
+    }
+
+    private void restore(final File world, final File zip) {
+        final Context appContext = requireContext().getApplicationContext();
+        final File savesDir = mSavesDir;
+        if (savesDir == null) return;
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            try {
+                String restoredName = extractBackup(zip, savesDir, world.getName());
+                message = appContext.getString(R.string.nexa_wl_restore_done, restoredName);
+            } catch (IOException | RuntimeException e) {
+                e.printStackTrace();
+                message = appContext.getString(R.string.nexa_wl_failed, String.valueOf(e.getMessage()));
+            }
+            final String finalMessage = message;
+            Tools.runOnUiThread(() -> {
+                Toast.makeText(appContext, finalMessage, Toast.LENGTH_LONG).show();
+                if (isAdded()) refresh();
+            });
+        });
+    }
+
+    /** Extracts into a new folder (the existing world is never overwritten) and returns its name */
+    private static String extractBackup(File zip, File savesDir, String worldName) throws IOException {
+        String restored = worldName + "_restored";
+        File destination = new File(savesDir, restored);
+        int i = 2;
+        while (destination.exists()) {
+            restored = worldName + "_restored_" + i++;
+            destination = new File(savesDir, restored);
+        }
+        String canonicalRoot = destination.getCanonicalPath() + File.separator;
+        String prefix = worldName + "/";
+        byte[] buffer = new byte[8192];
+        try (ZipFile zipFile = new ZipFile(zip)) {
+            Enumeration<? extends ZipEntry> entries = zipFile.entries();
+            while (entries.hasMoreElements()) {
+                ZipEntry entry = entries.nextElement();
+                String path = entry.getName().replace('\\', '/');
+                if (!path.startsWith(prefix) || path.length() == prefix.length()) continue;
+                File target = new File(destination, path.substring(prefix.length()));
+                // Zip-slip protection
+                if (!target.getCanonicalPath().startsWith(canonicalRoot)) continue;
+                if (entry.isDirectory()) {
+                    //noinspection ResultOfMethodCallIgnored
+                    target.mkdirs();
+                    continue;
+                }
+                //noinspection ResultOfMethodCallIgnored
+                target.getParentFile().mkdirs();
+                try (InputStream in = zipFile.getInputStream(entry); OutputStream out = new FileOutputStream(target)) {
+                    int read;
+                    while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+                }
+            }
+        }
+        return restored;
+    }
+
+    // ---- Delete --------------------------------------------------------------------------------
+
+    private void confirmDelete(final File world) {
+        new AlertDialog.Builder(requireContext())
+                .setTitle(world.getName())
+                .setMessage(R.string.nexa_wl_delete_confirm)
+                .setPositiveButton(R.string.nexa_wl_delete, (dialog, which) -> {
+                    final Context appContext = requireContext().getApplicationContext();
+                    PojavApplication.sExecutorService.execute(() -> {
+                        deleteRecursive(world);
+                        Tools.runOnUiThread(() -> {
+                            Toast.makeText(appContext, R.string.nexa_wl_deleted, Toast.LENGTH_SHORT).show();
+                            if (isAdded()) refresh();
+                        });
+                    });
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void deleteRecursive(File file) {
+        File[] children = file.listFiles();
+        if (children != null) for (File child : children) deleteRecursive(child);
+        //noinspection ResultOfMethodCallIgnored
+        file.delete();
+    }
+}
