@@ -0,0 +1,281 @@
+package net.kdt.pojavlaunch.fragments;
+
+import android.app.AlertDialog;
+import android.os.Bundle;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ArrayAdapter;
+import android.widget.ListView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.core.content.ContextCompat;
+import androidx.fragment.app.Fragment;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.nexa.ModGuard;
+import net.kdt.pojavlaunch.nexa.ModUpdater;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Lists the mods of the selected profile. Each one can be turned off (renamed to .disabled) or
+ * deleted, and shows whether it fits the profile. Turning everything off helps to find which mod
+ * makes the game crash.
+ */
+public class ModManagerFragment extends Fragment {
+    public static final String TAG = "ModManagerFragment";
+    private static final String DISABLED_SUFFIX = ".disabled";
+
+    private static final class Entry {
+        final File file;
+        final boolean enabled;
+        final ModGuard.Evaluation evaluation;
+
+        Entry(File file, boolean enabled, ModGuard.Evaluation evaluation) {
+            this.file = file;
+            this.enabled = enabled;
+            this.evaluation = evaluation;
+        }
+
+        String baseName() {
+            String name = file.getName();
+            return enabled ? name : name.substring(0, name.length() - DISABLED_SUFFIX.length());
+        }
+
+        @NonNull
+        @Override
+        public String toString() {
+            return baseName();
+        }
+    }
+
+    private final List<Entry> mEntries = new ArrayList<>();
+    private ArrayAdapter<Entry> mAdapter;
+    private TextView mStatus;
+    private @Nullable File mModsDir;
+
+    public ModManagerFragment() {
+        super(R.layout.fragment_nexa_list);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        net.kdt.pojavlaunch.nexa.NexaTheme.applyBackground(view);
+        ((TextView) view.findViewById(R.id.nl_title)).setText(R.string.nexa_mm_title);
+        mStatus = view.findViewById(R.id.nl_status);
+        ListView list = view.findViewById(R.id.nl_list);
+
+        mAdapter = new ArrayAdapter<Entry>(requireContext(), android.R.layout.simple_list_item_2,
+                android.R.id.text1, mEntries) {
+            @NonNull
+            @Override
+            public View getView(int position, @Nullable View convertView, @NonNull ViewGroup parent) {
+                View row = super.getView(position, convertView, parent);
+                Entry entry = getItem(position);
+                if (entry == null) return row;
+                TextView title = row.findViewById(android.R.id.text1);
+                TextView detail = row.findViewById(android.R.id.text2);
+                title.setText(entry.evaluation.mark + " " + entry.baseName()
+                        + (entry.enabled ? "" : "   (" + getString(R.string.nexa_mm_off) + ")"));
+                title.setTextColor(ContextCompat.getColor(getContext(), R.color.primary_text));
+                detail.setText(entry.evaluation.detail);
+                detail.setTextColor(ContextCompat.getColor(getContext(), R.color.secondary_text));
+                row.setAlpha(entry.enabled ? 1f : 0.55f);
+                return row;
+            }
+        };
+        list.setAdapter(mAdapter);
+        list.setOnItemClickListener((parent, v, position, id) -> showActions(mEntries.get(position)));
+
+        TextView disableAll = view.findViewById(R.id.nl_action1);
+        disableAll.setText(R.string.nexa_mm_disable_all);
+        disableAll.setOnClickListener(v -> confirmSetAll(false));
+        TextView enableAll = view.findViewById(R.id.nl_action2);
+        enableAll.setText(R.string.nexa_mm_enable_all);
+        enableAll.setOnClickListener(v -> confirmSetAll(true));
+
+        TextView updates = view.findViewById(R.id.nl_action3);
+        updates.setVisibility(View.VISIBLE);
+        updates.setText(R.string.nexa_mm_check_updates);
+        updates.setOnClickListener(v -> checkUpdates());
+
+        try {
+            mModsDir = new File(Tools.getGameDirPath(LauncherProfiles.getCurrentProfile()), "mods");
+        } catch (RuntimeException e) {
+            mModsDir = null;
+        }
+        refresh();
+    }
+
+    private void refresh() {
+        final File modsDir = mModsDir;
+        if (modsDir == null) {
+            mStatus.setText(R.string.nexa_mm_no_profile);
+            return;
+        }
+        PojavApplication.sExecutorService.execute(() -> {
+            ModGuard.Target target;
+            try {
+                target = ModGuard.targetFor(LauncherProfiles.getCurrentProfile());
+            } catch (RuntimeException e) {
+                target = new ModGuard.Target(null, null);
+            }
+            List<Entry> found = new ArrayList<>();
+            File[] files = modsDir.listFiles();
+            if (files != null) {
+                for (File file : files) {
+                    String name = file.getName().toLowerCase(Locale.ROOT);
+                    boolean enabled = name.endsWith(".jar");
+                    boolean disabled = name.endsWith(".jar" + DISABLED_SUFFIX);
+                    if (!file.isFile() || (!enabled && !disabled)) continue;
+                    found.add(new Entry(file, enabled, ModGuard.evaluate(file, target)));
+                }
+            }
+            Collections.sort(found, (a, b) -> a.baseName().compareToIgnoreCase(b.baseName()));
+            Tools.runOnUiThread(() -> showEntries(found));
+        });
+    }
+
+    private void showEntries(List<Entry> found) {
+        if (!isAdded()) return;
+        mEntries.clear();
+        mEntries.addAll(found);
+        mAdapter.notifyDataSetChanged();
+        int off = 0;
+        for (Entry entry : found) if (!entry.enabled) off++;
+        if (found.isEmpty()) mStatus.setText(R.string.nexa_mm_empty);
+        else mStatus.setText(getString(R.string.nexa_mm_summary, found.size(), off)
+                + "\n" + getString(R.string.nexa_mm_tip));
+    }
+
+    /** Asks Modrinth if newer versions of the mods exist (same Minecraft version and loader) */
+    private void checkUpdates() {
+        final File modsDir = mModsDir;
+        if (modsDir == null) return;
+        final ModGuard.Target target;
+        try {
+            target = ModGuard.targetFor(LauncherProfiles.getCurrentProfile());
+        } catch (RuntimeException e) {
+            Toast.makeText(requireContext(), R.string.nexa_mm_no_profile, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        if (target.loader == null || target.mcVersion == null) {
+            Toast.makeText(requireContext(), R.string.nexa_client_need_modded, Toast.LENGTH_LONG).show();
+            return;
+        }
+        Toast.makeText(requireContext(), R.string.nexa_mm_checking, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            try {
+                List<ModUpdater.Update> updates = ModUpdater.check(modsDir, target.loader, target.mcVersion);
+                Tools.runOnUiThread(() -> showUpdates(modsDir, updates));
+            } catch (java.io.IOException | RuntimeException e) {
+                e.printStackTrace();
+                Tools.runOnUiThread(() -> {
+                    if (isAdded()) Toast.makeText(requireContext(), R.string.nexa_mm_check_failed, Toast.LENGTH_LONG).show();
+                });
+            }
+        });
+    }
+
+    private void showUpdates(final File modsDir, final List<ModUpdater.Update> updates) {
+        if (!isAdded()) return;
+        if (updates.isEmpty()) {
+            Toast.makeText(requireContext(), R.string.nexa_mm_up_to_date, Toast.LENGTH_LONG).show();
+            return;
+        }
+        StringBuilder text = new StringBuilder();
+        for (ModUpdater.Update update : updates) {
+            text.append(update.file.getName()).append("  \u2192  ").append(update.newFile.fileName).append("\n");
+        }
+        new AlertDialog.Builder(requireContext())
+                .setTitle(getString(R.string.nexa_mm_updates_found, updates.size()))
+                .setMessage(text.toString())
+                .setPositiveButton(R.string.nexa_mm_update_all, (dialog, which) -> applyUpdates(modsDir, updates))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void applyUpdates(final File modsDir, final List<ModUpdater.Update> updates) {
+        final android.content.Context appContext = requireContext().getApplicationContext();
+        Toast.makeText(appContext, R.string.nexa_mm_updating, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            int done = 0;
+            for (ModUpdater.Update update : updates) {
+                try {
+                    ModUpdater.apply(update, modsDir);
+                    done++;
+                } catch (java.io.IOException | RuntimeException e) {
+                    e.printStackTrace(); // the old file is kept
+                }
+            }
+            final int updated = done;
+            Tools.runOnUiThread(() -> {
+                Toast.makeText(appContext, appContext.getString(R.string.nexa_mm_updated,
+                        updated, updates.size()), Toast.LENGTH_LONG).show();
+                if (isAdded()) refresh();
+            });
+        });
+    }
+
+    private void showActions(final Entry entry) {
+        String[] actions = {
+                getString(entry.enabled ? R.string.nexa_mm_turn_off : R.string.nexa_mm_turn_on),
+                getString(R.string.nexa_mm_delete)
+        };
+        new AlertDialog.Builder(requireContext())
+                .setTitle(entry.baseName())
+                .setItems(actions, (dialog, which) -> {
+                    if (which == 0) {
+                        if (!setEnabled(entry, !entry.enabled)) {
+                            Toast.makeText(requireContext(), R.string.nexa_mm_rename_failed, Toast.LENGTH_SHORT).show();
+                        }
+                        refresh();
+                    } else {
+                        confirmDelete(entry);
+                    }
+                })
+                .show();
+    }
+
+    private static boolean setEnabled(Entry entry, boolean enable) {
+        if (entry.enabled == enable) return true;
+        File parent = entry.file.getParentFile();
+        File target = new File(parent, enable ? entry.baseName() : entry.file.getName() + DISABLED_SUFFIX);
+        return entry.file.renameTo(target);
+    }
+
+    private void confirmDelete(final Entry entry) {
+        new AlertDialog.Builder(requireContext())
+                .setTitle(entry.baseName())
+                .setMessage(getString(R.string.nexa_mm_delete_confirm, entry.baseName()))
+                .setPositiveButton(R.string.nexa_mm_delete, (dialog, which) -> {
+                    //noinspection ResultOfMethodCallIgnored
+                    entry.file.delete();
+                    refresh();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void confirmSetAll(final boolean enable) {
+        if (mEntries.isEmpty()) return;
+        new AlertDialog.Builder(requireContext())
+                .setMessage(enable ? R.string.nexa_mm_enable_all_confirm : R.string.nexa_mm_disable_all_confirm)
+                .setPositiveButton(android.R.string.ok, (dialog, which) -> {
+                    for (Entry entry : new ArrayList<>(mEntries)) setEnabled(entry, enable);
+                    refresh();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+}
