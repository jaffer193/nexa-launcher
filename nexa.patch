+package net.kdt.pojavlaunch.fragments;
+
+import android.os.Bundle;
+import android.view.View;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.authenticator.elyby.ElyByAuth;
+import net.kdt.pojavlaunch.extra.ExtraConstants;
+import net.kdt.pojavlaunch.extra.ExtraCore;
+import net.kdt.pojavlaunch.value.MinecraftAccount;
+
+import java.io.File;
+import java.io.IOException;
+
+/** Login screen for Ely.by accounts. The password is only sent to Ely.by, never stored. */
+public class ElyByLoginFragment extends Fragment {
+    public static final String TAG = "ELYBY_LOGIN_FRAGMENT";
+
+    private EditText mUserEditText;
+    private EditText mPasswordEditText;
+    private EditText mCodeEditText;
+    private TextView mStatusText;
+    private Button mLoginButton;
+
+    public ElyByLoginFragment() {
+        super(R.layout.fragment_elyby_login);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        mUserEditText = view.findViewById(R.id.elyby_username);
+        mPasswordEditText = view.findViewById(R.id.elyby_password);
+        mCodeEditText = view.findViewById(R.id.elyby_code);
+        mStatusText = view.findViewById(R.id.elyby_status);
+        mLoginButton = view.findViewById(R.id.elyby_login_button);
+        mLoginButton.setOnClickListener(v -> startLogin());
+    }
+
+    private void startLogin() {
+        final String user = mUserEditText.getText().toString().trim();
+        final String password = mPasswordEditText.getText().toString();
+        final String code = mCodeEditText.getText().toString().trim();
+        if (user.isEmpty() || password.isEmpty()) {
+            mStatusText.setText(R.string.elyby_fill_fields);
+            return;
+        }
+
+        mLoginButton.setEnabled(false);
+        mStatusText.setText(R.string.elyby_logging_in);
+
+        PojavApplication.sExecutorService.execute(() -> {
+            MinecraftAccount account = null;
+            int errorText = 0;
+            String errorDetail = null;
+            try {
+                account = ElyByAuth.login(user, password, code);
+                MinecraftAccount existing = MinecraftAccount.load(account.username);
+                if (existing != null && !existing.isElyBy) {
+                    // Never overwrite a local/Microsoft account that has the same name
+                    account = null;
+                    errorText = R.string.elyby_name_taken;
+                } else {
+                    account.updateElyByFace();
+                    account.save();
+                }
+            } catch (ElyByAuth.ElyByException e) {
+                errorText = e.twoFactorRequired ? R.string.elyby_2fa_required : R.string.elyby_login_failed;
+                errorDetail = e.getMessage();
+            } catch (IOException e) {
+                errorText = R.string.elyby_network_error;
+                errorDetail = e.getMessage();
+            } catch (RuntimeException e) {
+                // Malformed answer from the server
+                errorText = R.string.elyby_login_failed;
+                errorDetail = e.getMessage();
+            }
+
+            final MinecraftAccount finalAccount = account;
+            final int finalErrorText = errorText;
+            final String finalErrorDetail = errorDetail;
+            Tools.runOnUiThread(() -> {
+                if (finalAccount != null) {
+                    ExtraCore.setValue(ExtraConstants.ELYBY_LOGIN_DONE, finalAccount);
+                    if (isAdded()) {
+                        Tools.swapFragment(requireActivity(), MainMenuFragment.class, MainMenuFragment.TAG, null);
+                    }
+                    return;
+                }
+                if (!isAdded()) return;
+                mLoginButton.setEnabled(true);
+                String text = getString(finalErrorText);
+                if (finalErrorDetail != null && finalErrorText != R.string.elyby_2fa_required) {
+                    text += "\n" + finalErrorDetail;
+                }
+                mStatusText.setText(text);
+            });
+        });
+    }
+}
