+import android.widget.FrameLayout;
+import android.widget.GridLayout;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.ModrinthHelper;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.QuickPackInstaller;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * The Lunar-style menu: a floating circle that opens a grid of features, each one with an
+ * OPTIONS and an ENABLED/DISABLED button. Built in code, on top of the game layout.
+ */
+final class NexaClientUi {
+    private static final String REPLAY_PAGE = "https://www.replaymod.com/download/";
+    private static final float[] SCALES = {0.75f, 1f, 1.25f, 1.5f};
+    private static final int COLOR_ON = Color.parseColor("#2E9E57");
+    private static final int COLOR_OFF = Color.parseColor("#B3314F");
+    private static final int COLOR_BUTTON = Color.parseColor("#3A3F5C");
+    private static final AtomicBoolean sInstalling = new AtomicBoolean(false);
+
+    /** One tile of the grid */
+    private static final class Feature {
