@@ -0,0 +1,151 @@
+package net.kdt.pojavlaunch.nexa;
+
+import androidx.annotation.NonNull;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.Tools;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+/**
+ * Automatic backups of the worlds, made when the game starts. Only the worlds that changed since
+ * their last backup are saved, only the newest few backups of each world are kept, and very big
+ * worlds are skipped so the storage does not fill up.
+ */
+public final class WorldBackup {
+    public static final String PREF_AUTO = "nexa_auto_backup";
+    private static final int KEEP = 3;
+    private static final long MAX_WORLD_BYTES = 1500L * 1024 * 1024;
+
+    private WorldBackup() {}
+
+    public static File backupDir() {
+        return new File(Tools.DIR_GAME_HOME, "nexa_backups");
+    }
+
+    /** Starts the backup in the background so that the game is not delayed */
+    public static void autoBackupAsync(@NonNull final File savesDir) {
+        PojavApplication.sExecutorService.execute(() -> {
+            try {
+                autoBackup(savesDir);
+            } catch (RuntimeException e) {
+                e.printStackTrace(); // a failed backup must never stop the game
+            }
+        });
+    }
+
+    private static void autoBackup(File savesDir) {
+        File[] worlds = savesDir.listFiles();
+        if (worlds == null) return;
+        for (File world : worlds) {
+            if (!world.isDirectory() || !new File(world, "level.dat").exists()) continue;
+            File newest = newestAutoBackup(world.getName());
+            if (newest != null && newest.lastModified() >= lastChange(world)) continue; // nothing new
+            if (folderSize(world, MAX_WORLD_BYTES) > MAX_WORLD_BYTES) continue;
+            try {
+                backup(world, "auto");
+                prune(world.getName());
+            } catch (IOException e) {
+                e.printStackTrace();
+            }
+        }
+    }
+
+    /** Writes the world into a zip named world_auto_date.zip (or world_date.zip) and returns it */
+    public static File backup(File world, String tag) throws IOException {
+        File folder = backupDir();
+        //noinspection ResultOfMethodCallIgnored
+        folder.mkdirs();
+        String stamp = new SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(new Date());
+        File zip = new File(folder, world.getName() + (tag == null ? "_" : "_" + tag + "_") + stamp + ".zip");
+        File partial = new File(folder, zip.getName() + ".part");
+        try (ZipOutputStream out = new ZipOutputStream(new FileOutputStream(partial))) {
+            addFolder(out, world, world.getName() + "/");
+        }
+        if (!partial.renameTo(zip)) {
+            //noinspection ResultOfMethodCallIgnored
+            partial.delete();
+            throw new IOException("Could not save " + zip.getName());
+        }
+        return zip;
+    }
+
+    private static void addFolder(ZipOutputStream out, File folder, String prefix) throws IOException {
+        File[] children = folder.listFiles();
+        if (children == null) return;
+        byte[] buffer = new byte[8192];
+        for (File child : children) {
+            if (child.isDirectory()) {
+                addFolder(out, child, prefix + child.getName() + "/");
+                continue;
+            }
+            if (child.getName().equals("session.lock")) continue; // locked while the game runs
+            out.putNextEntry(new ZipEntry(prefix + child.getName()));
+            try (InputStream in = new FileInputStream(child)) {
+                int read;
+                while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+            }
+            out.closeEntry();
+        }
+    }
+
+    private static List<File> autoBackups(String worldName) {
+        List<File> result = new ArrayList<>();
+        File[] files = backupDir().listFiles();
+        if (files == null) return result;
+        String prefix = worldName + "_auto_";
+        for (File file : files) {
+            if (file.getName().startsWith(prefix) && file.getName().endsWith(".zip")) result.add(file);
+        }
+        Collections.sort(result, (a, b) -> Long.compare(b.lastModified(), a.lastModified())); // newest first
+        return result;
+    }
+
+    private static File newestAutoBackup(String worldName) {
+        List<File> backups = autoBackups(worldName);
+        return backups.isEmpty() ? null : backups.get(0);
+    }
+
+    private static void prune(String worldName) {
+        List<File> backups = autoBackups(worldName);
+        for (int i = KEEP; i < backups.size(); i++) {
+            //noinspection ResultOfMethodCallIgnored
+            backups.get(i).delete();
+        }
+    }
+
+    /** The time of the newest change inside the world */
+    private static long lastChange(File folder) {
+        long newest = folder.lastModified();
+        File[] children = folder.listFiles();
+        if (children == null) return newest;
+        for (File child : children) {
+            newest = Math.max(newest, child.isDirectory() ? lastChange(child) : child.lastModified());
+        }
+        return newest;
+    }
+
+    /** Adds up the size of a folder, and stops as soon as it is bigger than the limit */
+    private static long folderSize(File folder, long limit) {
+        long total = 0;
+        File[] children = folder.listFiles();
+        if (children == null) return 0;
+        for (File child : children) {
+            total += child.isDirectory() ? folderSize(child, limit - total) : child.length();
+            if (total > limit) return total;
+        }
+        return total;
+    }
+}
