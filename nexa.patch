+package net.kdt.pojavlaunch.nexa;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Color;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.StateListDrawable;
+import android.net.Uri;
+import android.widget.ImageView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.core.content.ContextCompat;
+import androidx.preference.PreferenceManager;
+
+import net.kdt.pojavlaunch.R;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+
+/**
+ * User-controlled look of the launcher: accent colors of the buttons, the menu title and the logo.
+ * Everything is optional: when nothing was changed the original resources are used.
+ */
+public final class NexaTheme {
+    public static final String PREF_ACCENT_START = "nexa_accent_start";
+    public static final String PREF_ACCENT_END = "nexa_accent_end";
+    public static final String PREF_TITLE = "nexa_title";
+
+    public static final String PREF_UI_MODE = "nexa_ui_mode";
+    public static final String PREF_BACKGROUND = "nexa_background";
+    public static final int DEFAULT_BACKGROUND = 0xFF0B0E1A;
+    public static final String[] BG_PRESET_NAMES = {
+            "Midnight (default)", "AMOLED black", "Deep purple", "Forest", "Wine", "Slate"
+    };
+    public static final int[] BG_PRESETS = {
+            0xFF0B0E1A, 0xFF000000, 0xFF140B24, 0xFF08150F, 0xFF1A0A10, 0xFF14181F
+    };
+
+    public static final int DEFAULT_START = 0xFF7C5CFF;
+    public static final int DEFAULT_END = 0xFF3D8BFF;
+
+    public static final String[] PRESET_NAMES = {
+            "Nexa (violet / blue)", "Emerald", "Crimson", "Sunset", "Ocean", "Pink"
+    };
+    public static final int[][] PRESETS = {
+            {0xFF7C5CFF, 0xFF3D8BFF},
+            {0xFF1FA85A, 0xFF2ECC9A},
+            {0xFFD6304F, 0xFFFF6B4A},
+            {0xFFFF8A00, 0xFFFFC400},
+            {0xFF0083B0, 0xFF00B4DB},
+            {0xFFE040A0, 0xFF9C4DFF}
+    };
+
+    private static final String LOGO_FILE = "nexa_logo.png";
+    private static final int LOGO_MAX_SIZE = 512;
+
+    private NexaTheme() {}
+
+    private static SharedPreferences prefs(Context context) {
+        return PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+    }
+
+    /** True for the wide (horizontal) launcher layout, false for the vertical one */
+    public static boolean isWide(Context context) {
+        return "wide".equals(prefs(context).getString(PREF_UI_MODE, "portrait"));
+    }
+
+    public static void setWide(Context context, boolean wide) {
+        prefs(context).edit().putString(PREF_UI_MODE, wide ? "wide" : "portrait").apply();
+    }
+
+    /** The vertical mode keeps the launcher upright, the wide mode keeps it sideways */
+    public static void applyOrientation(android.app.Activity activity) {
+        activity.setRequestedOrientation(isWide(activity)
+                ? android.content.pm.ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE
+                : android.content.pm.ActivityInfo.SCREEN_ORIENTATION_SENSOR_PORTRAIT);
+    }
+
+    public static boolean hasCustomBackground(Context context) {
+        return prefs(context).contains(PREF_BACKGROUND);
+    }
+
+    public static int backgroundColor(Context context) {
+        return prefs(context).getInt(PREF_BACKGROUND, DEFAULT_BACKGROUND);
+    }
+
+    public static void setBackground(Context context, int color) {
+        prefs(context).edit().putInt(PREF_BACKGROUND, color).apply();
+    }
+
+    public static void resetBackground(Context context) {
+        prefs(context).edit().remove(PREF_BACKGROUND).apply();
+    }
+
+    /** Paints the screen with the background the user chose (nothing changes if none was chosen) */
+    public static void applyBackground(android.view.View root) {
+        if (root != null && hasCustomBackground(root.getContext())) {
+            root.setBackgroundColor(backgroundColor(root.getContext()));
+        }
+    }
+
+    public static int accentStart(Context context) {
+        return prefs(context).getInt(PREF_ACCENT_START, DEFAULT_START);
+    }
+
+    public static int accentEnd(Context context) {
+        return prefs(context).getInt(PREF_ACCENT_END, DEFAULT_END);
+    }
+
+    public static boolean hasCustomAccent(Context context) {
+        SharedPreferences p = prefs(context);
+        return p.contains(PREF_ACCENT_START) || p.contains(PREF_ACCENT_END);
+    }
+
+    public static void setAccent(Context context, int start, int end) {
+        prefs(context).edit().putInt(PREF_ACCENT_START, start).putInt(PREF_ACCENT_END, end).apply();
+    }
+
+    public static void resetAccent(Context context) {
+        prefs(context).edit().remove(PREF_ACCENT_START).remove(PREF_ACCENT_END).apply();
+    }
+
+    /** Parses #RGB, #RRGGBB or #AARRGGBB. Returns null when the text is not a color. */
+    public static @Nullable Integer parseColor(@NonNull String text) {
+        String value = text.trim();
+        if (!value.startsWith("#")) value = "#" + value;
+        try {
+            return Color.parseColor(value) | 0xFF000000;
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
+
+    public static String colorToHex(int color) {
+        return String.format("#%06X", color & 0xFFFFFF);
+    }
+
+    public static int darken(int color, float factor) {
+        return Color.argb(Color.alpha(color),
+                Math.round(Color.red(color) * factor),
+                Math.round(Color.green(color) * factor),
+                Math.round(Color.blue(color) * factor));
+    }
+
+    /**
+     * @return the button background built from the chosen colors, or null when the user did not
+     * change anything (the caller then keeps the default drawable)
+     */
+    public static @Nullable Drawable buttonBackground(Context context) {
+        if (!hasCustomAccent(context)) return null;
+        float radius = 12 * context.getResources().getDisplayMetrics().density;
+        int start = accentStart(context);
+        int end = accentEnd(context);
+
+        StateListDrawable list = new StateListDrawable();
+        GradientDrawable disabled = new GradientDrawable();
+        disabled.setCornerRadius(radius);
+        disabled.setColor(ContextCompat.getColor(context, R.color.background_disabled));
+        list.addState(new int[]{-android.R.attr.state_enabled}, disabled);
+
+        list.addState(new int[]{android.R.attr.state_pressed}, gradient(darken(start, 0.75f), darken(end, 0.75f), radius));
+        list.addState(new int[]{}, gradient(start, end, radius));
+        return list;
+    }
+
+    public static GradientDrawable gradient(int start, int end, float radius) {
+        GradientDrawable drawable = new GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,
+                new int[]{start, end});
+        drawable.setCornerRadius(radius);
+        return drawable;
+    }
+
+    public static @NonNull String title(Context context) {
+        String saved = prefs(context).getString(PREF_TITLE, "");
+        if (saved == null || saved.trim().isEmpty()) return context.getString(R.string.nexa_menu_title);
+        return saved.trim();
+    }
+
+    // ---- Logo --------------------------------------------------------------------------------
+
+    public static File logoFile(Context context) {
+        return new File(context.getApplicationContext().getFilesDir(), LOGO_FILE);
+    }
+
+    public static @Nullable Bitmap loadLogo(Context context) {
+        File file = logoFile(context);
+        if (!file.exists()) return null;
+        return BitmapFactory.decodeFile(file.getAbsolutePath());
+    }
+
+    /** Shows the custom logo when there is one, the app icon otherwise */
+    public static void applyLogo(Context context, ImageView view) {
+        Bitmap logo = loadLogo(context);
+        if (logo != null) view.setImageBitmap(logo);
+        else view.setImageResource(R.mipmap.ic_launcher);
+    }
+
+    public static boolean saveLogo(Context context, Uri uri) {
+        try (InputStream in = context.getContentResolver().openInputStream(uri)) {
+            if (in == null) return false;
+            Bitmap source = BitmapFactory.decodeStream(in);
+            if (source == null) return false;
+            int largest = Math.max(source.getWidth(), source.getHeight());
+            if (largest > LOGO_MAX_SIZE) {
+                float scale = LOGO_MAX_SIZE / (float) largest;
+                source = Bitmap.createScaledBitmap(source,
+                        Math.max(1, Math.round(source.getWidth() * scale)),
+                        Math.max(1, Math.round(source.getHeight() * scale)), true);
+            }
+            try (OutputStream out = new FileOutputStream(logoFile(context))) {
+                source.compress(Bitmap.CompressFormat.PNG, 100, out);
+            }
+            return true;
+        } catch (IOException | RuntimeException e) {
+            return false;
+        }
+    }
+
+    public static void resetLogo(Context context) {
+        //noinspection ResultOfMethodCallIgnored
+        logoFile(context).delete();
+    }
+}
