+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/SkinEditor.java
@@ -0,0 +1,295 @@
+package net.kdt.pojavlaunch.nexa;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.app.Dialog;
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.text.InputType;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.EditText;
+import android.widget.HorizontalScrollView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+
+import net.kdt.pojavlaunch.R;
+
+import java.util.ArrayDeque;
+
+/**
+ * A simple pixel editor for a 64x64 skin: paint, erase, pick a color from the skin, move around,
+ * zoom, undo. The skin is the flat texture (the same picture the game uses).
+ */
+public final class SkinEditor {
+    public interface Callback {
+        void onDone(Bitmap edited);
+    }
+
+    private static final int TEXELS = 64;
+    private static final int TOOL_PAINT = 0;
+    private static final int TOOL_ERASE = 1;
+    private static final int TOOL_PICK = 2;
+    private static final int TOOL_MOVE = 3;
+    private static final int[] PALETTE = {
+            0xFF000000, 0xFFFFFFFF, 0xFF808080, 0xFF404040, 0xFFE53935, 0xFFFB8C00, 0xFFFDD835, 0xFF7CB342,
+            0xFF2E7D32, 0xFF00ACC1, 0xFF1E88E5, 0xFF3949AB, 0xFF8E24AA, 0xFFEC407A, 0xFF6D4C41, 0xFFF1C27D,
+            0xFFE0AC69, 0xFF8D5524, 0xFFC68642, 0xFFFFDBAC
+    };
+
+    private SkinEditor() {}
+
+    /** Draws the texture, handles the touches and keeps an undo history */
+    private static final class EditorView extends View {
+        private final Bitmap mBitmap;
+        private final Paint mPaint = new Paint();
+        private final Paint mGrid = new Paint();
+        private final Rect mDest = new Rect();
+        private final ArrayDeque<int[]> mUndo = new ArrayDeque<>();
+        private int mCell;
+        private int mTool = TOOL_PAINT;
+        private int mColor = Color.BLACK;
+        private final Runnable mOnColorPicked;
+
+        EditorView(Context context, Bitmap bitmap, Runnable onColorPicked) {
+            super(context);
+            mBitmap = bitmap;
+            mOnColorPicked = onColorPicked;
+            mPaint.setFilterBitmap(false);
+            mGrid.setColor(Color.argb(70, 255, 255, 255));
+            mGrid.setStrokeWidth(1f);
+            mCell = Math.round(6 * context.getResources().getDisplayMetrics().density);
+        }
+
+        void setTool(int tool) { mTool = tool; }
+        void setColor(int color) { mColor = color; mTool = TOOL_PAINT; }
+        int getColor() { return mColor; }
+
+        void zoom(int deltaDp) {
+            float density = getResources().getDisplayMetrics().density;
+            int min = Math.round(3 * density);
+            int max = Math.round(24 * density);
+            mCell = Math.max(min, Math.min(max, mCell + Math.round(deltaDp * density)));
+            requestLayout();
+            invalidate();
+        }
+
+        void undo() {
+            int[] pixels = mUndo.pollLast();
+            if (pixels == null) return;
+            mBitmap.setPixels(pixels, 0, TEXELS, 0, 0, TEXELS, TEXELS);
+            invalidate();
+        }
+
+        private void pushUndo() {
+            int[] pixels = new int[TEXELS * TEXELS];
+            mBitmap.getPixels(pixels, 0, TEXELS, 0, 0, TEXELS, TEXELS);
+            mUndo.addLast(pixels);
+            if (mUndo.size() > 30) mUndo.pollFirst();
+        }
+
+        @Override
+        protected void onMeasure(int widthSpec, int heightSpec) {
+            setMeasuredDimension(TEXELS * mCell, TEXELS * mCell);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            // A checkerboard shows which texels are transparent
+            for (int y = 0; y < TEXELS; y++) {
+                for (int x = 0; x < TEXELS; x++) {
+                    mPaint.setColor(((x + y) & 1) == 0 ? 0xFF2A2F4A : 0xFF3A3F5C);
+                    canvas.drawRect(x * mCell, y * mCell, (x + 1) * mCell, (y + 1) * mCell, mPaint);
+                }
+            }
+            mPaint.setColor(Color.WHITE);
+            mDest.set(0, 0, TEXELS * mCell, TEXELS * mCell);
+            canvas.drawBitmap(mBitmap, null, mDest, mPaint);
+            if (mCell >= 10 * getResources().getDisplayMetrics().density / 2) {
+                for (int i = 0; i <= TEXELS; i++) {
+                    canvas.drawLine(i * mCell, 0, i * mCell, TEXELS * mCell, mGrid);
+                    canvas.drawLine(0, i * mCell, TEXELS * mCell, i * mCell, mGrid);
+                }
+            }
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent event) {
+            if (mTool == TOOL_MOVE) return false; // the scroll views move the picture
+            int x = (int) (event.getX() / mCell);
+            int y = (int) (event.getY() / mCell);
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    getParent().requestDisallowInterceptTouchEvent(true);
+                    if (mTool != TOOL_PICK) pushUndo();
+                    apply(x, y);
+                    return true;
+                case MotionEvent.ACTION_MOVE:
+                    apply(x, y);
+                    return true;
+                default:
+                    return true;
+            }
+        }
+
+        private void apply(int x, int y) {
+            if (x < 0 || y < 0 || x >= TEXELS || y >= TEXELS) return;
+            if (mTool == TOOL_PICK) {
+                int picked = mBitmap.getPixel(x, y);
+                if (Color.alpha(picked) > 0) {
+                    mColor = picked | 0xFF000000;
+                    mTool = TOOL_PAINT;
+                    mOnColorPicked.run();
+                }
+            } else {
+                mBitmap.setPixel(x, y, mTool == TOOL_ERASE ? Color.TRANSPARENT : mColor);
+            }
+            invalidate();
+        }
+    }
+
+    public static void show(@NonNull final Activity activity, @NonNull Bitmap source, @NonNull final Callback callback) {
+        // Work on a 64x64 copy; the original stays untouched until "Done"
+        final Bitmap working = SkinPreview.normalize(source).copy(Bitmap.Config.ARGB_8888, true);
+        final float density = activity.getResources().getDisplayMetrics().density;
+        final Dialog dialog = new Dialog(activity, android.R.style.Theme_Black_NoTitleBar_Fullscreen);
+
+        LinearLayout root = new LinearLayout(activity);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(Color.parseColor("#0B0E1A"));
+
+        final TextView colorSwatch = new TextView(activity);
+        final EditorView[] holder = new EditorView[1];
+        final Runnable updateSwatch = () -> colorSwatch.setBackgroundColor(holder[0].getColor());
+        final EditorView editor = new EditorView(activity, working, updateSwatch);
+        holder[0] = editor;
+
+        // Tools
+        LinearLayout tools = new LinearLayout(activity);
+        tools.setOrientation(LinearLayout.HORIZONTAL);
+        tools.setGravity(Gravity.CENTER_VERTICAL);
+        tools.setPadding(pad(density, 6), pad(density, 6), pad(density, 6), pad(density, 2));
+        tools.addView(colorSwatch, new LinearLayout.LayoutParams(pad(density, 36), pad(density, 36)));
+        colorSwatch.setBackgroundColor(editor.getColor());
+        tools.addView(button(activity, R.string.nexa_skin_paint, v -> { editor.setTool(TOOL_PAINT); }));
+        tools.addView(button(activity, R.string.nexa_skin_erase, v -> editor.setTool(TOOL_ERASE)));
+        tools.addView(button(activity, R.string.nexa_skin_pick, v -> editor.setTool(TOOL_PICK)));
+        tools.addView(button(activity, R.string.nexa_skin_move, v -> editor.setTool(TOOL_MOVE)));
+        tools.addView(button(activity, R.string.nexa_skin_undo, v -> editor.undo()));
+        tools.addView(button(activity, R.string.nexa_skin_zoom_in, v -> editor.zoom(2)));
+        tools.addView(button(activity, R.string.nexa_skin_zoom_out, v -> editor.zoom(-2)));
+        tools.addView(button(activity, R.string.nexa_skin_hex, v -> askHex(activity, editor, colorSwatch)));
+        HorizontalScrollView toolsScroll = new HorizontalScrollView(activity);
+        toolsScroll.setHorizontalScrollBarEnabled(false);
+        toolsScroll.addView(tools);
+        root.addView(toolsScroll, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        // Palette
+        LinearLayout palette = new LinearLayout(activity);
+        palette.setOrientation(LinearLayout.HORIZONTAL);
+        palette.setPadding(pad(density, 6), pad(density, 2), pad(density, 6), pad(density, 6));
+        for (final int color : PALETTE) {
+            View swatch = new View(activity);
+            swatch.setBackgroundColor(color);
+            swatch.setOnClickListener(v -> {
+                editor.setColor(color);
+                colorSwatch.setBackgroundColor(color);
+            });
+            LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(pad(density, 32), pad(density, 32));
+            params.rightMargin = pad(density, 4);
+            palette.addView(swatch, params);
+        }
+        HorizontalScrollView paletteScroll = new HorizontalScrollView(activity);
+        paletteScroll.setHorizontalScrollBarEnabled(false);
+        paletteScroll.addView(palette);
+        root.addView(paletteScroll, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        // The picture, inside two scroll views so that it can be moved in every direction
+        ScrollView vertical = new ScrollView(activity);
+        HorizontalScrollView horizontal = new HorizontalScrollView(activity);
+        horizontal.addView(editor, new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        vertical.addView(horizontal, new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        root.addView(vertical, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+
+        // Bottom bar
+        LinearLayout bottom = new LinearLayout(activity);
+        bottom.setOrientation(LinearLayout.HORIZONTAL);
+        bottom.setPadding(pad(density, 8), pad(density, 6), pad(density, 8), pad(density, 8));
+        TextView cancel = button(activity, android.R.string.cancel, v -> dialog.dismiss());
+        TextView done = button(activity, R.string.nexa_skin_done, v -> {
+            callback.onDone(working);
+            dialog.dismiss();
+        });
+        LinearLayout.LayoutParams half = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+        bottom.addView(cancel, half);
+        bottom.addView(done, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        root.addView(bottom, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        dialog.setContentView(root);
+        dialog.show();
+        Toast.makeText(activity, R.string.nexa_skin_editor_hint, Toast.LENGTH_LONG).show();
+    }
+
+    private static int pad(float density, int dp) {
+        return Math.round(dp * density);
+    }
+
+    private static TextView button(Context context, int textRes, View.OnClickListener listener) {
+        float density = context.getResources().getDisplayMetrics().density;
+        TextView button = new TextView(context);
+        button.setText(textRes);
+        button.setTextColor(Color.WHITE);
+        button.setTextSize(12);
+        button.setTypeface(Typeface.DEFAULT_BOLD);
+        button.setGravity(Gravity.CENTER);
+        button.setPadding(pad(density, 12), pad(density, 8), pad(density, 12), pad(density, 8));
+        GradientDrawable background = new GradientDrawable();
+        background.setColor(Color.parseColor("#3A3F5C"));
+        background.setCornerRadius(pad(density, 8));
+        button.setBackground(background);
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        params.setMargins(pad(density, 3), 0, pad(density, 3), 0);
+        button.setLayoutParams(params);
+        button.setOnClickListener(listener);
+        return button;
+    }
+
+    private static void askHex(final Activity activity, final EditorView editor, final TextView swatch) {
+        final EditText input = new EditText(activity);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
+        input.setText(NexaTheme.colorToHex(editor.getColor()));
+        new AlertDialog.Builder(activity)
+                .setTitle(R.string.nexa_skin_hex)
+                .setMessage(R.string.nexa_theme_hex_hint)
+                .setView(input)
+                .setPositiveButton(android.R.string.ok, (d, w) -> {
+                    Integer color = NexaTheme.parseColor(input.getText().toString());
+                    if (color == null) {
+                        Toast.makeText(activity, R.string.nexa_theme_hex_invalid, Toast.LENGTH_SHORT).show();
+                        return;
+                    }
+                    editor.setColor(color);
+                    swatch.setBackgroundColor(color);
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+}
diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/SkinPackBuilder.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/SkinPackBuilder.java
