diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/ModrinthHelper.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/ModrinthHelper.java
new file mode 100644
index 0000000..f58c9f8
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/ModrinthHelper.java
@@ -0,0 +1,201 @@
+package net.kdt.pojavlaunch.modloaders.modpacks.api;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import net.kdt.pojavlaunch.utils.DownloadUtils;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.concurrent.Callable;
+
+/**
+ * Small helper around the Modrinth API (search + latest file of a project), shared by the quick
+ * packs, the online resource pack browser and the in-game client menu. Modrinth needs no API key.
+ */
+public final class ModrinthHelper {
+    private static final ApiHandler API = new ApiHandler("https://api.modrinth.com/v2");
+
+    private ModrinthHelper() {}
+
+    public static final class Hit {
+        public String slug;
+        public String title;
+        public String description;
+        public String author;
+        public String iconUrl;
+        public int downloads;
+    }
+
+    public static final class FileInfo {
+        public String url;
+        public String fileName;
+        public String sha1;
+        public String versionName;
+        /** Minecraft versions this file supports, shortened for display */
+        public String gameVersions;
+    }
+
+    /**
+     * @param projectType mod, resourcepack, modpack, shader...
+     * @param mcVersion optional Minecraft version filter
+     * @param loader optional loader filter (fabric, forge, neoforge, quilt)
+     * @param index relevance, downloads, follows, newest, updated
+     * @return the hits, empty when the request failed
+     */
+    public static @NonNull List<Hit> search(@NonNull String query, @NonNull String projectType,
+                                            @Nullable String mcVersion, @Nullable String loader,
+                                            @NonNull String index, int limit) {
+        StringBuilder facets = new StringBuilder("[[\"project_type:").append(projectType).append("\"]");
+        if (mcVersion != null && !mcVersion.isEmpty())
+            facets.append(",[\"versions:").append(mcVersion).append("\"]");
+        if (loader != null && !loader.isEmpty())
+            facets.append(",[\"categories:").append(loader).append("\"]");
+        facets.append("]");
+
+        HashMap<String, Object> params = new HashMap<>();
+        params.put("facets", facets.toString());
+        params.put("query", query);
+        params.put("limit", limit);
+        params.put("index", index);
+
+        List<Hit> hits = new ArrayList<>();
+        JsonObject response = API.get("search", params, JsonObject.class);
+        if (response == null) return hits;
+        JsonArray array = response.getAsJsonArray("hits");
+        if (array == null) return hits;
+        for (JsonElement element : array) {
+            if (!element.isJsonObject()) continue;
+            JsonObject object = element.getAsJsonObject();
+            Hit hit = new Hit();
+            hit.slug = string(object, "slug");
+            hit.title = string(object, "title");
+            hit.description = string(object, "description");
+            hit.author = string(object, "author");
+            hit.iconUrl = string(object, "icon_url");
+            hit.downloads = object.has("downloads") && !object.get("downloads").isJsonNull()
+                    ? object.get("downloads").getAsInt() : 0;
+            if (hit.slug != null && hit.title != null) hits.add(hit);
+        }
+        return hits;
+    }
+
+    /**
+     * Finds the primary file of the newest version of a project that matches the filters.
+     * @return null when the project has no matching version
+     */
+    public static @Nullable FileInfo findFile(@NonNull String slug, @Nullable String mcVersion,
+                                              @Nullable String loader) {
+        HashMap<String, Object> params = new HashMap<>();
+        if (mcVersion != null && !mcVersion.isEmpty()) params.put("game_versions", "[\"" + mcVersion + "\"]");
+        if (loader != null && !loader.isEmpty()) params.put("loaders", "[\"" + loader + "\"]");
+        JsonArray versions = API.get("project/" + slug + "/version", params, JsonArray.class);
+        if (versions == null || versions.size() == 0) return null;
+
+        return parseVersion(versions.get(0).getAsJsonObject());
+    }
+
+    /**
+     * Lists the newest versions of a project (newest first) so the user can pick one.
+     * Versions without a downloadable file are left out.
+     */
+    public static @NonNull List<FileInfo> listVersions(@NonNull String slug, @Nullable String mcVersion,
+                                                       @Nullable String loader, int limit) {
+        HashMap<String, Object> params = new HashMap<>();
+        if (mcVersion != null && !mcVersion.isEmpty()) params.put("game_versions", "[\"" + mcVersion + "\"]");
+        if (loader != null && !loader.isEmpty()) params.put("loaders", "[\"" + loader + "\"]");
+        List<FileInfo> result = new ArrayList<>();
+        JsonArray versions = API.get("project/" + slug + "/version", params, JsonArray.class);
+        if (versions == null) return result;
+        for (JsonElement element : versions) {
+            if (result.size() >= limit) break;
+            if (!element.isJsonObject()) continue;
+            FileInfo info = parseVersion(element.getAsJsonObject());
+            if (info != null) result.add(info);
+        }
+        return result;
+    }
+
+    private static @Nullable FileInfo parseVersion(JsonObject version) {
+        JsonArray files = version.getAsJsonArray("files");
+        if (files == null || files.size() == 0) return null;
+
+        JsonObject file = files.get(0).getAsJsonObject();
+        for (JsonElement element : files) {
+            JsonObject candidate = element.getAsJsonObject();
+            if (candidate.has("primary") && candidate.get("primary").getAsBoolean()) {
+                file = candidate;
+                break;
+            }
+        }
+        FileInfo info = new FileInfo();
+        info.url = string(file, "url");
+        String name = string(file, "filename");
+        if (info.url == null || name == null) return null;
+        info.fileName = name.replaceAll("[\\\\/:*?\"<>|]", "_");
+        info.versionName = string(version, "name");
+        if (file.has("hashes") && file.get("hashes").isJsonObject()
+                && file.getAsJsonObject("hashes").has("sha1")) {
+            info.sha1 = file.getAsJsonObject("hashes").get("sha1").getAsString();
+        }
+        JsonArray gameVersions = version.has("game_versions") && version.get("game_versions").isJsonArray()
+                ? version.getAsJsonArray("game_versions") : null;
+        if (gameVersions != null && gameVersions.size() > 0) {
+            StringBuilder text = new StringBuilder();
+            for (int i = 0; i < gameVersions.size() && i < 3; i++) {
+                if (i > 0) text.append(", ");
+                text.append(gameVersions.get(i).getAsString());
+            }
+            if (gameVersions.size() > 3) text.append("...");
+            info.gameVersions = text.toString();
+        }
+        return info;
+    }
+
+    /** Downloads the file into the directory (skips the download if it is already there) */
+    public static File download(@NonNull FileInfo info, @NonNull File directory) throws IOException {
+        //noinspection ResultOfMethodCallIgnored
+        directory.mkdirs();
+        final File target = new File(directory, info.fileName);
+        if (target.exists() && info.sha1 != null) {
+            // Already complete? Then there is nothing to do
+            boolean complete = true;
+            try {
+                DownloadUtils.ensureSha1(target, info.sha1, (Callable<Void>) () -> {
+                    throw new IOException("wrong hash");
+                });
+            } catch (IOException e) {
+                complete = false;
+            }
+            if (complete) return target;
+        }
+        // Download under a temporary name, so an interrupted download never leaves a broken file
+        final File partial = new File(directory, info.fileName + ".part");
+        //noinspection ResultOfMethodCallIgnored
+        partial.delete(); // a leftover from an interrupted download must not be reused
+        try {
+            DownloadUtils.ensureSha1(partial, info.sha1, (Callable<Void>) () -> {
+                DownloadUtils.downloadFile(info.url, partial);
+                return null;
+            });
+            if (target.exists() && !target.delete()) throw new IOException("Could not replace " + info.fileName);
+            if (!partial.renameTo(target)) throw new IOException("Could not save " + info.fileName);
+        } finally {
+            //noinspection ResultOfMethodCallIgnored
+            if (partial.exists()) partial.delete();
+        }
+        return target;
+    }
+
+    private static @Nullable String string(JsonObject object, String key) {
+        if (!object.has(key) || object.get(key).isJsonNull()) return null;
+        return object.get(key).getAsString();
+    }
+}
diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/QuickPackInstaller.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/QuickPackInstaller.java
new file mode 100644
index 0000000..3968b41
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/QuickPackInstaller.java
@@ -0,0 +1,138 @@
+package net.kdt.pojavlaunch.modloaders.modpacks.api;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.modloaders.NeoForgeUtils;
+import net.kdt.pojavlaunch.nexa.ModGuard;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.regex.Pattern;
+
+/**
+ * Installs a fixed list of Modrinth mods (by project slug) into the mods folder of a profile.
+ * For each mod the newest version matching the profile's Minecraft version and loader is used.
+ * Mods that have no matching version are skipped.
+ */
+public final class QuickPackInstaller {
+    public static final String[] PACK_PERFORMANCE = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "entityculling", "immediatelyfast", "dynamic-fps"
+    };
+    public static final String[] PACK_PVP = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "modmenu", "appleskin", "logical-zoom", "freelook", "mouse-tweaks"
+    };
+    public static final String[] PACK_SURVIVAL = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "appleskin", "xaeros-minimap", "xaeros-world-map", "jade", "mouse-tweaks"
+    };
+
+    private static final Pattern VERSION_PATTERN = Pattern.compile("^\\d+\\.\\d+(\\.\\d+)?$");
+
+    public interface Listener {
+        void onProgress(String slug, int index, int total);
+    }
+
+    public static final class Result {
+        public int installed;
+        public int skipped;
+        /** True when the selected profile is not a modded one (or cannot be understood) */
+        public boolean needModdedProfile;
+    }
+
+    private QuickPackInstaller() {}
+
+    /** @return fabric, quilt, forge, neoforge or null when the profile is vanilla/unknown */
+    public static @Nullable String detectLoader(@Nullable String versionId) {
+        if (versionId == null) return null;
+        String id = versionId.toLowerCase();
+        if (id.contains("fabric-loader") || id.startsWith("fabric")) return "fabric";
+        if (id.contains("quilt-loader") || id.startsWith("quilt")) return "quilt";
+        if (id.contains("neoforge")) return "neoforge";
+        if (id.contains("forge")) return "forge";
+        return null;
+    }
+
+    /** Extracts the Minecraft version out of a modded version id such as fabric-loader-0.15.11-1.20.1 */
+    public static @Nullable String detectMcVersion(@Nullable String versionId, @Nullable String loader) {
+        if (versionId == null || loader == null) return null;
+        String[] parts = versionId.split("-");
+        if (loader.equals("fabric") || loader.equals("quilt")) {
+            for (int i = parts.length - 1; i >= 0; i--) {
+                if (VERSION_PATTERN.matcher(parts[i]).matches()) return parts[i];
+            }
+        } else if (loader.equals("neoforge")) {
+            // neoforge-21.1.172: the number is the NeoForge version, the Minecraft one is derived from it
+            for (String part : parts) {
+                if (VERSION_PATTERN.matcher(part).matches()) return NeoForgeUtils.toMinecraftVersion(part);
+            }
+        } else {
+            for (String part : parts) {
+                if (VERSION_PATTERN.matcher(part).matches()) return part;
+            }
+        }
+        return null;
+    }
+
+    /** @return the Minecraft version of a profile (vanilla or modded), or null when it is unknown */
+    public static @Nullable String resolveMcVersion(@Nullable String versionId) {
+        String loader = detectLoader(versionId);
+        if (loader != null) return detectMcVersion(versionId, loader);
+        if (versionId != null && VERSION_PATTERN.matcher(versionId).matches()) return versionId;
+        return null;
+    }
+
+    public static @NonNull Result install(@NonNull MinecraftProfile profile, @NonNull String[] slugs,
+                                          @Nullable Listener listener) {
+        Result result = new Result();
+        String loader = detectLoader(profile.lastVersionId);
+        String mcVersion = detectMcVersion(profile.lastVersionId, loader);
+        if (loader == null || mcVersion == null) {
+            result.needModdedProfile = true;
+            return result;
+        }
+
+        File modsDir = new File(Tools.getGameDirPath(profile), "mods");
+        for (int i = 0; i < slugs.length; i++) {
+            String slug = slugs[i];
+            if (listener != null) listener.onProgress(slug, i + 1, slugs.length);
+            try {
+                if (installProject(slug, mcVersion, loader, modsDir) != null) result.installed++;
+                else result.skipped++;
+            } catch (Exception e) {
+                e.printStackTrace();
+                result.skipped++;
+            }
+        }
+        return result;
+    }
+
+    /**
+     * Installs the newest version of a Modrinth project for the Minecraft version and loader.
+     * @return the file name that was saved, or null when there is no matching version
+     */
+    public static @Nullable String installProject(@NonNull String slug, @NonNull String mcVersion,
+                                                  @NonNull String loader, @NonNull File modsDir) throws IOException {
+        ModrinthHelper.FileInfo file = ModrinthHelper.findFile(slug, mcVersion, loader);
+        if (file == null) return null;
+        // Download to a temporary folder first, so a wrong or duplicate mod never reaches the mods folder
+        File tempDir = new File(Tools.DIR_CACHE, "mod_check_" + System.nanoTime());
+        try {
+            File downloaded = ModrinthHelper.download(file, tempDir);
+            ModGuard.admit(downloaded, file.fileName, modsDir, new ModGuard.Target(loader, mcVersion));
+            return file.fileName;
+        } catch (ModGuard.RejectedException e) {
+            // Already installed counts as installed; anything else is simply not available here
+            return e.reason == ModGuard.Reason.ALREADY_INSTALLED ? e.existingFile : null;
+        } finally {
+            File[] left = tempDir.listFiles();
+            if (left != null) for (File f : left) f.delete();
+            //noinspection ResultOfMethodCallIgnored
+            tempDir.delete();
+        }
+    }
+}
