+package net.kdt.pojavlaunch.nexa;
+
+import android.content.Context;
+import android.content.Intent;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.core.content.pm.ShortcutInfoCompat;
+import androidx.core.content.pm.ShortcutManagerCompat;
+import androidx.core.graphics.drawable.IconCompat;
+
+import net.kdt.pojavlaunch.LauncherActivity;
+import net.kdt.pojavlaunch.R;
+
+/** A home screen icon that opens the launcher, selects one profile and starts the game */
+public final class ShortcutHelper {
+    public static final String ACTION = "net.kdt.pojavlaunch.NEXA_LAUNCH_PROFILE";
+    public static final String EXTRA_PROFILE = "nexa_profile_key";
+
+    private ShortcutHelper() {}
+
+    public static void pin(@NonNull Context context, @NonNull String profileKey, @NonNull String profileName) {
+        if (!ShortcutManagerCompat.isRequestPinShortcutSupported(context)) {
+            Toast.makeText(context, R.string.nexa_shortcut_unsupported, Toast.LENGTH_LONG).show();
+            return;
+        }
+        Intent intent = new Intent(context, LauncherActivity.class);
+        intent.setAction(ACTION);
+        intent.putExtra(EXTRA_PROFILE, profileKey);
+        ShortcutInfoCompat info = new ShortcutInfoCompat.Builder(context, "nexa_profile_" + profileKey)
+                .setShortLabel(profileName)
+                .setLongLabel(profileName)
+                .setIcon(IconCompat.createWithResource(context, R.mipmap.ic_launcher))
+                .setIntent(intent)
+                .build();
+        ShortcutManagerCompat.requestPinShortcut(context, info, null);
+    }
+}
