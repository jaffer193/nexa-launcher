+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/CrashDoctor.java
@@ -0,0 +1,133 @@
+package net.kdt.pojavlaunch.nexa;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import net.kdt.pojavlaunch.Tools;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Reads the end of the game log after a crash and explains the most common causes in plain words.
+ * It only suggests things: when nothing matches, it returns the last error lines of the log.
+ */
+public final class CrashDoctor {
+    private static final int MAX_BYTES = 400 * 1024;
+
+    private CrashDoctor() {}
+
+    /**
+     * @param exitCode the exit code or signal number reported by the game process
+     * @param isSignal true if the process was ended by a signal (Android killed it, for example)
+     * @return a text for the crash dialog, or null if there is nothing useful to say
+     */
+    public static @Nullable String diagnose(int exitCode, boolean isSignal) {
+        String log = readTail(new File(Tools.DIR_GAME_HOME, "latestlog.txt"));
+        String lower = log.toLowerCase(Locale.ROOT);
+        List<String> hints = new ArrayList<>();
+
+        if (isSignal || exitCode == 137 || exitCode == 143) {
+            hints.add("Android closed the game, usually because the phone ran out of free RAM. "
+                    + "Close other apps, lower the RAM allocation in Settings > Java, or use a lighter modpack.");
+        }
+        if (containsAny(lower, "zip end header not found", "error analyzing", "zipexception", "not a zip file")) {
+            Matcher damaged = Pattern.compile("/([^/\\\\]+\\.jar)\\]\\s*:").matcher(log);
+            String name = damaged.find() ? damaged.group(1) : null;
+            hints.add("A mod file is damaged (usually an interrupted download)"
+                    + (name != null ? ": " + name : "")
+                    + ". Delete it from the profile's mods folder. Damaged files are also moved aside "
+                    + "automatically the next time you start the game.");
+        }
+        if (containsAny(lower, "outofmemoryerror", "java heap space", "gc overhead limit")) {
+            hints.add("The game ran out of memory. Raise the RAM allocation in Settings > Java "
+                    + "(modpacks usually need 3-4 GB) and close other apps. If the phone has little free RAM, "
+                    + "turn off \"Lower RAM automatically\" only when you have enough free memory.");
+        }
+        if (containsAny(lower, "unsupportedclassversionerror", "compiled by a more recent version of the java runtime")) {
+            hints.add("Wrong Java version. In the profile settings choose Java 17 (Minecraft 1.18 - 1.20.4) "
+                    + "or Java 21 (1.20.5 and newer).");
+        }
+        if (containsAny(lower, "incompatible mods found", "mod resolution failed",
+                "missing or unsupported mandatory dependencies", "could not find required mod",
+                "which is missing!", "requires any version of", "unmet dependency")) {
+            hints.add("A mod needs another mod that is missing (often Fabric API), or it is made for another "
+                    + "game version. The lines below name the mod.");
+        }
+        if (containsAny(lower, "duplicate mod", "found duplicate", "duplicated mod")) {
+            hints.add("Two copies of the same mod are in the mods folder. Remove one of them.");
+        }
+        if (containsAny(lower, "mixin apply failed", "mixintransformererror", "invalidmixinexception",
+                "mixin transformation of", "mixin prepare failed")) {
+            hints.add("Two mods conflict with each other (Mixin error). Remove the mod named in the lines "
+                    + "below, or the mods you added last.");
+        }
+        if (containsAny(lower, "noclassdeffounderror", "nosuchmethoderror", "nosuchfielderror")) {
+            hints.add("A mod does not match the game or loader version, or a library mod it needs is missing.");
+        }
+        if (containsAny(lower, "glfw error", "pixel format", "failed to create window", "requires opengl",
+                "opengl 3.", "glsl", "gl_invalid", "could not create context")) {
+            hints.add("Graphics problem. In Settings > Video change the renderer (LTW for Minecraft 1.17 and "
+                    + "newer, GL4ES for older ones). Also try without Sodium/Iris/shader mods.");
+        }
+
+        List<String> keyLines = lastErrorLines(log, 3);
+        if (hints.isEmpty() && keyLines.isEmpty()) return null;
+
+        StringBuilder text = new StringBuilder();
+        if (!hints.isEmpty()) {
+            text.append("Possible cause:");
+            for (String hint : hints) text.append("\n- ").append(hint);
+        }
+        if (!keyLines.isEmpty()) {
+            if (text.length() > 0) text.append("\n\n");
+            text.append("From the log:");
+            for (String line : keyLines) text.append("\n").append(line);
+        }
+        return text.toString();
+    }
+
+    private static boolean containsAny(String text, String... needles) {
+        for (String needle : needles) {
+            if (text.contains(needle)) return true;
+        }
+        return false;
+    }
+
+    /** The last few lines that look like an error, shortened to fit a dialog */
+    private static @NonNull List<String> lastErrorLines(String log, int max) {
+        List<String> result = new ArrayList<>();
+        String[] lines = log.split("\n");
+        for (int i = lines.length - 1; i >= 0 && result.size() < max; i--) {
+            String line = lines[i].trim();
+            String lower = line.toLowerCase(Locale.ROOT);
+            boolean looksLikeError = lower.startsWith("caused by:") || lower.contains("exception in thread")
+                    || lower.contains("[error]") || lower.contains("/error]") || lower.contains("fatal");
+            if (!looksLikeError || line.isEmpty()) continue;
+            if (line.length() > 170) line = line.substring(0, 170) + "...";
+            if (!result.contains(line)) result.add(line);
+        }
+        return result;
+    }
+
+    private static @NonNull String readTail(File file) {
+        if (!file.exists()) return "";
+        try (RandomAccessFile reader = new RandomAccessFile(file, "r")) {
+            long length = reader.length();
+            long start = Math.max(0, length - MAX_BYTES);
+            reader.seek(start);
+            byte[] data = new byte[(int) (length - start)];
+            reader.readFully(data);
+            return new String(data, StandardCharsets.UTF_8);
+        } catch (IOException | RuntimeException e) {
+            return "";
+        }
+    }
+}
