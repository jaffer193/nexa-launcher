+import net.kdt.pojavlaunch.nexa.ShaderEnabler;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Search resource packs on Modrinth, with their icons. Tapping a pack lets the user choose
+ * which version (update) to install; the pack is installed already enabled.
+ */
+public class ResourcePackBrowserFragment extends Fragment {
+    public static final String TAG = "ResourcePackBrowserFragment";
+
+    /** Icons are small, so a handful of them can be kept in memory */
+    private static final LruCache<String, Bitmap> sIconCache = new LruCache<>(60);
+
+    private EditText mQuery;
+    private TextView mStatus;
+    private HitAdapter mAdapter;
+    private final List<ModrinthHelper.Hit> mHits = new ArrayList<>();
+    private @Nullable String mMcVersion;
+    /** The same screen also browses shader packs (they go to the shaderpacks folder) */
+    private boolean mShaders = false;
+    private volatile int mSearchId = 0;
+
+    public ResourcePackBrowserFragment() {
+        super(R.layout.fragment_rp_browser);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        net.kdt.pojavlaunch.nexa.NexaTheme.applyBackground(view);
+        mShaders = getArguments() != null && getArguments().getBoolean("shaders", false);
+        if (mShaders) ((TextView) view.findViewById(R.id.rpb_title)).setText(R.string.nexa_shader_title);
+        mQuery = view.findViewById(R.id.rpb_query);
+        mStatus = view.findViewById(R.id.rpb_status);
+        ListView list = view.findViewById(R.id.rpb_list);
+        mAdapter = new HitAdapter(requireContext(), mHits);
+        list.setAdapter(mAdapter);
+        list.setOnItemClickListener((parent, v, position, id) -> pickVersion(mHits.get(position)));
+
+        try {
+            mMcVersion = QuickPackInstaller.resolveMcVersion(LauncherProfiles.getCurrentProfile().lastVersionId);
+        } catch (RuntimeException e) {
+            mMcVersion = null;
+        }
+
+        view.findViewById(R.id.rpb_search).setOnClickListener(v -> search());
+        mQuery.setOnEditorActionListener((v, actionId, event) -> {
+            boolean enter = event != null && event.getKeyCode() == KeyEvent.KEYCODE_ENTER;
+            if (actionId == EditorInfo.IME_ACTION_SEARCH || enter) {
+                search();
+                return true;
+            }
+            return false;
+        });
+        search(); // Starts with the most downloaded packs
+    }
+
+    private void search() {
+        final String query = mQuery.getText().toString().trim();
+        final int searchId = ++mSearchId;
+        mStatus.setText(R.string.nexa_rpb_searching);
+        PojavApplication.sExecutorService.execute(() -> {
+            String index = query.isEmpty() ? "downloads" : "relevance";
+            final String projectType = mShaders ? "shader" : "resourcepack";
+            List<ModrinthHelper.Hit> hits = ModrinthHelper.search(query, projectType, mMcVersion, null, index, 40);
+            boolean filtered = mMcVersion != null;
+            if (hits.isEmpty() && filtered) {
+                // Most resource packs work on several versions, so try again without the filter
+                hits = ModrinthHelper.search(query, projectType, null, null, index, 40);
+                filtered = false;
+            }
+            final List<ModrinthHelper.Hit> result = hits;
+            final boolean usedFilter = filtered;
+            Tools.runOnUiThread(() -> showResults(searchId, result, usedFilter));
+        });
+    }
+
+    private void showResults(int searchId, List<ModrinthHelper.Hit> hits, boolean usedFilter) {
+        if (!isAdded() || searchId != mSearchId) return; // a newer search replaced this one
+        mHits.clear();
+        mHits.addAll(hits);
+        mAdapter.notifyDataSetChanged();
+        if (hits.isEmpty()) mStatus.setText(R.string.nexa_rpb_nothing);
+        else if (usedFilter) mStatus.setText(getString(R.string.nexa_rpb_for_version, mMcVersion));
+        else mStatus.setText(R.string.nexa_rpb_tap_to_install);
+    }
+
+    // ---- Choosing a version and installing -----------------------------------------------------
+
+    /** Loads the versions of the pack and lets the user pick the one to install */
+    private void pickVersion(final ModrinthHelper.Hit hit) {
+        final Context appContext = requireContext().getApplicationContext();
+        Toast.makeText(appContext, R.string.nexa_rpb_loading_versions, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            List<ModrinthHelper.FileInfo> versions = ModrinthHelper.listVersions(hit.slug, mMcVersion, null, 30);
+            boolean filtered = mMcVersion != null;
+            if (versions.isEmpty() && filtered) {
+                versions = ModrinthHelper.listVersions(hit.slug, null, null, 30);
+                filtered = false;
+            }
+            final List<ModrinthHelper.FileInfo> result = versions;
+            final boolean usedFilter = filtered;
+            Tools.runOnUiThread(() -> showVersionDialog(hit, result, usedFilter));
+        });
+    }
+
+    private void showVersionDialog(ModrinthHelper.Hit hit, List<ModrinthHelper.FileInfo> versions, boolean usedFilter) {
+        if (!isAdded()) return;
+        if (versions.isEmpty()) {
+            Toast.makeText(requireContext(), getString(R.string.nexa_rpb_no_file, hit.title), Toast.LENGTH_LONG).show();
+            return;
+        }
+        String[] labels = new String[versions.size()];
+        for (int i = 0; i < labels.length; i++) {
+            ModrinthHelper.FileInfo info = versions.get(i);
+            String name = info.versionName != null ? info.versionName : info.fileName;
+            labels[i] = info.gameVersions != null ? name + "\n" + info.gameVersions : name;
+        }
+        new AlertDialog.Builder(requireContext())
+                .setTitle(getString(R.string.nexa_rpb_pick_version, hit.title))
+                .setItems(labels, (dialog, which) -> install(hit, versions.get(which)))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void install(ModrinthHelper.Hit hit, ModrinthHelper.FileInfo file) {
+        final Context appContext = requireContext().getApplicationContext();
+        Toast.makeText(appContext, getString(R.string.nexa_rpb_installing, hit.title), Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            try {
+                File gameDir = Tools.getGameDirPath(LauncherProfiles.getCurrentProfile());
+                if (mShaders) {
+                    File saved = ModrinthHelper.download(file, new File(gameDir, "shaderpacks"));
+                    ShaderEnabler.select(gameDir, saved.getName());
+                    message = appContext.getString(R.string.nexa_shader_done, hit.title);
+                } else {
+                    File saved = ModrinthHelper.download(file, ResourcePackManager.getPackDir(gameDir));
+                    ResourcePackManager.setEnabled(gameDir, saved.getName(), true);
+                    message = appContext.getString(R.string.nexa_rpb_done, hit.title);
+                }
+            } catch (IOException | RuntimeException e) {
+                e.printStackTrace();
+                message = appContext.getString(R.string.nexa_rpb_failed, hit.title);
+            }
+            final String finalMessage = message;
+            Tools.runOnUiThread(() -> Toast.makeText(appContext, finalMessage, Toast.LENGTH_LONG).show());
+        });
+    }
+
+    // ---- List with icons -----------------------------------------------------------------------
+
+    private static final class HitAdapter extends ArrayAdapter<ModrinthHelper.Hit> {
+        private final LayoutInflater mInflater;
+
+        HitAdapter(Context context, List<ModrinthHelper.Hit> hits) {
+            super(context, 0, hits);
+            mInflater = LayoutInflater.from(context);
+        }
+
+        @NonNull
+        @Override
+        public View getView(int position, @Nullable View convertView, @NonNull ViewGroup parent) {
+            View row = convertView != null ? convertView : mInflater.inflate(R.layout.item_rp_hit, parent, false);
+            ModrinthHelper.Hit hit = getItem(position);
+            if (hit == null) return row;
+
+            ((TextView) row.findViewById(R.id.rpb_item_title)).setText(hit.title);
+            String meta = getContext().getString(R.string.nexa_rpb_downloads, hit.downloads);
+            if (hit.author != null) meta = hit.author + "  -  " + meta;
+            ((TextView) row.findViewById(R.id.rpb_item_meta)).setText(meta);
+            TextView description = row.findViewById(R.id.rpb_item_desc);
+            description.setText(hit.description == null ? "" : hit.description);
+
+            loadIcon((ImageView) row.findViewById(R.id.rpb_item_icon), hit.iconUrl);
+            return row;
+        }
+
+        private void loadIcon(final ImageView view, @Nullable final String url) {
+            view.setTag(url);
+            view.setImageResource(R.drawable.ic_file); // placeholder while the icon loads
+            if (url == null) return;
+            Bitmap cached = sIconCache.get(url);
+            if (cached != null) {
+                view.setImageBitmap(cached);
+                return;
+            }
+            PojavApplication.sExecutorService.execute(() -> {
+                final Bitmap bitmap = downloadIcon(url);
+                if (bitmap == null) return;
+                sIconCache.put(url, bitmap);
+                // The row may have been reused for another pack meanwhile
+                Tools.runOnUiThread(() -> {
+                    if (url.equals(view.getTag())) view.setImageBitmap(bitmap);
+                });
+            });
+        }
+
+        private static @Nullable Bitmap downloadIcon(String address) {
+            HttpURLConnection connection = null;
+            try {
+                connection = (HttpURLConnection) new URL(address).openConnection();
+                connection.setConnectTimeout(10000);
+                connection.setReadTimeout(10000);
+                connection.setRequestProperty("User-Agent", "Nexa-Launcher");
+                try (InputStream in = connection.getInputStream();
+                     ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+                    byte[] buffer = new byte[8192];
+                    int read;
+                    while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+                    byte[] data = out.toByteArray();
+
+                    BitmapFactory.Options bounds = new BitmapFactory.Options();
+                    bounds.inJustDecodeBounds = true;
+                    BitmapFactory.decodeByteArray(data, 0, data.length, bounds);
+                    int sample = 1;
+                    while (bounds.outWidth / (sample * 2) >= 160) sample *= 2;
+                    BitmapFactory.Options options = new BitmapFactory.Options();
+                    options.inSampleSize = sample;
+                    return BitmapFactory.decodeByteArray(data, 0, data.length, options);
+                }
+            } catch (IOException | RuntimeException e) {
+                return null;
+            } finally {
+                if (connection != null) connection.disconnect();
+            }
+        }
+    }
+}
