+package net.kdt.pojavlaunch.prefs.screens;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Bundle;
+import android.widget.Toast;
+
+import androidx.preference.SwitchPreference;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.QuickPackInstaller;
+import net.kdt.pojavlaunch.nexa.FpsBooster;
+import net.kdt.pojavlaunch.prefs.LauncherPreferences;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** Settings > Advanced > FPS Booster */
+public class LauncherPreferenceFpsFragment extends LauncherPreferenceFragment {
+    private static final AtomicBoolean sInstalling = new AtomicBoolean(false);
+
+    @Override
+    public void onCreatePreferences(Bundle b, String str) {
+        addPreferencesFromResource(R.xml.pref_fps);
+        requirePreference("nexa_fps_preset").setOnPreferenceClickListener(preference -> {
+            new AlertDialog.Builder(requireContext())
+                    .setTitle(R.string.nexa_fps_preset_title)
+                    .setMessage(R.string.nexa_fps_preset_confirm)
+                    .setPositiveButton(android.R.string.ok, (d, w) -> applyPreset())
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .show();
+            return true;
+        });
+        requirePreference("nexa_fps_options").setOnPreferenceClickListener(preference -> {
+            applyOptions(requireContext());
+            return true;
+        });
+        requirePreference("nexa_fps_mods").setOnPreferenceClickListener(preference -> {
+            installPerformanceMods();
+            return true;
+        });
+    }
+
+    private void applyPreset() {
+        Context context = requireContext();
+        SharedPreferences prefs = LauncherPreferences.DEFAULT_PREF;
+        prefs.edit()
+                .putInt("resolutionRatio", 75)
+                .putBoolean("sustainedPerformance", true)
+                .putBoolean(FpsBooster.PREF_JVM_FLAGS, true)
+                .apply();
+        LauncherPreferences.loadPreferences(context.getApplicationContext());
+        requirePreference(FpsBooster.PREF_JVM_FLAGS, SwitchPreference.class).setChecked(true);
+        applyOptions(context);
+        Toast.makeText(context, R.string.nexa_fps_preset_done, Toast.LENGTH_LONG).show();
+    }
+
+    private void applyOptions(Context context) {
+        try {
+            File gameDir = Tools.getGameDirPath(LauncherProfiles.getCurrentProfile());
+            FpsBooster.applyOptions(gameDir);
+            Toast.makeText(context, R.string.nexa_fps_options_done, Toast.LENGTH_SHORT).show();
+        } catch (IOException | RuntimeException e) {
+            Tools.showError(context, e);
+        }
+    }
+
+    private void installPerformanceMods() {
+        final Context appContext = requireContext().getApplicationContext();
+        if (!sInstalling.compareAndSet(false, true)) {
+            Toast.makeText(appContext, R.string.nexa_pack_busy, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        final MinecraftProfile profile;
+        try {
+            profile = LauncherProfiles.getCurrentProfile();
+        } catch (RuntimeException e) {
+            sInstalling.set(false);
+            Toast.makeText(appContext, R.string.nexa_pack_need_modded, Toast.LENGTH_LONG).show();
+            return;
+        }
+        Toast.makeText(appContext, R.string.nexa_fps_mods_started, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            QuickPackInstaller.Result result;
+            try {
+                result = QuickPackInstaller.install(profile, QuickPackInstaller.PACK_PERFORMANCE, null);
+            } finally {
+                sInstalling.set(false);
+            }
+            final String message = result.needModdedProfile
+                    ? appContext.getString(R.string.nexa_pack_need_modded)
+                    : appContext.getString(R.string.nexa_pack_done, result.installed, result.skipped);
+            Tools.runOnUiThread(() -> Toast.makeText(appContext, message, Toast.LENGTH_LONG).show());
+        });
+    }
+}
