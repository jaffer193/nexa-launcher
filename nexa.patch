+    public void updateElyByFace() {
+        File downloaded = new File(Tools.DIR_CACHE, username + ".elyskin");
+        try {
+            Tools.downloadFile("https://skinsystem.ely.by/skins/" + username + ".png", downloaded.getAbsolutePath());
+            Bitmap skin = BitmapFactory.decodeFile(downloaded.getAbsolutePath());
+            if (skin == null || skin.getWidth() < 64) return;
+            int unit = skin.getWidth() / 64; // skins can be HD
+            Bitmap head = Bitmap.createBitmap(8 * unit, 8 * unit, Bitmap.Config.ARGB_8888);
+            android.graphics.Canvas canvas = new android.graphics.Canvas(head);
+            android.graphics.Rect dst = new android.graphics.Rect(0, 0, head.getWidth(), head.getHeight());
+            // face, then the hat layer on top of it
+            canvas.drawBitmap(skin, new android.graphics.Rect(8 * unit, 8 * unit, 16 * unit, 16 * unit), dst, null);
+            canvas.drawBitmap(skin, new android.graphics.Rect(40 * unit, 8 * unit, 48 * unit, 16 * unit), dst, null);
+            Bitmap scaled = Bitmap.createScaledBitmap(head, 100, 100, false);
+            try (OutputStream out = new FileOutputStream(getSkinFaceFile(username))) {
+                scaled.compress(Bitmap.CompressFormat.PNG, 100, out);
+            }
+        } catch (IOException | RuntimeException e) {
+            Log.w("SkinLoader", "Could not update the Ely.by skin face", e);
+        } finally {
+            downloaded.delete();
+        }
+    }
     
