+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/ProfilePorter.java
@@ -0,0 +1,141 @@
+package net.kdt.pojavlaunch.nexa;
+
+import androidx.annotation.NonNull;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.prefs.LauncherPreferences;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Enumeration;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+import java.util.zip.ZipOutputStream;
+
+/**
+ * Exports a profile to one zip (its settings, mods, config, resource packs, shader packs and options)
+ * and imports such a zip as a new profile. Worlds are not included.
+ */
+public final class ProfilePorter {
+    private static final String META = "nexa_profile.json";
+    private static final String FILES = "files/";
+    private static final String[] INCLUDED = {
+            "mods", "config", "resourcepacks", "shaderpacks", "options.txt", "optionsof.txt", "servers.dat"
+    };
+
+    private ProfilePorter() {}
+
+    public static final class Imported {
+        public final String key;
+        public final String name;
+        public final String versionId;
+        /** False when the game version or loader of the profile is not installed on this device yet */
+        public final boolean versionInstalled;
+
+        Imported(String key, String name, String versionId, boolean versionInstalled) {
+            this.key = key;
+            this.name = name;
+            this.versionId = versionId;
+            this.versionInstalled = versionInstalled;
+        }
+    }
+
+    public static void export(@NonNull MinecraftProfile profile, @NonNull OutputStream target) throws IOException {
+        try (ZipOutputStream zip = new ZipOutputStream(target)) {
+            zip.putNextEntry(new ZipEntry(META));
+            zip.write(Tools.GLOBAL_GSON.toJson(profile).getBytes(StandardCharsets.UTF_8));
+            zip.closeEntry();
+            File gameDir = Tools.getGameDirPath(profile);
+            for (String name : INCLUDED) {
+                File file = new File(gameDir, name);
+                if (file.exists()) addRecursive(zip, file, FILES + name);
+            }
+        }
+    }
+
+    private static void addRecursive(ZipOutputStream zip, File file, String path) throws IOException {
+        if (file.isDirectory()) {
+            File[] children = file.listFiles();
+            if (children != null) for (File child : children) addRecursive(zip, child, path + "/" + child.getName());
+            return;
+        }
+        // Files that were never finished must not travel in an export
+        if (file.getName().endsWith(".part") || file.getName().endsWith(".broken")) return;
+        zip.putNextEntry(new ZipEntry(path));
+        byte[] buffer = new byte[8192];
+        try (InputStream in = new FileInputStream(file)) {
+            int read;
+            while ((read = in.read(buffer)) != -1) zip.write(buffer, 0, read);
+        }
+        zip.closeEntry();
+    }
+
+    public static @NonNull Imported importFrom(@NonNull File zipFile) throws IOException {
+        if (LauncherProfiles.mainProfileJson == null) LauncherProfiles.load();
+        try (ZipFile zip = new ZipFile(zipFile)) {
+            ZipEntry meta = zip.getEntry(META);
+            if (meta == null) throw new IOException("This is not a Nexa profile export.");
+            ByteArrayOutputStream json = new ByteArrayOutputStream();
+            try (InputStream in = zip.getInputStream(meta)) {
+                copy(in, json);
+            }
+            MinecraftProfile profile = Tools.GLOBAL_GSON.fromJson(
+                    new String(json.toByteArray(), StandardCharsets.UTF_8), MinecraftProfile.class);
+            if (profile == null || profile.lastVersionId == null) throw new IOException("The profile information is damaged.");
+
+            String name = profile.name == null || profile.name.isEmpty() ? "Imported profile" : profile.name;
+            profile.name = name;
+            profile.gameDir = "./custom_instances/" + ProfileCloner.freeFolderName(name);
+            File destination = Tools.getGameDirPath(profile);
+            //noinspection ResultOfMethodCallIgnored
+            destination.mkdirs();
+            String canonicalRoot = destination.getCanonicalPath() + File.separator;
+
+            Enumeration<? extends ZipEntry> entries = zip.entries();
+            while (entries.hasMoreElements()) {
+                ZipEntry entry = entries.nextElement();
+                String path = entry.getName().replace('\\', '/');
+                if (!path.startsWith(FILES) || path.length() == FILES.length()) continue;
+                File target = new File(destination, path.substring(FILES.length()));
+                // Zip-slip protection
+                if (!target.getCanonicalPath().startsWith(canonicalRoot)) continue;
+                if (entry.isDirectory()) {
+                    //noinspection ResultOfMethodCallIgnored
+                    target.mkdirs();
+                    continue;
+                }
+                //noinspection ResultOfMethodCallIgnored
+                target.getParentFile().mkdirs();
+                try (InputStream in = zip.getInputStream(entry); OutputStream out = new FileOutputStream(target)) {
+                    copy(in, out);
+                }
+            }
+            //noinspection ResultOfMethodCallIgnored
+            new File(destination, "saves").mkdirs();
+
+            String key = LauncherProfiles.getFreeProfileKey();
+            LauncherProfiles.mainProfileJson.profiles.put(key, profile);
+            LauncherProfiles.write();
+            LauncherPreferences.DEFAULT_PREF.edit()
+                    .putString(LauncherPreferences.PREF_KEY_CURRENT_PROFILE, key).apply();
+
+            boolean installed = new File(Tools.DIR_HOME_VERSION + "/" + profile.lastVersionId
+                    + "/" + profile.lastVersionId + ".json").exists();
+            return new Imported(key, name, profile.lastVersionId, installed);
+        }
+    }
+
+    private static void copy(InputStream in, OutputStream out) throws IOException {
+        byte[] buffer = new byte[8192];
+        int read;
+        while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+    }
+}
