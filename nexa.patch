+package net.kdt.pojavlaunch.modloaders.modpacks.api;
+
+import com.kdt.mcgui.ProgressLayout;
+
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.modloaders.modpacks.models.ModDetail;
+import net.kdt.pojavlaunch.progresskeeper.DownloaderProgressWrapper;
+import net.kdt.pojavlaunch.utils.DownloadUtils;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+
+import java.io.File;
+import java.io.IOException;
+import java.net.URLDecoder;
+import java.util.concurrent.Callable;
+
+/**
+ * Installs a single mod (.jar) into the "mods" folder of the currently selected profile.
+ */
+public class ModInstaller {
+
+    public static void installSingleMod(ModDetail modDetail, int selectedVersion) throws IOException {
+        String url = modDetail.versionUrls[selectedVersion];
+        if (url == null) throw new IOException("This mod version has no download link");
+        String hash = modDetail.versionHashes[selectedVersion];
+
+        File modsDir = new File(Tools.getGameDirPath(LauncherProfiles.getCurrentProfile()), "mods");
+        File target = new File(modsDir, fileNameFromUrl(url));
+
+        try {
+            byte[] buffer = new byte[8192];
+            DownloadUtils.ensureSha1(target, hash, (Callable<Void>) () -> {
+                DownloadUtils.downloadFileMonitored(url, target, buffer,
+                        new DownloaderProgressWrapper(R.string.mod_download_downloading,
+                                ProgressLayout.INSTALL_MODPACK));
+                return null;
+            });
+        } finally {
+            ProgressLayout.clearProgress(ProgressLayout.INSTALL_MODPACK);
+        }
+    }
+
+    static String fileNameFromUrl(String url) {
+        String clean = url;
+        int query = clean.indexOf('?');
+        if (query != -1) clean = clean.substring(0, query);
+        clean = clean.substring(clean.lastIndexOf('/') + 1);
+        try {
+            clean = URLDecoder.decode(clean.replace("+", "%2B"), "UTF-8");
+        } catch (Exception ignored) { }
+        clean = clean.replaceAll("[\\\\/:*?\"<>|]", "_").trim();
+        if (clean.isEmpty()) clean = "mod.jar";
+        return clean;
+    }
+}
