@@ -0,0 +1,213 @@
+package net.kdt.pojavlaunch.nexa;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.SystemClock;
+import android.view.ViewGroup;
+
+import androidx.annotation.NonNull;
+import androidx.preference.PreferenceManager;
+
+import net.kdt.pojavlaunch.LwjglGlfwKeycode;
+import net.kdt.pojavlaunch.Tools;
+
+import org.lwjgl.glfw.CallbackBridge;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.io.IOException;
+import java.util.ArrayDeque;
+
+/**
+ * Nexa Client: the in-game floating menu, the HUD (FPS, CPS, keystrokes) and the toggle sprint /
+ * sneak helpers. This class holds the shared state; {@link CallbackBridge} reports every key and
+ * mouse event here, so CPS, keystrokes and the toggles work for touch controls too.
+ */
+public final class NexaClient {
+    public static final String PREF_SAFE_MODE = "nexa_safe_mode";
+    public static final String PREF_ENABLED = "nexa_client_enabled";
+    public static final String PREF_FPS = "nexa_mod_fps";
+    public static final String PREF_CPS = "nexa_mod_cps";
+    public static final String PREF_KEYSTROKES = "nexa_mod_keystrokes";
+    public static final String PREF_TOGGLE_SPRINT = "nexa_mod_togglesprint";
+    public static final String PREF_TOGGLE_SNEAK = "nexa_mod_togglesneak";
+
+    private static final String FPS_FILE = "nexa_fps.txt";
+    private static final int KEY_COUNT = 400;
+    private static final long CPS_WINDOW_MS = 1000;
+
+    private static final Object LOCK = new Object();
+    private static final boolean[] sKeyDown = new boolean[KEY_COUNT];
+    private static final ArrayDeque<Long> sLeftClicks = new ArrayDeque<>();
+    private static final ArrayDeque<Long> sRightClicks = new ArrayDeque<>();
+    private static boolean sLeftDown = false;
+    private static boolean sRightDown = false;
+    private static boolean sSprintHeld = false;
+    private static boolean sSneakHeld = false;
+    /** False in safe mode: the hooks then pass every event through untouched */
+    private static volatile boolean sActive = true;
+    private static volatile boolean sSprintEnabled = false;
+    private static volatile boolean sSneakEnabled = false;
+
+    private NexaClient() {}
+
+    public static boolean isSafeMode(@NonNull Context context) {
+        return prefs(context).getBoolean(PREF_SAFE_MODE, false);
+    }
+
+    public static SharedPreferences prefs(@NonNull Context context) {
+        return PreferenceManager.getDefaultSharedPreferences(context.getApplicationContext());
+    }
+
+    /** Called by MainActivity once the game layout exists */
+    public static void attach(@NonNull Activity activity, @NonNull ViewGroup parent) {
+        // Safe mode: none of the Nexa additions run in the game (for finding the cause of a crash)
+        sActive = !isSafeMode(activity);
+        if (!sActive) return;
+        synchronized (LOCK) {
+            sSprintHeld = false;
+            sSneakHeld = false;
+        }
+        reloadFlags(activity);
+        startPlayTimeCounter(activity);
+        NexaClientUi.install(activity, parent);
+    }
+
+    /** Adds a minute of play time to the selected profile every minute the game is on the screen */
+    private static void startPlayTimeCounter(@NonNull final Activity activity) {
+        final String profileKey = net.kdt.pojavlaunch.prefs.LauncherPreferences.DEFAULT_PREF.getString(
+                net.kdt.pojavlaunch.prefs.LauncherPreferences.PREF_KEY_CURRENT_PROFILE, "");
+        if (profileKey == null || profileKey.isEmpty()) return;
+        final android.os.Handler handler = new android.os.Handler(android.os.Looper.getMainLooper());
+        handler.postDelayed(new Runnable() {
+            @Override
+            public void run() {
+                if (activity.isFinishing() || activity.isDestroyed()) return;
+                boolean onScreen = !(activity instanceof androidx.lifecycle.LifecycleOwner)
+                        || ((androidx.lifecycle.LifecycleOwner) activity).getLifecycle().getCurrentState()
+                        .isAtLeast(androidx.lifecycle.Lifecycle.State.RESUMED);
+                if (onScreen) PlayStats.addSeconds(activity, profileKey, 60);
+                handler.postDelayed(this, 60000);
+            }
+        }, 60000);
+    }
+
+    /** Reads the toggle preferences. A toggle that gets turned off while active is released. */
+    public static void reloadFlags(@NonNull Context context) {
+        SharedPreferences prefs = prefs(context);
+        boolean sprint = prefs.getBoolean(PREF_TOGGLE_SPRINT, false);
+        boolean sneak = prefs.getBoolean(PREF_TOGGLE_SNEAK, false);
+        boolean releaseSprint;
+        boolean releaseSneak;
+        synchronized (LOCK) {
+            releaseSprint = !sprint && sSprintHeld;
+            releaseSneak = !sneak && sSneakHeld;
+            if (releaseSprint) sSprintHeld = false;
+            if (releaseSneak) sSneakHeld = false;
+        }
+        sSprintEnabled = sprint;
+        sSneakEnabled = sneak;
+        // The flags are already off here, so these releases pass through the filter untouched
+        if (releaseSprint) CallbackBridge.sendKeycode(LwjglGlfwKeycode.GLFW_KEY_LEFT_CONTROL, '\u0000', 0, 0, false);
+        if (releaseSneak) CallbackBridge.sendKeycode(LwjglGlfwKeycode.GLFW_KEY_LEFT_SHIFT, '\u0000', 0, 0, false);
+    }
+
+    // ---- Hooks called by CallbackBridge --------------------------------------------------------
+
+    /**
+     * @return 1 to send the key as pressed, 0 to send it as released, -1 to drop the event.
+     * With a toggle enabled, one press of sprint/sneak keeps the key held until the next press.
+     */
+    public static int filterKey(int keycode, boolean isDown) {
+        if (!sActive) return isDown ? 1 : 0;
+        synchronized (LOCK) {
+            if (keycode == LwjglGlfwKeycode.GLFW_KEY_LEFT_CONTROL && sSprintEnabled) {
+                if (!isDown) return -1;
+                sSprintHeld = !sSprintHeld;
+                setKey(keycode, sSprintHeld);
+                return sSprintHeld ? 1 : 0;
+            }
+            if (keycode == LwjglGlfwKeycode.GLFW_KEY_LEFT_SHIFT && sSneakEnabled) {
+                if (!isDown) return -1;
+                sSneakHeld = !sSneakHeld;
+                setKey(keycode, sSneakHeld);
+                return sSneakHeld ? 1 : 0;
+            }
+            setKey(keycode, isDown);
+            return isDown ? 1 : 0;
+        }
+    }
+
+    public static void onMouse(int button, boolean isDown) {
+        if (!sActive) return;
+        long now = SystemClock.uptimeMillis();
+        synchronized (LOCK) {
+            if (button == LwjglGlfwKeycode.GLFW_MOUSE_BUTTON_LEFT) {
+                sLeftDown = isDown;
+                if (isDown) sLeftClicks.addLast(now);
+            } else if (button == LwjglGlfwKeycode.GLFW_MOUSE_BUTTON_RIGHT) {
+                sRightDown = isDown;
+                if (isDown) sRightClicks.addLast(now);
+            }
+        }
+    }
+
+    private static void setKey(int keycode, boolean down) {
+        if (keycode >= 0 && keycode < KEY_COUNT) sKeyDown[keycode] = down;
+    }
+
+    // ---- State read by the HUD -----------------------------------------------------------------
+
+    public static boolean isKeyDown(int keycode) {
+        synchronized (LOCK) {
+            return keycode >= 0 && keycode < KEY_COUNT && sKeyDown[keycode];
+        }
+    }
+
+    public static boolean isMouseDown(boolean left) {
+        synchronized (LOCK) {
+            return left ? sLeftDown : sRightDown;
+        }
+    }
+
+    public static int getCps(boolean left) {
+        long now = SystemClock.uptimeMillis();
+        synchronized (LOCK) {
+            ArrayDeque<Long> clicks = left ? sLeftClicks : sRightClicks;
+            while (!clicks.isEmpty() && now - clicks.peekFirst() > CPS_WINDOW_MS) clicks.pollFirst();
+            return clicks.size();
+        }
+    }
+
+    /**
+     * The game's own frame rate. The Java side of the GLFW bridge writes it once per second, because
+     * only it sees the real buffer swaps.
+     * @return -1 when it is not available (game not started yet, or the file is stale)
+     */
+    public static int readFps() {
+        File file = new File(Tools.DIR_GAME_HOME, FPS_FILE);
+        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
+            String line = reader.readLine();
+            if (line == null) return -1;
+            String[] parts = line.split(";");
+            if (parts.length < 2) return -1;
+            long timestamp = Long.parseLong(parts[1].trim());
+            if (System.currentTimeMillis() - timestamp > 3500) return -1;
+            return Integer.parseInt(parts[0].trim());
+        } catch (IOException | RuntimeException e) {
+            return -1;
+        }
+    }
+
+    /** Forgets the saved positions of the HUD widgets and of the floating circle */
+    public static void resetHudPositions(@NonNull Context context) {
+        SharedPreferences.Editor editor = prefs(context).edit();
+        for (String id : NexaHudView.IDS) {
+            editor.remove(NexaHudView.xKey(id)).remove(NexaHudView.yKey(id));
+        }
+        editor.remove("nexa_bubble_fx").remove("nexa_bubble_fy");
+        editor.apply();
+    }
+}
