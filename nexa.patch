+package net.kdt.pojavlaunch.nexa;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.widget.EditText;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.extra.ExtraConstants;
+import net.kdt.pojavlaunch.extra.ExtraCore;
+import net.kdt.pojavlaunch.prefs.LauncherPreferences;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+
+/**
+ * Copies the selected profile into a new one with its own game folder. The mods, config,
+ * resource packs, shader packs and options are copied; worlds are not (they can be large).
+ * Handy to try a different mod set without touching the working one.
+ */
+public final class ProfileCloner {
+    /** Only these entries of the game folder are copied */
+    private static final String[] COPIED = {
+            "mods", "config", "resourcepacks", "shaderpacks", "options.txt", "optionsof.txt", "servers.dat"
+    };
+
+    private ProfileCloner() {}
+
+    /** Asks for a name, then clones the selected profile in the background */
+    public static void promptAndClone(@NonNull Activity activity) {
+        final MinecraftProfile source;
+        try {
+            source = LauncherProfiles.getCurrentProfile();
+        } catch (RuntimeException e) {
+            Toast.makeText(activity, R.string.nexa_clone_no_profile, Toast.LENGTH_LONG).show();
+            return;
+        }
+        final EditText input = new EditText(activity);
+        input.setSingleLine(true);
+        input.setText(((source.name == null || source.name.isEmpty()) ? "Profile" : source.name) + " copy");
+        new AlertDialog.Builder(activity)
+                .setTitle(R.string.nexa_clone_title)
+                .setMessage(R.string.nexa_clone_note)
+                .setView(input)
+                .setPositiveButton(android.R.string.ok, (dialog, which) -> {
+                    String name = input.getText().toString().trim();
+                    if (name.isEmpty()) {
+                        Toast.makeText(activity, R.string.cp_need_name, Toast.LENGTH_SHORT).show();
+                        return;
+                    }
+                    startClone(activity.getApplicationContext(), source, name);
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void startClone(final Context context, final MinecraftProfile source, final String name) {
+        Toast.makeText(context, R.string.nexa_clone_working, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            try {
+                String key = clone(source, name);
+                Tools.runOnUiThread(() -> ExtraCore.setValue(ExtraConstants.REFRESH_VERSION_SPINNER, key));
+                message = context.getString(R.string.nexa_clone_done, name);
+            } catch (IOException | RuntimeException e) {
+                e.printStackTrace();
+                message = context.getString(R.string.nexa_clone_failed, String.valueOf(e.getMessage()));
+            }
+            final String finalMessage = message;
+            Tools.runOnUiThread(() -> Toast.makeText(context, finalMessage, Toast.LENGTH_LONG).show());
+        });
+    }
+
+    /** @return the key of the new profile, which is also selected */
+    static String clone(MinecraftProfile source, String name) throws IOException {
+        if (LauncherProfiles.mainProfileJson == null) LauncherProfiles.load();
+
+        // A copy through Gson keeps every setting of the profile (version, Java, renderer, ...)
+        MinecraftProfile copy = Tools.GLOBAL_GSON.fromJson(Tools.GLOBAL_GSON.toJson(source), MinecraftProfile.class);
+        copy.name = name;
+        copy.gameDir = "./custom_instances/" + freeFolderName(name);
+
+        File fromDir = Tools.getGameDirPath(source);
+        File toDir = Tools.getGameDirPath(copy);
+        //noinspection ResultOfMethodCallIgnored
+        toDir.mkdirs();
+        for (String entry : COPIED) {
+            File from = new File(fromDir, entry);
+            if (from.exists()) copyRecursive(from, new File(toDir, entry));
+        }
+        // The game expects these to exist
+        //noinspection ResultOfMethodCallIgnored
+        new File(toDir, "mods").mkdirs();
+        //noinspection ResultOfMethodCallIgnored
+        new File(toDir, "saves").mkdirs();
+
+        String key = LauncherProfiles.getFreeProfileKey();
+        LauncherProfiles.mainProfileJson.profiles.put(key, copy);
+        LauncherProfiles.write();
+        LauncherPreferences.DEFAULT_PREF.edit()
+                .putString(LauncherPreferences.PREF_KEY_CURRENT_PROFILE, key).apply();
+        return key;
+    }
+
+    static String freeFolderName(String name) {
+        String base = name.replaceAll("[^A-Za-z0-9._-]+", "_");
+        if (base.isEmpty() || base.replace("_", "").isEmpty()) base = "profile";
+        File parent = new File(Tools.DIR_GAME_HOME, "custom_instances");
+        String candidate = base;
+        int i = 2;
+        while (new File(parent, candidate).exists()) candidate = base + "_" + i++;
+        return candidate;
+    }
+
+    private static void copyRecursive(File from, File to) throws IOException {
+        if (from.isDirectory()) {
+            //noinspection ResultOfMethodCallIgnored
+            to.mkdirs();
+            File[] children = from.listFiles();
+            if (children == null) return;
+            for (File child : children) copyRecursive(child, new File(to, child.getName()));
+            return;
+        }
+        byte[] buffer = new byte[8192];
+        try (InputStream in = new FileInputStream(from); OutputStream out = new FileOutputStream(to)) {
+            int read;
+            while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+        }
+    }
+}
diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/ProfilePorter.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/ProfilePorter.java
