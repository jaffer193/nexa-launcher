+import net.kdt.pojavlaunch.modloaders.NeoForgeUtils;
+
+import java.io.IOException;
+import java.util.List;
+
+/** NeoForge version picker, with the same look as the Fabric and Quilt ones */
+public class NeoForgeInstallFragment extends ForgeLikeInstallFragment {
+    public static final String TAG = "NeoForgeInstallFragment";
+
+    public NeoForgeInstallFragment() {
+        super("NeoForge", TAG, R.string.neoforge_dl_select_version, true);
+    }
+
+    @Override
+    protected @Nullable List<String> downloadVersions() throws IOException {
+        return NeoForgeUtils.downloadNeoForgeVersions();
+    }
+
+    /** NeoForge versions look like 21.1.172, for Minecraft 1.21.1 */
+    @Override
+    protected @Nullable String gameVersionOf(String loaderVersion) {
+        return NeoForgeUtils.toMinecraftVersion(loaderVersion);
+    }
+
+    @Override
+    protected String labelOf(String loaderVersion, String gameVersion) {
+        return loaderVersion;
+    }
+
+    @Override
+    protected boolean isStable(String loaderVersion) {
+        String lower = loaderVersion.toLowerCase();
+        return !(lower.contains("beta") || lower.contains("alpha") || lower.contains("snapshot"));
+    }
+
+    @Override
+    protected Runnable createDownloadTask(ModloaderListenerProxy proxy, String loaderVersion) {
+        return new NeoForgeDownloadTask(proxy, loaderVersion);
+    }
+}
