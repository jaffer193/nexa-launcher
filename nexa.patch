+
+    // Nexa Client: counts the real frames of the game and writes the result once per second,
+    // so the launcher can show the FPS in its HUD
+    private static final boolean sNexaFpsEnabled = System.getProperty("nexa.fps") != null;
+    private static int sNexaFrames = 0;
+    private static long sNexaLastReport = 0;
+
+    private static void nexaCountFrame() {
+        if (!sNexaFpsEnabled) return;
+        sNexaFrames++;
+        long now = System.currentTimeMillis();
+        if (sNexaLastReport == 0) {
+            sNexaLastReport = now;
+            return;
+        }
+        long elapsed = now - sNexaLastReport;
+        if (elapsed < 1000) return;
+        int fps = Math.round(sNexaFrames * 1000f / elapsed);
+        sNexaFrames = 0;
+        sNexaLastReport = now;
+        try (java.io.FileOutputStream out = new java.io.FileOutputStream(System.getProperty("user.home") + "/nexa_fps.txt")) {
+            out.write((fps + ";" + now).getBytes());
+        } catch (Throwable ignored) {
+        }
     }
 
