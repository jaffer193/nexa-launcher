+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/NexaSplash.java
@@ -0,0 +1,155 @@
+package net.kdt.pojavlaunch;
+
+import android.animation.ObjectAnimator;
+import android.app.Activity;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.animation.AccelerateDecelerateInterpolator;
+import android.view.animation.DecelerateInterpolator;
+import android.view.animation.LinearInterpolator;
+import android.view.animation.OvershootInterpolator;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import net.kdt.pojavlaunch.nexa.NexaTheme;
+
+/** Short animated intro shown on top of the launcher when the app starts. */
+public final class NexaSplash {
+    private static final long SHOW_TIME_MS = 1900;
+    private static final long FADE_OUT_MS = 380;
+    private static boolean sShown = false;
+
+    private NexaSplash() {}
+
+    /** Shows the intro once per app process. Touches are blocked until it ends. */
+    public static void show(Activity activity) {
+        if (sShown) return;
+        sShown = true;
+
+        final ViewGroup root = activity.findViewById(android.R.id.content);
+        if (root == null) return;
+        final float density = activity.getResources().getDisplayMetrics().density;
+
+        final FrameLayout overlay = new FrameLayout(activity);
+        overlay.setBackgroundColor(activity.getResources().getColor(R.color.background_app));
+        overlay.setClickable(true);
+        overlay.setFocusable(true);
+        overlay.setElevation(1000 * density);
+
+        LinearLayout column = new LinearLayout(activity);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setGravity(Gravity.CENTER);
+        overlay.addView(column, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER));
+
+        // Logo with a soft glow behind it
+        FrameLayout logoHolder = new FrameLayout(activity);
+        column.addView(logoHolder, new LinearLayout.LayoutParams((int) (190 * density), (int) (190 * density)));
+
+        final View glow = new View(activity);
+        GradientDrawable glowDrawable = new GradientDrawable();
+        glowDrawable.setGradientType(GradientDrawable.RADIAL_GRADIENT);
+        glowDrawable.setGradientRadius(95 * density);
+        final int accent = NexaTheme.accentStart(activity);
+        glowDrawable.setColors(new int[]{
+                Color.argb(120, Color.red(accent), Color.green(accent), Color.blue(accent)),
+                Color.argb(0, Color.red(accent), Color.green(accent), Color.blue(accent))});
+        glow.setBackground(glowDrawable);
+        glow.setAlpha(0f);
+        logoHolder.addView(glow, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        final ImageView logo = new ImageView(activity);
+        NexaTheme.applyLogo(activity, logo);
+        logo.setAlpha(0f);
+        logo.setScaleX(0.5f);
+        logo.setScaleY(0.5f);
+        logoHolder.addView(logo, new FrameLayout.LayoutParams(
+                (int) (112 * density), (int) (112 * density), Gravity.CENTER));
+
+        // Title and subtitle
+        final TextView title = new TextView(activity);
+        title.setText(NexaTheme.title(activity).toUpperCase());
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 34);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        title.setLetterSpacing(0.3f);
+        title.setGravity(Gravity.CENTER);
+        title.setAlpha(0f);
+        title.setTranslationY(24 * density);
+        column.addView(title, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        final TextView subtitle = new TextView(activity);
+        subtitle.setText("LAUNCHER");
+        subtitle.setTextColor(activity.getResources().getColor(R.color.secondary_text));
+        subtitle.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
+        subtitle.setLetterSpacing(0.5f);
+        subtitle.setGravity(Gravity.CENTER);
+        subtitle.setAlpha(0f);
+        subtitle.setTranslationY(16 * density);
+        LinearLayout.LayoutParams subParams = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        subParams.topMargin = (int) (4 * density);
+        column.addView(subtitle, subParams);
+
+        // Loading bar
+        FrameLayout barTrack = new FrameLayout(activity);
+        GradientDrawable trackDrawable = new GradientDrawable();
+        trackDrawable.setColor(activity.getResources().getColor(R.color.background_disabled));
+        trackDrawable.setCornerRadius(3 * density);
+        barTrack.setBackground(trackDrawable);
+        LinearLayout.LayoutParams barParams = new LinearLayout.LayoutParams((int) (170 * density), (int) (4 * density));
+        barParams.topMargin = (int) (34 * density);
+        column.addView(barTrack, barParams);
+
+        final View barFill = new View(activity);
+        GradientDrawable fillDrawable = new GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,
+                new int[]{NexaTheme.accentStart(activity), NexaTheme.accentEnd(activity)});
+        fillDrawable.setCornerRadius(3 * density);
+        barFill.setBackground(fillDrawable);
+        barFill.setPivotX(0f);
+        barFill.setScaleX(0f);
+        barTrack.addView(barFill, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        root.addView(overlay, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        // Animations
+        logo.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(650)
+                .setInterpolator(new OvershootInterpolator(1.4f)).start();
+        glow.animate().alpha(1f).setDuration(900).start();
+        final ObjectAnimator pulseX = ObjectAnimator.ofFloat(glow, View.SCALE_X, 0.9f, 1.15f);
+        final ObjectAnimator pulseY = ObjectAnimator.ofFloat(glow, View.SCALE_Y, 0.9f, 1.15f);
+        for (ObjectAnimator pulse : new ObjectAnimator[]{pulseX, pulseY}) {
+            pulse.setDuration(900);
+            pulse.setRepeatCount(ObjectAnimator.INFINITE);
+            pulse.setRepeatMode(ObjectAnimator.REVERSE);
+            pulse.setInterpolator(new AccelerateDecelerateInterpolator());
+            pulse.start();
+        }
+        title.animate().alpha(1f).translationY(0f).setStartDelay(350).setDuration(500)
+                .setInterpolator(new DecelerateInterpolator()).start();
+        subtitle.animate().alpha(1f).translationY(0f).setStartDelay(520).setDuration(500)
+                .setInterpolator(new DecelerateInterpolator()).start();
+        barFill.animate().scaleX(1f).setStartDelay(500).setDuration(1250)
+                .setInterpolator(new LinearInterpolator()).start();
+
+        new Handler(Looper.getMainLooper()).postDelayed(() ->
+                overlay.animate().alpha(0f).setDuration(FADE_OUT_MS).withEndAction(() -> {
+                    pulseX.cancel();
+                    pulseY.cancel();
+                    root.removeView(overlay);
+                }).start(), SHOW_TIME_MS);
+    }
+}
