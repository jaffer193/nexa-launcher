new file mode 100644
index 0000000..6940443
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/ResourcePackManager.java
@@ -0,0 +1,125 @@
+package net.kdt.pojavlaunch.modloaders.modpacks.api;
+
+import androidx.annotation.NonNull;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Lists the packs in the "resourcepacks" folder of a game directory and keeps the
+ * "resourcePacks" line of options.txt in sync, which is where Minecraft stores the enabled packs.
+ */
+public final class ResourcePackManager {
+    private static final String OPTION_KEY = "resourcePacks:";
+
+    private ResourcePackManager() {}
+
+    public static @NonNull File getPackDir(@NonNull File gameDir) {
+        return new File(gameDir, "resourcepacks");
+    }
+
+    public static @NonNull List<String> listPacks(@NonNull File gameDir) {
+        File[] files = getPackDir(gameDir).listFiles();
+        List<String> names = new ArrayList<>();
+        if (files == null) return names;
+        for (File file : files) {
+            String name = file.getName();
+            if (file.isDirectory() || name.toLowerCase().endsWith(".zip")) names.add(name);
+        }
+        Collections.sort(names, String.CASE_INSENSITIVE_ORDER);
+        return names;
+    }
+
+    /** Names (without the "file/" prefix) of the enabled packs */
+    public static @NonNull List<String> readEnabled(@NonNull File gameDir) {
+        List<String> enabled = new ArrayList<>();
+        try {
+            for (String line : readLines(new File(gameDir, "options.txt"))) {
+                if (!line.startsWith(OPTION_KEY)) continue;
+                String body = line.substring(OPTION_KEY.length()).trim();
+                if (body.startsWith("[")) body = body.substring(1);
+                if (body.endsWith("]")) body = body.substring(0, body.length() - 1);
+                for (String entry : body.split(",")) {
+                    String value = entry.trim();
+                    if (value.startsWith("\"")) value = value.substring(1);
+                    if (value.endsWith("\"")) value = value.substring(0, value.length() - 1);
+                    if (value.startsWith("file/")) enabled.add(value.substring(5));
+                }
+            }
+        } catch (IOException ignored) { }
+        return enabled;
+    }
+
+    public static void setEnabled(@NonNull File gameDir, @NonNull String packName, boolean enable)
+            throws IOException {
+        File optionsFile = new File(gameDir, "options.txt");
+        List<String> lines = readLines(optionsFile);
+
+        List<String> entries = new ArrayList<>();
+        int lineIndex = -1;
+        for (int i = 0; i < lines.size(); i++) {
+            String line = lines.get(i);
+            if (!line.startsWith(OPTION_KEY)) continue;
+            lineIndex = i;
+            String body = line.substring(OPTION_KEY.length()).trim();
+            if (body.startsWith("[")) body = body.substring(1);
+            if (body.endsWith("]")) body = body.substring(0, body.length() - 1);
+            if (!body.trim().isEmpty()) entries.addAll(Arrays.asList(body.split(",")));
+        }
+
+        String target = "\"file/" + packName + "\"";
+        List<String> cleaned = new ArrayList<>();
+        for (String entry : entries) {
+            String trimmed = entry.trim();
+            if (!trimmed.equals(target)) cleaned.add(trimmed);
+        }
+        if (enable) cleaned.add(target);
+
+        StringBuilder newLine = new StringBuilder(OPTION_KEY).append('[');
+        for (int i = 0; i < cleaned.size(); i++) {
+            if (i > 0) newLine.append(',');
+            newLine.append(cleaned.get(i));
+        }
+        newLine.append(']');
+
+        if (lineIndex >= 0) lines.set(lineIndex, newLine.toString());
+        else lines.add(newLine.toString());
+
+        gameDir.mkdirs();
+        try (Writer writer = new OutputStreamWriter(new FileOutputStream(optionsFile), StandardCharsets.UTF_8)) {
+            for (String line : lines) writer.write(line + "\n");
+        }
+    }
+
+    public static void delete(@NonNull File gameDir, @NonNull String packName) throws IOException {
+        setEnabled(gameDir, packName, false);
+        File pack = new File(getPackDir(gameDir), packName);
+        if (pack.isDirectory()) {
+            File[] children = pack.listFiles();
+            if (children != null) for (File child : children) child.delete();
+        }
+        pack.delete();
+    }
+
+    private static @NonNull List<String> readLines(File file) throws IOException {
+        List<String> lines = new ArrayList<>();
+        if (!file.exists()) return lines;
+        try (BufferedReader reader = new BufferedReader(
+                new InputStreamReader(new FileInputStream(file), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) lines.add(line);
+        }
+        return lines;
+    }
+}
