+package net.kdt.pojavlaunch.authenticator.elyby;
+
+import static net.kdt.pojavlaunch.PojavApplication.sExecutorService;
+
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.authenticator.listener.DoneListener;
+import net.kdt.pojavlaunch.authenticator.listener.ErrorListener;
+import net.kdt.pojavlaunch.authenticator.listener.ProgressListener;
+import net.kdt.pojavlaunch.value.MinecraftAccount;
+
+import java.io.IOException;
+
+/** Checks the token of a saved Ely.by account in the background and refreshes it if needed */
+public class ElyByBackgroundLogin {
+    private final MinecraftAccount mAccount;
+
+    public ElyByBackgroundLogin(@NonNull MinecraftAccount account) {
+        mAccount = account;
+    }
+
+    /** The done listener is only called when the token had to be renewed */
+    public void performLogin(@Nullable final ProgressListener progressListener,
+                             @Nullable final DoneListener doneListener,
+                             @Nullable final ErrorListener errorListener) {
+        sExecutorService.execute(() -> {
+            try {
+                notifyProgress(progressListener, 1);
+                boolean valid;
+                try {
+                    valid = ElyByAuth.validate(mAccount);
+                } catch (IOException e) {
+                    // Offline: keep the account as it is, the game can still be started
+                    Log.w("ElyByAuth", "Could not check the token", e);
+                    notifyProgress(progressListener, 5);
+                    return;
+                }
+                if (!valid) {
+                    notifyProgress(progressListener, 3);
+                    ElyByAuth.refresh(mAccount);
+                    mAccount.save();
+                    notifyProgress(progressListener, 5);
+                    if (doneListener != null) {
+                        Tools.runOnUiThread(() -> doneListener.onLoginDone(mAccount));
+                    }
+                } else {
+                    notifyProgress(progressListener, 5);
+                }
+            } catch (Exception e) {
+                Log.e("ElyByAuth", "Exception thrown during authentication", e);
+                if (errorListener != null) {
+                    Tools.runOnUiThread(() -> errorListener.onLoginError(e));
+                }
+            }
+        });
+    }
+
+    private static void notifyProgress(@Nullable ProgressListener listener, int step) {
+        if (listener != null) Tools.runOnUiThread(() -> listener.onLoginProgress(step));
+    }
+}
