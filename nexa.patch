+package net.kdt.pojavlaunch.authenticator.elyby;
+
+import android.content.Context;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.value.MinecraftAccount;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+
+/**
+ * Minimal client for the Ely.by authentication server (Yggdrasil protocol).
+ * The password is only sent to Ely.by and is never stored: only the access token is kept.
+ */
+public final class ElyByAuth {
+    private static final String AUTH_URL = "https://authserver.ely.by/auth";
+    /** Asset that is downloaded by the build workflow */
+    private static final String INJECTOR_ASSET = "authlib-injector/authlib-injector.jar";
+    private static final int TIMEOUT_MS = 15000;
+
+    private ElyByAuth() {}
+
+    /** Error reported by the Ely.by server (or a malformed answer) */
+    public static class ElyByException extends Exception {
+        /** True when the account has two-factor authentication and no code was given */
+        public final boolean twoFactorRequired;
+
+        public ElyByException(String message, boolean twoFactorRequired) {
+            super(message);
+            this.twoFactorRequired = twoFactorRequired;
+        }
+    }
+
+    /**
+     * Logs in with the Ely.by username/email and password.
+     * @param twoFactorCode optional, only for accounts with two-factor authentication
+     * @return an unsaved account, flagged as an Ely.by account
+     */
+    public static @NonNull MinecraftAccount login(@NonNull String user, @NonNull String password,
+                                                  @Nullable String twoFactorCode)
+            throws IOException, ElyByException {
+        String fullPassword = (twoFactorCode == null || twoFactorCode.isEmpty())
+                ? password : password + ":" + twoFactorCode;
+
+        JsonObject body = new JsonObject();
+        body.addProperty("username", user);
+        body.addProperty("password", fullPassword);
+        body.addProperty("clientToken", UUID.randomUUID().toString().replace("-", ""));
+        body.addProperty("requestUser", true);
+
+        JsonObject answer = post("/authenticate", body);
+        MinecraftAccount account = new MinecraftAccount();
+        account.isElyBy = true;
+        applyAnswer(account, answer, true);
+        return account;
+    }
+
+    /** @return true if the server still accepts the token. Throws IOException when offline */
+    public static boolean validate(@NonNull MinecraftAccount account) throws IOException {
+        JsonObject body = new JsonObject();
+        body.addProperty("accessToken", account.accessToken);
+        try {
+            post("/validate", body);
+            return true;
+        } catch (ElyByException e) {
+            return false;
+        }
+    }
+
+    /** Gets a new access token with the stored one. Throws when the user must log in again */
+    public static void refresh(@NonNull MinecraftAccount account) throws IOException, ElyByException {
+        JsonObject body = new JsonObject();
+        body.addProperty("accessToken", account.accessToken);
+        body.addProperty("clientToken", account.clientToken);
+        body.addProperty("requestUser", true);
+        applyAnswer(account, post("/refresh", body), false);
+    }
+
+    /**
+     * Copies authlib-injector out of the APK so that it can be passed to the JVM.
+     * @return absolute path of the jar
+     */
+    public static @NonNull String prepareInjector(@NonNull Context context) throws IOException {
+        File dir = new File(Tools.DIR_DATA, "authlib-injector");
+        try {
+            Tools.copyAssetFile(context, INJECTOR_ASSET, dir.getAbsolutePath(), true);
+        } catch (IOException e) {
+            throw new IOException("authlib-injector is missing from this build, Ely.by accounts cannot be used", e);
+        }
+        return new File(dir, "authlib-injector.jar").getAbsolutePath();
+    }
+
+    private static void applyAnswer(MinecraftAccount account, JsonObject answer, boolean requireProfile)
+            throws ElyByException {
+        if (!answer.has("accessToken") || !answer.has("clientToken")) {
+            throw new ElyByException("Unexpected answer from Ely.by", false);
+        }
+        account.accessToken = answer.get("accessToken").getAsString();
+        account.clientToken = answer.get("clientToken").getAsString();
+
+        JsonObject profile = null;
+        if (answer.has("selectedProfile") && answer.get("selectedProfile").isJsonObject()) {
+            profile = answer.getAsJsonObject("selectedProfile");
+        } else if (answer.has("availableProfiles") && answer.get("availableProfiles").isJsonArray()) {
+            JsonArray profiles = answer.getAsJsonArray("availableProfiles");
+            if (profiles.size() > 0) profile = profiles.get(0).getAsJsonObject();
+        }
+        if (profile != null) {
+            account.profileId = profile.get("id").getAsString();
+            account.username = profile.get("name").getAsString();
+        } else if (requireProfile) {
+            throw new ElyByException("This Ely.by account has no Minecraft profile", false);
+        }
+        account.isElyBy = true;
+    }
+
+    private static JsonObject post(String endpoint, JsonObject body) throws IOException, ElyByException {
+        HttpURLConnection conn = (HttpURLConnection) new URL(AUTH_URL + endpoint).openConnection();
+        try {
+            conn.setRequestMethod("POST");
+            conn.setConnectTimeout(TIMEOUT_MS);
+            conn.setReadTimeout(TIMEOUT_MS);
+            conn.setDoOutput(true);
+            conn.setRequestProperty("Content-Type", "application/json; charset=utf-8");
+            conn.setRequestProperty("Accept", "application/json");
+            byte[] data = body.toString().getBytes(StandardCharsets.UTF_8);
+            try (OutputStream out = conn.getOutputStream()) {
+                out.write(data);
+            }
+
+            int code = conn.getResponseCode();
+            InputStream stream = code >= 400 ? conn.getErrorStream() : conn.getInputStream();
+            String text = stream == null ? "" : readAll(stream);
+
+            JsonObject json = null;
+            if (!text.trim().isEmpty()) {
+                try {
+                    JsonElement element = JsonParser.parseString(text);
+                    if (element.isJsonObject()) json = element.getAsJsonObject();
+                } catch (RuntimeException ignored) { }
+            }
+
+            if (code >= 500) {
+                // Server trouble is not a verdict on the account: report it as a network problem
+                throw new IOException("Ely.by is unavailable (" + code + ")");
+            }
+            if (code >= 400) {
+                String message = "Ely.by error (" + code + ")";
+                if (json != null && json.has("errorMessage") && !json.get("errorMessage").isJsonNull()) {
+                    message = json.get("errorMessage").getAsString();
+                }
+                boolean twoFactor = message.toLowerCase().contains("two factor")
+                        || message.toLowerCase().contains("two-factor");
+                throw new ElyByException(message, twoFactor);
+            }
+            // validate answers with an empty body, that is a success too
+            return json == null ? new JsonObject() : json;
+        } finally {
+            conn.disconnect();
+        }
+    }
+
+    private static String readAll(InputStream stream) throws IOException {
+        try (InputStream in = stream; ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[4096];
+            int read;
+            while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+            return out.toString("UTF-8");
+        }
+    }
+}
