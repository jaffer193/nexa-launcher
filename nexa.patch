+    /** Mod features: ENABLED means the jar is in the mods folder. Disabling renames it to .disabled */
+    private void toggleMod(Feature feature) {
+        File modsDir = getModsDir();
+        if (modsDir == null) {
+            toast(mActivity.getString(R.string.nexa_client_need_modded));
+            return;
+        }
+        String fileName = mPrefs.getString(modKey(feature, modsDir), null);
+        if (fileName != null) {
+            File enabled = new File(modsDir, fileName);
+            File disabled = new File(modsDir, fileName + ".disabled");
+            if (enabled.exists()) {
+                if (enabled.renameTo(disabled)) toast(mActivity.getString(R.string.nexa_client_mod_disabled, feature.name));
+                refreshCards();
+                return;
+            }
+            if (disabled.exists()) {
+                if (disabled.renameTo(enabled)) toast(mActivity.getString(R.string.nexa_client_mod_enabled, feature.name));
+                refreshCards();
+                return;
+            }
+        }
+        installMod(feature, modsDir);
+    }
