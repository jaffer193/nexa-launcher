@@ -315,6 +315,20 @@ public class JREUtils {
         userArgs.add("-XX:ActiveProcessorCount=" + java.lang.Runtime.getRuntime().availableProcessors());
 
         userArgs.addAll(JVMArgs);
+
+        // FPS Booster (Settings > Advanced): flags that reduce JVM overhead on phones
+        if (LauncherPreferences.DEFAULT_PREF.getBoolean(net.kdt.pojavlaunch.nexa.FpsBooster.PREF_JVM_FLAGS, false)) {
+            net.kdt.pojavlaunch.nexa.FpsBooster.addJvmFlags(userArgs);
+        }
+
+        // Ely.by accounts need authlib-injector to talk to the Ely.by session server
+        net.kdt.pojavlaunch.value.MinecraftAccount currentAccount =
+                net.kdt.pojavlaunch.PojavProfile.getCurrentProfileContent(activity, null);
+        // Only the game needs it: mod installers (gameDirectory == null) must not load the agent,
+        // it contacts the Ely.by server at startup and could stall the installer
+        if (gameDirectory != null && currentAccount != null && currentAccount.isElyBy) {
+            userArgs.add("-javaagent:" + net.kdt.pojavlaunch.authenticator.elyby.ElyByAuth.prepareInjector(activity) + "=ely.by");
+        }
         activity.runOnUiThread(() -> Toast.makeText(activity, activity.getString(R.string.autoram_info_msg,LauncherPreferences.PREF_RAM_ALLOCATION), Toast.LENGTH_SHORT).show());
         System.out.println(JVMArgs);
 
