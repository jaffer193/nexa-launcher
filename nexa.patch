+        net.kdt.pojavlaunch.nexa.NexaTheme.applyBackground(view);
+        ((TextView) view.findViewById(R.id.nl_title)).setText(R.string.nexa_ss_title);
+        mStatus = view.findViewById(R.id.nl_status);
+        view.findViewById(R.id.nl_actions).setVisibility(View.GONE);
+        ListView list = view.findViewById(R.id.nl_list);
+
+        mAdapter = new ArrayAdapter<File>(requireContext(), 0, mFiles) {
+            @NonNull
+            @Override
+            public View getView(int position, @Nullable View convertView, @NonNull ViewGroup parent) {
+                View row = convertView != null ? convertView
+                        : LayoutInflater.from(getContext()).inflate(R.layout.item_rp_hit, parent, false);
+                File file = getItem(position);
+                if (file == null) return row;
+                ((TextView) row.findViewById(R.id.rpb_item_title)).setText(file.getName());
+                ((TextView) row.findViewById(R.id.rpb_item_meta)).setText(
+                        DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT)
+                                .format(new Date(file.lastModified())));
+                row.findViewById(R.id.rpb_item_desc).setVisibility(View.GONE);
+                loadThumbnail((ImageView) row.findViewById(R.id.rpb_item_icon), file);
+                return row;
+            }
+        };
+        list.setAdapter(mAdapter);
+        list.setOnItemClickListener((parent, v, position, id) -> showFull(mFiles.get(position)));
+
+        try {
+            mDir = new File(Tools.getGameDirPath(LauncherProfiles.getCurrentProfile()), "screenshots");
+        } catch (RuntimeException e) {
+            mDir = null;
+        }
+        refresh();
+    }
+
+    private void refresh() {
+        mFiles.clear();
+        File[] files = mDir == null ? null : mDir.listFiles();
+        if (files != null) {
+            Arrays.sort(files, (a, b) -> Long.compare(b.lastModified(), a.lastModified())); // newest first
+            for (File file : files) {
+                String name = file.getName().toLowerCase(Locale.ROOT);
+                if (file.isFile() && (name.endsWith(".png") || name.endsWith(".jpg") || name.endsWith(".jpeg"))) mFiles.add(file);
+            }
+        }
+        mAdapter.notifyDataSetChanged();
+        mStatus.setText(mFiles.isEmpty() ? R.string.nexa_ss_empty : R.string.nexa_ss_hint);
+    }
+
+    private void loadThumbnail(final ImageView view, final File file) {
+        final String key = file.getAbsolutePath() + file.lastModified();
+        view.setTag(key);
+        view.setImageResource(R.drawable.ic_file);
+        Bitmap cached = sThumbnails.get(key);
+        if (cached != null) {
+            view.setImageBitmap(cached);
+            return;
+        }
+        PojavApplication.sExecutorService.execute(() -> {
+            final Bitmap bitmap = decode(file, 160);
+            if (bitmap == null) return;
+            sThumbnails.put(key, bitmap);
+            Tools.runOnUiThread(() -> {
+                if (key.equals(view.getTag())) view.setImageBitmap(bitmap);
+            });
+        });
+    }
+
+    /** Decodes a smaller version of the image so that big screenshots do not fill the memory */
+    private static @Nullable Bitmap decode(File file, int targetWidth) {
+        try {
+            BitmapFactory.Options bounds = new BitmapFactory.Options();
+            bounds.inJustDecodeBounds = true;
+            BitmapFactory.decodeFile(file.getAbsolutePath(), bounds);
+            int sample = 1;
+            while (bounds.outWidth / (sample * 2) >= targetWidth) sample *= 2;
+            BitmapFactory.Options options = new BitmapFactory.Options();
+            options.inSampleSize = sample;
+            return BitmapFactory.decodeFile(file.getAbsolutePath(), options);
+        } catch (RuntimeException | OutOfMemoryError e) {
+            return null;
+        }
+    }
+
+    private void showFull(final File file) {
+        final Context context = requireContext();
+        PojavApplication.sExecutorService.execute(() -> {
+            final Bitmap bitmap = decode(file, 1400);
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                if (bitmap == null) {
+                    Toast.makeText(context, R.string.nexa_ss_failed, Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                ImageView image = new ImageView(context);
+                image.setAdjustViewBounds(true);
+                image.setImageBitmap(bitmap);
+                new AlertDialog.Builder(context)
+                        .setTitle(file.getName())
+                        .setView(image)
+                        .setPositiveButton(R.string.nexa_ss_close, null)
+                        .setNeutralButton(R.string.nexa_ss_delete, (dialog, which) -> {
+                            //noinspection ResultOfMethodCallIgnored
+                            file.delete();
+                            refresh();
+                        })
+                        .show();
+            });
+        });
+    }
+}
