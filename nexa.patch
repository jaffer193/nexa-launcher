+package net.kdt.pojavlaunch.nexa;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import androidx.annotation.NonNull;
+
+/** Play time and the last time played, per profile. Counted while the game is on the screen. */
+public final class PlayStats {
+    private static final String PREFIX_TIME = "nexa_playtime_";
+    private static final String PREFIX_LAST = "nexa_lastplayed_";
+
+    private PlayStats() {}
+
+    public static void addSeconds(@NonNull Context context, @NonNull String profileKey, int seconds) {
+        SharedPreferences prefs = NexaClient.prefs(context);
+        long total = prefs.getLong(PREFIX_TIME + profileKey, 0) + seconds;
+        prefs.edit().putLong(PREFIX_TIME + profileKey, total)
+                .putLong(PREFIX_LAST + profileKey, System.currentTimeMillis()).apply();
+    }
+
+    public static long totalSeconds(@NonNull Context context, @NonNull String profileKey) {
+        return NexaClient.prefs(context).getLong(PREFIX_TIME + profileKey, 0);
+    }
+
+    public static long lastPlayed(@NonNull Context context, @NonNull String profileKey) {
+        return NexaClient.prefs(context).getLong(PREFIX_LAST + profileKey, 0);
+    }
+
+    public static String format(long seconds) {
+        long hours = seconds / 3600;
+        long minutes = (seconds % 3600) / 60;
+        return hours > 0 ? hours + "h " + minutes + "m" : minutes + "m";
+    }
+}
