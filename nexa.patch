+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/nexa/ProfileTransfer.java
@@ -0,0 +1,181 @@
+package net.kdt.pojavlaunch.nexa;
+
+import android.content.ContentResolver;
+import android.net.Uri;
+
+import androidx.annotation.NonNull;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.prefs.LauncherPreferences;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Enumeration;
+import java.util.Locale;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+import java.util.zip.ZipOutputStream;
+
+/**
+ * Packs a profile (its settings and its mods, config, resource packs, shader packs and options)
+ * into one zip that a friend can import, and imports such a zip as a new profile.
+ * Worlds are not included. The Minecraft version itself is downloaded by the game when needed.
+ */
+public final class ProfileTransfer {
+    private static final String INFO_ENTRY = "nexa_profile.json";
+    private static final String[] PARTS = {
+            "mods", "config", "resourcepacks", "shaderpacks", "options.txt", "optionsof.txt", "optionsshaders.txt"
+    };
+
+    private ProfileTransfer() {}
+
+    public static File exportDir() {
+        return new File(Tools.DIR_GAME_HOME, "nexa_exports");
+    }
+
+    /** @return the zip file that was written */
+    public static @NonNull File export(@NonNull MinecraftProfile profile) throws IOException {
+        File folder = exportDir();
+        //noinspection ResultOfMethodCallIgnored
+        folder.mkdirs();
+        String name = profile.name == null || profile.name.isEmpty() ? "profile" : profile.name;
+        String safe = name.replaceAll("[^A-Za-z0-9._-]+", "_");
+        String stamp = new SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(new Date());
+        File zip = new File(folder, safe + "_" + stamp + ".nexaprofile.zip");
+        File partial = new File(folder, zip.getName() + ".part");
+
+        File gameDir = Tools.getGameDirPath(profile);
+        try (ZipOutputStream out = new ZipOutputStream(new FileOutputStream(partial))) {
+            out.putNextEntry(new ZipEntry(INFO_ENTRY));
+            out.write(Tools.GLOBAL_GSON.toJson(profile).getBytes(StandardCharsets.UTF_8));
+            out.closeEntry();
+            for (String part : PARTS) {
+                File file = new File(gameDir, part);
+                if (file.exists()) addRecursive(out, file, "files/" + part);
+            }
+        }
+        if (!partial.renameTo(zip)) {
+            //noinspection ResultOfMethodCallIgnored
+            partial.delete();
+            throw new IOException("Could not save the export");
+        }
+        return zip;
+    }
+
+    private static void addRecursive(ZipOutputStream out, File file, String path) throws IOException {
+        if (file.isDirectory()) {
+            File[] children = file.listFiles();
+            if (children == null) return;
+            for (File child : children) addRecursive(out, child, path + "/" + child.getName());
+            return;
+        }
+        out.putNextEntry(new ZipEntry(path));
+        byte[] buffer = new byte[8192];
+        try (InputStream in = new FileInputStream(file)) {
+            int read;
+            while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+        }
+        out.closeEntry();
+    }
+
+    /** Imports a zip made by {@link #export} as a new profile, which is also selected */
+    public static @NonNull String importFrom(@NonNull ContentResolver resolver, @NonNull Uri uri) throws IOException {
+        File temp = new File(Tools.DIR_CACHE, "profile_import_" + System.nanoTime() + ".zip");
+        try {
+            try (InputStream in = resolver.openInputStream(uri); OutputStream out = new FileOutputStream(temp)) {
+                if (in == null) throw new IOException("Could not open the file");
+                byte[] buffer = new byte[8192];
+                int read;
+                while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+            }
+            return importZip(temp);
+        } finally {
+            //noinspection ResultOfMethodCallIgnored
+            temp.delete();
+        }
+    }
+
+    private static String importZip(File zipFile) throws IOException {
+        try (ZipFile zip = new ZipFile(zipFile)) {
+            ZipEntry info = zip.getEntry(INFO_ENTRY);
+            if (info == null) throw new IOException("This is not a Nexa profile export");
+
+            String json;
+            try (InputStream in = zip.getInputStream(info); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+                byte[] buffer = new byte[8192];
+                int read;
+                while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+                json = out.toString("UTF-8");
+            }
+            JsonObject check = JsonParser.parseString(json).getAsJsonObject();
+            if (!check.has("lastVersionId")) throw new IOException("The profile information is incomplete");
+
+            if (LauncherProfiles.mainProfileJson == null) LauncherProfiles.load();
+            MinecraftProfile profile = Tools.GLOBAL_GSON.fromJson(json, MinecraftProfile.class);
+            String baseName = profile.name == null || profile.name.isEmpty() ? "Imported profile" : profile.name;
+            profile.name = baseName + " (imported)";
+            String folderName = freeFolderName(baseName);
+            profile.gameDir = "./custom_instances/" + folderName;
+
+            File gameDir = Tools.getGameDirPath(profile);
+            //noinspection ResultOfMethodCallIgnored
+            gameDir.mkdirs();
+            extractFiles(zip, gameDir);
+            //noinspection ResultOfMethodCallIgnored
+            new File(gameDir, "mods").mkdirs();
+            //noinspection ResultOfMethodCallIgnored
+            new File(gameDir, "saves").mkdirs();
+
+            String key = LauncherProfiles.getFreeProfileKey();
+            LauncherProfiles.mainProfileJson.profiles.put(key, profile);
+            LauncherProfiles.write();
+            LauncherPreferences.DEFAULT_PREF.edit()
+                    .putString(LauncherPreferences.PREF_KEY_CURRENT_PROFILE, key).apply();
+            return key;
+        }
+    }
+
+    private static void extractFiles(ZipFile zip, File gameDir) throws IOException {
+        String canonicalRoot = gameDir.getCanonicalPath() + File.separator;
+        String prefix = "files/";
+        byte[] buffer = new byte[8192];
+        Enumeration<? extends ZipEntry> entries = zip.entries();
+        while (entries.hasMoreElements()) {
+            ZipEntry entry = entries.nextElement();
+            String path = entry.getName().replace('\\', '/');
+            if (!path.startsWith(prefix) || entry.isDirectory()) continue;
+            File target = new File(gameDir, path.substring(prefix.length()));
+            // Zip-slip protection: nothing may be written outside the new game folder
+            if (!target.getCanonicalPath().startsWith(canonicalRoot)) continue;
+            //noinspection ResultOfMethodCallIgnored
+            target.getParentFile().mkdirs();
+            try (InputStream in = zip.getInputStream(entry); OutputStream out = new FileOutputStream(target)) {
+                int read;
+                while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+            }
+        }
+    }
+
+    private static String freeFolderName(String name) {
+        String base = name.replaceAll("[^A-Za-z0-9._-]+", "_");
+        if (base.isEmpty() || base.replace("_", "").isEmpty()) base = "profile";
+        File parent = new File(Tools.DIR_GAME_HOME, "custom_instances");
+        String candidate = base;
+        int i = 2;
+        while (new File(parent, candidate).exists()) candidate = base + "_" + i++;
+        return candidate;
+    }
+}
