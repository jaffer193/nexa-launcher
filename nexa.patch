+import java.io.IOException;
+
+/** Downloads the NeoForge installer. The installation itself is done by the same GUI flow as Forge */
+public class NeoForgeDownloadTask implements Runnable, Tools.DownloaderFeedback {
+    private final ModloaderDownloadListener mListener;
+    private final String mVersion;
+    private final String mDownloadUrl;
+
+    public NeoForgeDownloadTask(ModloaderDownloadListener listener, String neoForgeVersion) {
+        mListener = listener;
+        mVersion = neoForgeVersion;
+        mDownloadUrl = NeoForgeUtils.getInstallerUrl(neoForgeVersion);
+    }
+
+    @Override
+    public void run() {
+        ProgressKeeper.submitProgress(ProgressLayout.INSTALL_MODPACK, 0, R.string.forge_dl_progress, "NeoForge " + mVersion);
+        try {
+            File destinationFile = new File(Tools.DIR_CACHE, "neoforge-installer.jar");
+            byte[] buffer = new byte[8192];
+            DownloadUtils.downloadFileMonitored(mDownloadUrl, destinationFile, buffer, this);
+            mListener.onDownloadFinished(destinationFile);
+        } catch (FileNotFoundException e) {
+            mListener.onDataNotAvailable();
+        } catch (IOException e) {
+            mListener.onDownloadError(e);
+        }
+        ProgressLayout.clearProgress(ProgressLayout.INSTALL_MODPACK);
+    }
+
+    @Override
+    public void updateProgress(int curr, int max) {
+        int progress100 = (int) (((float) curr / (float) max) * 100f);
+        ProgressKeeper.submitProgress(ProgressLayout.INSTALL_MODPACK, progress100, R.string.forge_dl_progress, "NeoForge " + mVersion);
+    }
+}
