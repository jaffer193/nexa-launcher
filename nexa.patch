+
+/**
+ * Guided profile creation: version, then mods, resource packs and a world.
+ * Every step after the version can be skipped.
+ */
+public class CustomProfileFragment extends Fragment {
+    public static final String TAG = "CUSTOM_PROFILE_FRAGMENT";
+
+    private static final int STEP_VERSION = 0;
+    private static final int STEP_MODS = 1;
+    private static final int STEP_PACKS = 2;
+    private static final int STEP_WORLD = 3;
+    private static final int STEP_COUNT = 4;
+
+    private int mStep = STEP_VERSION;
+    private String mVersionId;
+    private String mProfileKey;
+    private File mGameDir;
+    private final int[] mAddedCount = new int[STEP_COUNT];
+    private boolean mBrowsedMods = false;
+    private int mLoader = LoaderInstaller.VANILLA;
+
+    private TextView mStepLabel, mTitle, mDescription, mVersionText, mLoaderNote;
+    private Spinner mLoaderSpinner;
+    private TextView mModsCount, mPacksCount, mWorldCount, mModsList;
+    private EditText mNameEdit;
+    private View mGroupVersion, mGroupMods, mGroupPacks, mGroupWorld;
+    private Button mNextButton;
+
+    private final ActivityResultLauncher<String[]> mModPicker =
+            registerForActivityResult(new ActivityResultContracts.OpenMultipleDocuments(), this::importMods);
+    private final ActivityResultLauncher<String[]> mPackPicker =
+            registerForActivityResult(new ActivityResultContracts.OpenMultipleDocuments(), this::importPacks);
+    private final ActivityResultLauncher<String[]> mWorldPicker =
+            registerForActivityResult(new ActivityResultContracts.OpenDocument(), this::importWorld);
+
+    public CustomProfileFragment() {
+        super(R.layout.fragment_custom_profile);
+    }
+
+    @Override
+    public void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        // The launcher can be recreated while a mod loader installer is running, keep the progress
+        if (savedInstanceState == null) return;
+        mStep = savedInstanceState.getInt("step", STEP_VERSION);
+        mVersionId = savedInstanceState.getString("version");
+        mProfileKey = savedInstanceState.getString("profileKey");
+        String gameDir = savedInstanceState.getString("gameDir");
+        mGameDir = gameDir == null ? null : new File(gameDir);
+        int[] counts = savedInstanceState.getIntArray("counts");
+        if (counts != null && counts.length == STEP_COUNT) System.arraycopy(counts, 0, mAddedCount, 0, STEP_COUNT);
+        mLoader = savedInstanceState.getInt("loader", LoaderInstaller.VANILLA);
+        mBrowsedMods = savedInstanceState.getBoolean("browsedMods", false);
+    }
+
+    @Override
+    public void onSaveInstanceState(@NonNull Bundle outState) {
+        super.onSaveInstanceState(outState);
+        outState.putInt("step", mStep);
+        outState.putString("version", mVersionId);
+        outState.putString("profileKey", mProfileKey);
+        outState.putString("gameDir", mGameDir == null ? null : mGameDir.getAbsolutePath());
+        outState.putIntArray("counts", mAddedCount);
+        outState.putInt("loader", mLoader);
+        outState.putBoolean("browsedMods", mBrowsedMods);
+    }
+
+    private @Nullable MinecraftProfile getProfile() {
+        if (mProfileKey == null) return null;
+        if (LauncherProfiles.mainProfileJson == null) LauncherProfiles.load();
+        return LauncherProfiles.mainProfileJson.profiles.get(mProfileKey);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        net.kdt.pojavlaunch.nexa.NexaTheme.applyBackground(view);
+        mStepLabel = view.findViewById(R.id.cp_step_label);
+        mTitle = view.findViewById(R.id.cp_title);
+        mDescription = view.findViewById(R.id.cp_description);
+        mVersionText = view.findViewById(R.id.cp_version_text);
+        mModsCount = view.findViewById(R.id.cp_mods_count);
+        mPacksCount = view.findViewById(R.id.cp_packs_count);
+        mWorldCount = view.findViewById(R.id.cp_world_count);
+        mModsList = view.findViewById(R.id.cp_mods_list);
+        mNameEdit = view.findViewById(R.id.cp_name);
+        mGroupVersion = view.findViewById(R.id.cp_group_version);
+        mGroupMods = view.findViewById(R.id.cp_group_mods);
+        mGroupPacks = view.findViewById(R.id.cp_group_packs);
+        mGroupWorld = view.findViewById(R.id.cp_group_world);
+        mNextButton = view.findViewById(R.id.cp_next);
+        mLoaderNote = view.findViewById(R.id.cp_loader_note);
+        mLoaderSpinner = view.findViewById(R.id.cp_loader_spinner);
+        mLoaderSpinner.setAdapter(new ArrayAdapter<>(requireContext(),
+                android.R.layout.simple_spinner_dropdown_item, LoaderInstaller.LABELS));
+        mLoaderSpinner.setSelection(mLoader);
+        mLoaderSpinner.setOnItemSelectedListener(new AdapterView.OnItemSelectedListener() {
+            @Override
+            public void onItemSelected(AdapterView<?> parent, View v, int position, long id) {
+                if (mProfileKey == null) mLoader = position;
+            }
+
+            @Override
+            public void onNothingSelected(AdapterView<?> parent) {}
+        });
+
+        view.findViewById(R.id.cp_version_button).setOnClickListener(v ->
