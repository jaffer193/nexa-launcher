+            mNameEdit.setEnabled(false);
+            mLoaderSpinner.setEnabled(false);
+            showLoaderNote();
+        }
+        render();
+    }
+
+    private void render() {
+        mGroupVersion.setVisibility(mStep == STEP_VERSION ? View.VISIBLE : View.GONE);
+        mGroupMods.setVisibility(mStep == STEP_MODS ? View.VISIBLE : View.GONE);
+        mGroupPacks.setVisibility(mStep == STEP_PACKS ? View.VISIBLE : View.GONE);
+        mGroupWorld.setVisibility(mStep == STEP_WORLD ? View.VISIBLE : View.GONE);
+        mStepLabel.setText(getString(R.string.cp_step_format, mStep + 1, STEP_COUNT));
+
+        switch (mStep) {
+            case STEP_VERSION:
+                mTitle.setText(R.string.cp_version_title);
+                mDescription.setText(R.string.cp_version_desc);
+                break;
+            case STEP_MODS:
+                mTitle.setText(R.string.cp_mods_title);
+                mDescription.setText(R.string.cp_mods_desc);
+                break;
+            case STEP_PACKS:
+                mTitle.setText(R.string.cp_packs_title);
+                mDescription.setText(R.string.cp_packs_desc);
+                break;
+            default:
+                mTitle.setText(R.string.cp_world_title);
+                mDescription.setText(R.string.cp_world_desc);
+                break;
+        }
+        mModsCount.setText(getString(R.string.cp_added_format, mAddedCount[STEP_MODS]));
+        mPacksCount.setText(getString(R.string.cp_added_format, mAddedCount[STEP_PACKS]));
+        mWorldCount.setText(getString(R.string.cp_added_format, mAddedCount[STEP_WORLD]));
+
+        if (mStep == STEP_MODS) refreshModList();
+
+        boolean added = mAddedCount[mStep] > 0 || (mStep == STEP_MODS && mBrowsedMods);
+        if (mStep == STEP_VERSION) mNextButton.setText(R.string.cp_next);
+        else if (mStep == STEP_WORLD) mNextButton.setText(added ? R.string.cp_finish : R.string.cp_skip_finish);
+        else mNextButton.setText(added ? R.string.cp_next : R.string.cp_skip);
+    }
+
+    private void onNext() {
+        if (mStep == STEP_VERSION) {
+            if (!createProfile()) return;
+        } else if (mStep == STEP_WORLD) {
+            MinecraftProfile profile = getProfile();
+            if (profile != null && LoaderInstaller.needsGuiInstaller(mLoader)) {
+                LoaderInstaller.installAsync(requireContext(), mProfileKey, profile, mLoader);
+            }
+            Toast.makeText(requireContext(), R.string.cp_done, Toast.LENGTH_SHORT).show();
+            Tools.backToMainMenu(requireActivity());
+            return;
+        }
+        mStep++;
+        render();
+    }
+
+    /** Creates and selects the profile in its own game folder, so mods/packs/worlds stay separate */
+    private boolean createProfile() {
+        String name = mNameEdit.getText().toString().trim();
+        if (name.isEmpty()) {
+            Toast.makeText(requireContext(), R.string.cp_need_name, Toast.LENGTH_SHORT).show();
+            return false;
+        }
+        if (mVersionId == null) {
+            Toast.makeText(requireContext(), R.string.cp_need_version, Toast.LENGTH_SHORT).show();
+            return false;
+        }
+        if (LauncherProfiles.mainProfileJson == null) LauncherProfiles.load();
+
+        MinecraftProfile profile = MinecraftProfile.createTemplate();
+        profile.name = name;
+        profile.lastVersionId = mVersionId;
+        profile.gameDir = "./custom_instances/" + freeFolderName(name);
+
+        mProfileKey = LauncherProfiles.getFreeProfileKey();
+        LauncherProfiles.mainProfileJson.profiles.put(mProfileKey, profile);
+        LauncherProfiles.write();
+
+        mGameDir = Tools.getGameDirPath(profile);
+        ModGuard.rememberTarget(mGameDir, loaderKey(mLoaderSpinner.getSelectedItemPosition()),
+                QuickPackInstaller.resolveMcVersion(mVersionId));
+        new File(mGameDir, "mods").mkdirs();
+        new File(mGameDir, "resourcepacks").mkdirs();
+        new File(mGameDir, "saves").mkdirs();
+
+        // Select it now so the online mod browser installs into this profile
+        LauncherPreferences.DEFAULT_PREF.edit()
+                .putString(LauncherPreferences.PREF_KEY_CURRENT_PROFILE, mProfileKey).apply();
+        ExtraCore.setValue(ExtraConstants.REFRESH_VERSION_SPINNER, mProfileKey);
+
+        mNameEdit.setEnabled(false);
+        mLoader = mLoaderSpinner.getSelectedItemPosition();
+        mLoaderSpinner.setEnabled(false);
+
+        if (mLoader == LoaderInstaller.FABRIC || mLoader == LoaderInstaller.QUILT) {
+            // Only a version json is needed, so it can be installed right now
+            LoaderInstaller.installAsync(requireContext(), mProfileKey, profile, mLoader);
+        } else {
+            showLoaderNote();
+        }
+        return true;
+    }
+
+    /** Forge and NeoForge open a graphical installer, so they are installed when the wizard ends */
+    private void showLoaderNote() {
+        if (!LoaderInstaller.needsGuiInstaller(mLoader)) return;
+        mLoaderNote.setText(getString(R.string.cp_loader_pending_note, LoaderInstaller.LABELS[mLoader]));
+        mLoaderNote.setVisibility(View.VISIBLE);
+    }
+
+    private static String freeFolderName(String name) {
+        String base = name.replaceAll("[^A-Za-z0-9._-]+", "_");
+        if (base.isEmpty() || base.replace("_", "").isEmpty()) base = "profile";
+        File parent = new File(Tools.DIR_GAME_HOME, "custom_instances");
+        String candidate = base;
+        int i = 2;
+        while (new File(parent, candidate).exists()) candidate = base + "_" + i++;
+        return candidate;
+    }
+
+    // ---- Importing -------------------------------------------------------------------------
+
+    /** The loader and Minecraft version that the mods of this profile must be made for */
+    private ModGuard.Target currentTarget() {
+        String loader = loaderKey(mLoader);
+        if (loader == null && mVersionId != null) loader = QuickPackInstaller.detectLoader(mVersionId);
+        return new ModGuard.Target(loader, QuickPackInstaller.resolveMcVersion(mVersionId));
+    }
+
+    private static @Nullable String loaderKey(int loader) {
+        switch (loader) {
+            case LoaderInstaller.FABRIC: return "fabric";
+            case LoaderInstaller.QUILT: return "quilt";
+            case LoaderInstaller.FORGE: return "forge";
+            case LoaderInstaller.NEOFORGE: return "neoforge";
+            default: return null;
+        }
+    }
+
+    private static String safeFileName(@Nullable String name, String requiredEnding) {
+        String clean = name == null || name.isEmpty() ? "file" + System.nanoTime() : name;
+        clean = clean.replaceAll("[\\\\/:*?\"<>|]", "_");
+        if (!clean.toLowerCase().endsWith(requiredEnding)) clean += requiredEnding;
+        return clean;
+    }
+
+    /** Every mod is checked before it enters the mods folder (see {@link ModGuard}) */
+    private void importMods(@Nullable List<Uri> uris) {
+        if (uris == null || uris.isEmpty() || mGameDir == null) return;
+        final ContentResolver resolver = requireContext().getContentResolver();
+        final File modsDir = new File(mGameDir, "mods");
+        final ModGuard.Target target = currentTarget();
+        PojavApplication.sExecutorService.execute(() -> {
+            int ok = 0;
+            List<String> notes = new ArrayList<>();
+            for (Uri uri : uris) {
+                String name = safeFileName(queryName(resolver, uri), ".jar");
+                File temp = new File(Tools.DIR_CACHE, "mod_import_" + System.nanoTime() + ".jar");
+                try {
+                    try (InputStream in = resolver.openInputStream(uri);
+                         OutputStream out = new FileOutputStream(temp)) {
+                        if (in == null) {
+                            notes.add(name + ": could not be opened.");
+                            continue;
+                        }
+                        copy(in, out);
+                    }
+                    ModGuard.Admitted admitted = ModGuard.admit(temp, name, modsDir, target);
+                    ok++;
+                    if (!admitted.verified) {
+                        notes.add(name + ": added, but it could not be verified (no mod information inside).");
+                    }
+                } catch (ModGuard.RejectedException e) {
+                    notes.add(e.getMessage());
+                } catch (IOException | RuntimeException e) {
+                    notes.add(name + ": " + e.getMessage());
+                } finally {
+                    //noinspection ResultOfMethodCallIgnored
+                    temp.delete();
+                }
+            }
+            final int added = ok;
+            Tools.runOnUiThread(() -> afterImport(STEP_MODS, added, notes));
+        });
+    }
+
+    private void importPacks(@Nullable List<Uri> uris) {
+        if (uris == null || uris.isEmpty() || mGameDir == null) return;
+        final ContentResolver resolver = requireContext().getContentResolver();
+        final File packDir = ResourcePackManager.getPackDir(mGameDir);
+        PojavApplication.sExecutorService.execute(() -> {
+            int ok = 0;
+            List<String> notes = new ArrayList<>();
+            //noinspection ResultOfMethodCallIgnored
+            packDir.mkdirs();
+            for (Uri uri : uris) {
+                String name = safeFileName(queryName(resolver, uri), ".zip");
+                File destination = new File(packDir, name);
+                if (destination.exists()) {
+                    notes.add(name + ": already added.");
+                    continue;
+                }
+                File temp = new File(Tools.DIR_CACHE, "pack_import_" + System.nanoTime() + ".zip");
+                try {
+                    try (InputStream in = resolver.openInputStream(uri);
+                         OutputStream out = new FileOutputStream(temp)) {
+                        if (in == null) {
+                            notes.add(name + ": could not be opened.");
+                            continue;
+                        }
+                        copy(in, out);
+                    }
+                    // A resource pack is a zip with a pack.mcmeta file in it
+                    boolean validPack;
+                    try (ZipFile zip = new ZipFile(temp)) {
+                        validPack = zip.getEntry("pack.mcmeta") != null;
+                    } catch (IOException e) {
+                        validPack = false;
+                    }
+                    if (!validPack) {
+                        notes.add(name + ": this is not a resource pack (pack.mcmeta is missing).");
+                        continue;
+                    }
+                    try (InputStream in = new java.io.FileInputStream(temp);
+                         OutputStream out = new FileOutputStream(destination)) {
+                        copy(in, out);
+                    }
+                    ResourcePackManager.setEnabled(mGameDir, name, true);
+                    ok++;
+                } catch (IOException | RuntimeException e) {
+                    notes.add(name + ": " + e.getMessage());
+                } finally {
+                    //noinspection ResultOfMethodCallIgnored
+                    temp.delete();
+                }
+            }
+            final int added = ok;
+            Tools.runOnUiThread(() -> afterImport(STEP_PACKS, added, notes));
+        });
+    }
+
+    /** Fills the list of mods of the profile, with a mark for each one */
+    private void refreshModList() {
+        if (mGameDir == null) {
+            mModsList.setVisibility(View.GONE);
+            return;
+        }
+        final File modsDir = new File(mGameDir, "mods");
+        final ModGuard.Target target = currentTarget();
+        PojavApplication.sExecutorService.execute(() -> {
+            List<String> lines = ModGuard.describeInstalled(modsDir, target);
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                mModsList.setVisibility(View.VISIBLE);
+                if (lines.isEmpty()) {
+                    mModsList.setText(R.string.cp_mods_none);
+                } else {
+                    mModsList.setText(getString(R.string.cp_mods_installed_header) + "\n" + android.text.TextUtils.join("\n", lines));
+                }
+            });
+        });
+    }
+
+    private void importWorld(@Nullable Uri uri) {
+        if (uri == null || mGameDir == null) return;
+        final ContentResolver resolver = requireContext().getContentResolver();
+        PojavApplication.sExecutorService.execute(() -> {
+            boolean ok = false;
+            File temp = new File(Tools.DIR_CACHE, "world_import.zip");
+            try {
+                String zipName = queryName(resolver, uri);
+                try (InputStream in = resolver.openInputStream(uri);
+                     OutputStream out = new FileOutputStream(temp)) {
+                    if (in != null) copy(in, out);
+                }
+                ok = extractWorld(temp, new File(mGameDir, "saves"), zipName);
+            } catch (IOException | RuntimeException e) {
+                e.printStackTrace();
+            } finally {
+                temp.delete();
+            }
+            final int added = ok ? 1 : 0;
+            Tools.runOnUiThread(() -> afterImport(STEP_WORLD, added, new ArrayList<>()));
+        });
+    }
+
+    /** Extracts a world zip, finding the folder that contains level.dat */
+    private static boolean extractWorld(File zip, File savesDir, @Nullable String zipName) throws IOException {
+        try (ZipFile zipFile = new ZipFile(zip)) {
+            String prefix = null;
+            int bestDepth = Integer.MAX_VALUE;
+            Enumeration<? extends ZipEntry> entries = zipFile.entries();
+            while (entries.hasMoreElements()) {
+                String path = entries.nextElement().getName().replace('\\', '/');
+                if (path.equals("level.dat") || path.endsWith("/level.dat")) {
+                    int depth = path.split("/").length;
+                    if (depth < bestDepth) {
+                        bestDepth = depth;
+                        prefix = path.substring(0, path.length() - "level.dat".length());
+                    }
+                }
+            }
+            if (prefix == null) return false; // not a Minecraft world
+
+            String worldName;
+            if (!prefix.isEmpty()) {
+                String[] parts = prefix.split("/");
+                worldName = parts[parts.length - 1];
+            } else {
+                worldName = zipName == null ? "World" : zipName.replaceAll("(?i)\\.zip$", "");
+            }
+            worldName = worldName.replaceAll("[\\\\/:*?\"<>|]", "_");
+            if (worldName.isEmpty()) worldName = "World";
+
+            File worldDir = new File(savesDir, worldName);
+            int i = 2;
+            while (worldDir.exists()) worldDir = new File(savesDir, worldName + "_" + i++);
+            String canonicalRoot = worldDir.getCanonicalPath() + File.separator;
+
+            entries = zipFile.entries();
+            while (entries.hasMoreElements()) {
+                ZipEntry entry = entries.nextElement();
+                String path = entry.getName().replace('\\', '/');
+                if (!path.startsWith(prefix) || path.equals(prefix)) continue;
+                File target = new File(worldDir, path.substring(prefix.length()));
+                // Zip-slip protection
+                if (!target.getCanonicalPath().startsWith(canonicalRoot)) continue;
+                if (entry.isDirectory()) {
+                    target.mkdirs();
+                    continue;
+                }
+                target.getParentFile().mkdirs();
+                try (InputStream in = zipFile.getInputStream(entry);
+                     OutputStream out = new FileOutputStream(target)) {
+                    copy(in, out);
+                }
+            }
+            return true;
+        }
+    }
+
+    private void afterImport(int step, int added, List<String> notes) {
+        if (!isAdded()) return;
+        mAddedCount[step] += added;
+        if (notes.isEmpty()) {
+            Toast.makeText(requireContext(),
+                    added > 0 ? getString(R.string.cp_import_ok, added) : getString(R.string.cp_import_failed),
+                    Toast.LENGTH_SHORT).show();
+        } else {
+            // Say clearly what was added and what was refused, and why
+            new AlertDialog.Builder(requireContext())
+                    .setTitle(R.string.cp_import_report)
+                    .setMessage(getString(R.string.cp_import_ok, added) + "\n\n"
+                            + android.text.TextUtils.join("\n\n", notes))
+                    .setPositiveButton(android.R.string.ok, null)
+                    .show();
+        }
+        render();
+    }
+
+    private static void copy(InputStream in, OutputStream out) throws IOException {
+        byte[] buffer = new byte[8192];
+        int read;
+        while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+    }
+
+    @Nullable
+    private static String queryName(ContentResolver resolver, Uri uri) {
+        try (Cursor cursor = resolver.query(uri, new String[]{OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) return cursor.getString(0);
+        } catch (RuntimeException ignored) { }
+        return null;
+    }
+}
