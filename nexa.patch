@@ -0,0 +1,97 @@
+package net.kdt.pojavlaunch.nexa;
+
+import android.app.Activity;
+import android.app.ActivityManager;
+import android.app.AlertDialog;
+import android.app.ApplicationExitInfo;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Build;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.annotation.RequiresApi;
+
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+
+import java.util.List;
+
+/**
+ * When the game dies without leaving an error in the log, Android still knows why the process
+ * ended (out of memory, crash, killed by a signal...). This reads that reason at the next start
+ * of the launcher and shows it once. Needs Android 11 or newer.
+ */
+public final class ExitReasonReporter {
+    private static final String PREF_SEEN = "nexa_exit_seen";
+
+    private ExitReasonReporter() {}
+
+    public static void showIfNeeded(@NonNull Activity activity) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return;
+        try {
+            check(activity);
+        } catch (RuntimeException e) {
+            // A diagnostic must never get in the way of the launcher
+            e.printStackTrace();
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.R)
+    private static void check(Activity activity) {
+        ActivityManager manager = (ActivityManager) activity.getSystemService(Context.ACTIVITY_SERVICE);
+        if (manager == null) return;
+        List<ApplicationExitInfo> infos = manager.getHistoricalProcessExitReasons(activity.getPackageName(), 0, 6);
+        if (infos.isEmpty()) return;
+
+        SharedPreferences prefs = NexaClient.prefs(activity);
+        long lastSeen = prefs.getLong(PREF_SEEN, 0);
+        long newest = infos.get(0).getTimestamp();
+        prefs.edit().putLong(PREF_SEEN, newest).apply();
+        if (lastSeen == 0) return; // first run after install: nothing to report
+
+        // Newest first: report the most recent abnormal end that was not reported yet
+        for (ApplicationExitInfo info : infos) {
+            if (info.getTimestamp() <= lastSeen) break;
+            String text = describe(info);
+            if (text == null) continue;
+            new AlertDialog.Builder(activity)
+                    .setTitle(R.string.nexa_exit_title)
+                    .setMessage(text)
+                    .setPositiveButton(android.R.string.ok, null)
+                    .setNeutralButton(R.string.main_share_logs, (dialog, which) -> Tools.shareLog(activity))
+                    .show();
+            return;
+        }
+    }
+
+    /** @return null for normal endings (the user closed the app, the game exited by itself) */
+    @RequiresApi(Build.VERSION_CODES.R)
+    private static @Nullable String describe(ApplicationExitInfo info) {
+        String detail = info.getDescription();
+        String suffix = detail == null || detail.isEmpty() ? "" : "\n\n(" + detail + ")";
+        switch (info.getReason()) {
+            case ApplicationExitInfo.REASON_LOW_MEMORY:
+                return "Android closed the app because the phone ran out of memory. Lower the RAM allocation "
+                        + "in Settings > Java, close other apps, or use a lighter modpack." + suffix;
+            case ApplicationExitInfo.REASON_CRASH:
+                return "The launcher itself crashed (a Java error in the app, not in the game)." + suffix;
+            case ApplicationExitInfo.REASON_CRASH_NATIVE:
+                return "The game process crashed in native code (signal " + info.getStatus()
+                        + "). This is usually the graphics driver or the Java runtime. Try another renderer "
+                        + "in Settings > Video, or another Java version for this profile." + suffix;
+            case ApplicationExitInfo.REASON_SIGNALED:
+                return "The process was ended by signal " + info.getStatus()
+                        + (info.getStatus() == 9 ? " (killed by the system, most often because of low memory)." : ".")
+                        + suffix;
+            case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE:
+                return "Android ended the app for using too many resources." + suffix;
+            case ApplicationExitInfo.REASON_ANR:
+                return "The app stopped responding and Android ended it." + suffix;
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE:
+                return "The app failed to start." + suffix;
+            default:
+                return null;
+        }
+    }
+}
