+    /** Puts the circle where the user left it, or near the top right by default */
+    private void placeBubble() {
+        int width = mParent.getWidth();
+        int height = mParent.getHeight();
+        if (width == 0 || height == 0) {
+            if (++mPlaceAttempts < 60) mParent.post(this::placeBubble);
+            return;
+        }
+        int size = dp(46);
+        float fx = mPrefs.getFloat("nexa_bubble_fx", (width - size - dp(90)) / (float) width);
+        float fy = mPrefs.getFloat("nexa_bubble_fy", dp(8) / (float) height);
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) mBubble.getLayoutParams();
+        params.leftMargin = clamp(Math.round(fx * width), 0, width - size);
+        params.topMargin = clamp(Math.round(fy * height), 0, height - size);
+        mBubble.setLayoutParams(params);
+    }
