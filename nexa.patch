+import java.util.Map;
+
+/**
+ * Version picker for Forge and NeoForge, with the same look as the Fabric and Quilt ones:
+ * a Minecraft version spinner, a loader version spinner and an Install button.
+ */
+public abstract class ForgeLikeInstallFragment extends Fragment
+        implements ModloaderDownloadListener, CompoundButton.OnCheckedChangeListener {
+
+    /** One entry of the loader version spinner */
+    private static final class LoaderEntry {
+        final String label;
+        final String fullVersion;
+
+        LoaderEntry(String label, String fullVersion) {
+            this.label = label;
+            this.fullVersion = fullVersion;
+        }
+
+        @NonNull
+        @Override
+        public String toString() {
+            return label;
+        }
+    }
+
+    private final String mLoaderName;
+    private final String mExtraTag;
+    private final int mTitleRes;
+    private final boolean mHasStableFlag;
+
+    private Spinner mGameSpinner;
+    private Spinner mLoaderSpinner;
+    private ProgressBar mProgressBar;
+    private Button mStartButton;
+    private View mRetryView;
+    private CheckBox mStableCheckbox;
+
+    /** Game version -> loader versions, newest first. Filled once the metadata is loaded. */
+    private Map<String, List<LoaderEntry>> mVersions;
+    private String mSelectedFullVersion;
+
+    protected ForgeLikeInstallFragment(String loaderName, String tag, int titleRes, boolean hasStableFlag) {
+        super(R.layout.fragment_fabric_install);
+        mLoaderName = loaderName;
+        mExtraTag = tag + "_proxy";
+        mTitleRes = titleRes;
+        mHasStableFlag = hasStableFlag;
+    }
+
+    // ---- What differs between Forge and NeoForge -----------------------------------------------
+
+    /** @return all versions of the loader as listed by its repository */
+    protected abstract @Nullable List<String> downloadVersions() throws IOException;
+
+    /** @return the Minecraft version a loader version is for, or null to skip it */
+    protected abstract @Nullable String gameVersionOf(String loaderVersion);
+
+    /** @return the text shown in the loader spinner */
+    protected abstract String labelOf(String loaderVersion, String gameVersion);
+
+    protected abstract boolean isStable(String loaderVersion);
+
+    protected abstract Runnable createDownloadTask(ModloaderListenerProxy proxy, String loaderVersion);
+
+    // ---- Screen --------------------------------------------------------------------------------
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        ((TextView) view.findViewById(R.id.title_textview)).setText(mTitleRes);
+        ((TextView) view.findViewById(R.id.fabric_installer_label_loader_ver))
+                .setText(getString(R.string.fabric_dl_loader_version, mLoaderName));
+
+        mStartButton = view.findViewById(R.id.fabric_installer_start_button);
+        mStartButton.setOnClickListener(this::onClickStart);
+        mGameSpinner = view.findViewById(R.id.fabric_installer_game_ver_spinner);
+        mGameSpinner.setOnItemSelectedListener(new AdapterView.OnItemSelectedListener() {
+            @Override
+            public void onItemSelected(AdapterView<?> parent, View v, int position, long id) {
+                updateLoaderSpinner((String) parent.getAdapter().getItem(position));
+            }
+
+            @Override
+            public void onNothingSelected(AdapterView<?> parent) {
+                mLoaderSpinner.setAdapter(null);
+                mSelectedFullVersion = null;
+                mStartButton.setEnabled(false);
+            }
+        });
+        mLoaderSpinner = view.findViewById(R.id.fabric_installer_loader_ver_spinner);
+        mLoaderSpinner.setOnItemSelectedListener(new AdapterView.OnItemSelectedListener() {
+            @Override
+            public void onItemSelected(AdapterView<?> parent, View v, int position, long id) {
+                mSelectedFullVersion = ((LoaderEntry) parent.getAdapter().getItem(position)).fullVersion;
+                mStartButton.setEnabled(true);
+            }
+
+            @Override
+            public void onNothingSelected(AdapterView<?> parent) {
+                mSelectedFullVersion = null;
+                mStartButton.setEnabled(false);
+            }
+        });
+        mProgressBar = view.findViewById(R.id.fabric_installer_progress_bar);
+        mRetryView = view.findViewById(R.id.fabric_installer_retry_layout);
+        view.findViewById(R.id.fabric_installer_retry_button).setOnClickListener(v -> {
+            mRetryView.setVisibility(View.GONE);
+            loadVersions();
+        });
+        mStableCheckbox = view.findViewById(R.id.fabric_installer_only_stable_checkbox);
+        mStableCheckbox.setOnCheckedChangeListener(this);
+        if (!mHasStableFlag) {
+            // Forge has no stable/beta flag in its metadata
+            mStableCheckbox.setVisibility(View.GONE);
+            view.findViewById(R.id.fabric_installer_label_options).setVisibility(View.GONE);
+        }
+
+        mStartButton.setEnabled(false);
+        ModloaderListenerProxy proxy = getListenerProxy();
+        if (proxy != null) proxy.attachListener(this);
+        loadVersions();
+    }
+
+    @Override
+    public void onStop() {
+        ModloaderListenerProxy proxy = getListenerProxy();
+        if (proxy != null) proxy.detachListener();
+        super.onStop();
+    }
+
+    // ---- Loading the versions ------------------------------------------------------------------
+
+    private void loadVersions() {
+        mProgressBar.setVisibility(View.VISIBLE);
+        mStartButton.setEnabled(false);
+        PojavApplication.sExecutorService.execute(() -> {
+            try {
+                List<String> all = downloadVersions();
+                Map<String, List<LoaderEntry>> grouped = group(all);
+                Tools.runOnUiThread(() -> {
+                    if (!isAdded()) return;
+                    mProgressBar.setVisibility(View.GONE);
+                    if (grouped == null || grouped.isEmpty()) {
+                        mRetryView.setVisibility(View.VISIBLE);
+                        return;
+                    }
+                    mVersions = grouped;
+                    updateGameSpinner();
+                });
+            } catch (IOException e) {
+                Tools.runOnUiThread(() -> {
+                    if (!isAdded()) return;
+                    mProgressBar.setVisibility(View.GONE);
+                    mRetryView.setVisibility(View.VISIBLE);
+                    Tools.showError(requireContext(), e);
+                });
+            }
+        });
+    }
+
+    /** Groups the loader versions by Minecraft version. Each group is ordered newest first. */
+    private @Nullable Map<String, List<LoaderEntry>> group(@Nullable List<String> all) {
+        if (all == null) return null;
+        Map<String, List<LoaderEntry>> grouped = new LinkedHashMap<>();
+        // The repositories list the oldest build first, so walk the list backwards
+        for (int i = all.size() - 1; i >= 0; i--) {
+            String version = all.get(i);
+            String game = gameVersionOf(version);
+            if (game == null) continue;
+            List<LoaderEntry> list = grouped.get(game);
+            if (list == null) {
+                list = new ArrayList<>();
+                grouped.put(game, list);
+            }
+            list.add(new LoaderEntry(labelOf(version, game), version));
+        }
+        return grouped;
+    }
+
+    private boolean onlyStable() {
+        return mHasStableFlag && mStableCheckbox.isChecked();
+    }
+
+    private List<LoaderEntry> filtered(String game) {
+        List<LoaderEntry> source = mVersions.get(game);
+        List<LoaderEntry> result = new ArrayList<>();
+        if (source == null) return result;
+        for (LoaderEntry entry : source) {
+            if (!onlyStable() || isStable(entry.fullVersion)) result.add(entry);
+        }
+        return result;
+    }
+
+    /** Newest Minecraft version first. The repositories do not list them in a useful order. */
+    private static final Comparator<String> NEWEST_FIRST = (a, b) -> {
+        String[] pa = a.split("[.\\-]");
+        String[] pb = b.split("[.\\-]");
+        for (int i = 0; i < Math.max(pa.length, pb.length); i++) {
+            int na = i < pa.length ? parseOrZero(pa[i]) : 0;
+            int nb = i < pb.length ? parseOrZero(pb[i]) : 0;
+            if (na != nb) return Integer.compare(nb, na);
+        }
+        return 0;
+    };
+
+    private static int parseOrZero(String text) {
+        try {
+            return Integer.parseInt(text);
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    private void updateGameSpinner() {
+        if (mVersions == null) return;
+        List<String> games = new ArrayList<>();
+        for (String game : mVersions.keySet()) {
+            if (!filtered(game).isEmpty()) games.add(game);
+        }
+        Collections.sort(games, NEWEST_FIRST);
+        mGameSpinner.setAdapter(new ArrayAdapter<>(requireContext(),
+                android.R.layout.simple_spinner_dropdown_item, games));
+    }
+
+    private void updateLoaderSpinner(String game) {
+        if (mVersions == null) return;
+        mLoaderSpinner.setAdapter(new ArrayAdapter<>(requireContext(),
+                android.R.layout.simple_spinner_dropdown_item, filtered(game)));
+    }
+
+    @Override
+    public void onCheckedChanged(CompoundButton compoundButton, boolean checked) {
+        updateGameSpinner();
+    }
+
+    // ---- Installing ----------------------------------------------------------------------------
+
+    private void onClickStart(View v) {
+        if (mSelectedFullVersion == null) return;
+        if (ProgressKeeper.hasOngoingTasks()) {
+            Toast.makeText(v.getContext(), R.string.tasks_ongoing, Toast.LENGTH_LONG).show();
+            return;
+        }
+        ModloaderListenerProxy proxy = new ModloaderListenerProxy();
+        Runnable task = createDownloadTask(proxy, mSelectedFullVersion);
+        proxy.attachListener(this);
+        setListenerProxy(proxy);
+        mStartButton.setEnabled(false);
+        new Thread(task).start();
+    }
+
+    @Override
+    public void onDownloadFinished(File downloadedFile) {
+        Tools.runOnUiThread(() -> {
+            ModloaderListenerProxy proxy = getListenerProxy();
+            if (proxy != null) proxy.detachListener();
+            setListenerProxy(null);
+            if (!isAdded()) return;
+            mStartButton.setEnabled(true);
+            Toast.makeText(requireContext(), getString(R.string.nexa_installer_hint, mLoaderName), Toast.LENGTH_LONG).show();
+            // Runs the installer, which also creates the launcher profile
+            Intent installerIntent = new Intent(requireContext(), JavaGUILauncherActivity.class);
+            ForgeUtils.addAutoInstallArgs(installerIntent, downloadedFile, true);
+            requireContext().startActivity(installerIntent);
+        });
+    }
+
+    @Override
+    public void onDataNotAvailable() {
+        Tools.runOnUiThread(() -> {
+            ModloaderListenerProxy proxy = getListenerProxy();
+            if (proxy != null) proxy.detachListener();
+            setListenerProxy(null);
+            if (!isAdded()) return;
+            Context context = requireContext();
+            mStartButton.setEnabled(true);
+            Tools.dialog(context, context.getString(R.string.global_error),
+                    context.getString(R.string.forge_dl_no_installer));
+        });
+    }
+
+    @Override
+    public void onDownloadError(Exception e) {
+        Tools.runOnUiThread(() -> {
+            ModloaderListenerProxy proxy = getListenerProxy();
+            if (proxy != null) proxy.detachListener();
+            setListenerProxy(null);
+            if (!isAdded()) return;
+            mStartButton.setEnabled(true);
+            Tools.showError(requireContext(), e);
+        });
+    }
+
+    private ModloaderListenerProxy getListenerProxy() {
+        return (ModloaderListenerProxy) ExtraCore.getValue(mExtraTag);
+    }
+
+    private void setListenerProxy(ModloaderListenerProxy proxy) {
+        ExtraCore.setValue(mExtraTag, proxy);
+    }
+}
