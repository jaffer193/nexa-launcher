@@ -0,0 +1,72 @@
+package net.kdt.pojavlaunch.nexa;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import net.kdt.pojavlaunch.modloaders.modpacks.api.ResourcePackManager;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+/**
+ * Local (offline) accounts have no skin on a server, so the game shows one of its default skins.
+ * This builds a resource pack that replaces all the default skins with the edited one, and turns it on.
+ */
+public final class SkinPackBuilder {
+    public static final String PACK_NAME = "NexaSkin.zip";
+    private static final String[] DEFAULT_SKINS = {"alex", "ari", "efe", "kai", "makena", "noor", "steve", "sunny", "zuri"};
+
+    private SkinPackBuilder() {}
+
+    public static void install(@NonNull File gameDir, @NonNull byte[] png, @Nullable String mcVersion) throws IOException {
+        File packDir = ResourcePackManager.getPackDir(gameDir);
+        //noinspection ResultOfMethodCallIgnored
+        packDir.mkdirs();
+        File pack = new File(packDir, PACK_NAME);
+        File partial = new File(packDir, PACK_NAME + ".part");
+        try (ZipOutputStream out = new ZipOutputStream(new FileOutputStream(partial))) {
+            add(out, "pack.mcmeta", ("{\"pack\":{\"pack_format\":" + packFormat(mcVersion)
+                    + ",\"description\":\"Nexa skin\"}}").getBytes(StandardCharsets.UTF_8));
+            // Before Minecraft 1.19.3 the default skins were at the top of the entity folder
+            add(out, "assets/minecraft/textures/entity/steve.png", png);
+            add(out, "assets/minecraft/textures/entity/alex.png", png);
+            // Since then there are nine default skins, in a wide and a slim version
+            for (String name : DEFAULT_SKINS) {
+                add(out, "assets/minecraft/textures/entity/player/wide/" + name + ".png", png);
+                add(out, "assets/minecraft/textures/entity/player/slim/" + name + ".png", png);
+            }
+        }
+        if (pack.exists() && !pack.delete()) throw new IOException("Could not replace the old skin pack");
+        if (!partial.renameTo(pack)) throw new IOException("Could not save the skin pack");
+        ResourcePackManager.setEnabled(gameDir, PACK_NAME, true);
+    }
+
+    private static void add(ZipOutputStream out, String path, byte[] data) throws IOException {
+        out.putNextEntry(new ZipEntry(path));
+        out.write(data);
+        out.closeEntry();
+    }
+
+    /** The resource pack format of a Minecraft version. A wrong number only shows a warning. */
+    static int packFormat(@Nullable String mc) {
+        if (mc == null) return 34;
+        String[][] table = {
+                {"1.21.5", "55"}, {"1.21.4", "46"}, {"1.21.2", "42"}, {"1.21", "34"}, {"1.20.5", "32"},
+                {"1.20.3", "22"}, {"1.20.2", "18"}, {"1.20", "15"}, {"1.19.4", "13"}, {"1.19.3", "12"},
+                {"1.19", "9"}, {"1.18", "8"}, {"1.17", "7"}, {"1.16.2", "6"}, {"1.15", "5"}, {"1.13", "4"},
+                {"1.11", "3"}, {"1.9", "2"}
+        };
+        try {
+            for (String[] row : table) {
+                if (ModGuard.compareVersions(mc, row[0]) >= 0) return Integer.parseInt(row[1]);
+            }
+            return 1;
+        } catch (NumberFormatException e) {
+            return 34;
+        }
+    }
+}
