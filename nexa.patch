+
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.nexa.NexaTheme;
+import net.kdt.pojavlaunch.nexa.PlayStats;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.text.DateFormat;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+
+/** Play time and last played date of every profile */
+public class StatsFragment extends Fragment {
+    public static final String TAG = "StatsFragment";
+
+    private static final class Row {
+        final String name;
+        final long seconds;
+        final long lastPlayed;
+
+        Row(String name, long seconds, long lastPlayed) {
+            this.name = name;
+            this.seconds = seconds;
+            this.lastPlayed = lastPlayed;
+        }
+    }
+
+    public StatsFragment() {
+        super(R.layout.fragment_nexa_list);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        NexaTheme.applyBackground(view);
+        ((TextView) view.findViewById(R.id.nl_title)).setText(R.string.nexa_stats_title);
+        view.findViewById(R.id.nl_actions).setVisibility(View.GONE);
+
+        final List<Row> rows = new ArrayList<>();
+        long total = 0;
+        if (LauncherProfiles.mainProfileJson == null) LauncherProfiles.load();
+        for (Map.Entry<String, MinecraftProfile> entry : LauncherProfiles.mainProfileJson.profiles.entrySet()) {
+            long seconds = PlayStats.totalSeconds(requireContext(), entry.getKey());
+            long last = PlayStats.lastPlayed(requireContext(), entry.getKey());
+            String name = entry.getValue().name == null || entry.getValue().name.isEmpty()
+                    ? entry.getKey() : entry.getValue().name;
+            rows.add(new Row(name, seconds, last));
+            total += seconds;
+        }
+        Collections.sort(rows, (a, b) -> Long.compare(b.seconds, a.seconds));
+        ((TextView) view.findViewById(R.id.nl_status)).setText(
+                getString(R.string.nexa_stats_total, PlayStats.format(total)));
+
+        ListView list = view.findViewById(R.id.nl_list);
+        list.setAdapter(new ArrayAdapter<Row>(requireContext(), android.R.layout.simple_list_item_2,
+                android.R.id.text1, rows) {
+            @NonNull
+            @Override
+            public View getView(int position, @Nullable View convertView, @NonNull ViewGroup parent) {
+                View row = super.getView(position, convertView, parent);
+                Row item = getItem(position);
+                if (item == null) return row;
+                TextView title = row.findViewById(android.R.id.text1);
+                TextView detail = row.findViewById(android.R.id.text2);
+                title.setText(item.name);
+                title.setTextColor(ContextCompat.getColor(getContext(), R.color.primary_text));
+                String last = item.lastPlayed == 0 ? getString(R.string.nexa_stats_never)
+                        : DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT)
+                        .format(new Date(item.lastPlayed));
+                detail.setText(getString(R.string.nexa_stats_row, PlayStats.format(item.seconds), last));
+                detail.setTextColor(ContextCompat.getColor(getContext(), R.color.secondary_text));
+                return row;
+            }
+        });
+    }
+}
