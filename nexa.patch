+    /** A home screen shortcut opens the launcher with a profile to start */
+    private void handleNexaLaunch(android.content.Intent intent) {
+        if (intent == null || !net.kdt.pojavlaunch.nexa.ShortcutHelper.ACTION.equals(intent.getAction())) return;
+        String key = intent.getStringExtra(net.kdt.pojavlaunch.nexa.ShortcutHelper.EXTRA_PROFILE);
+        intent.setAction(null); // handle it only once
+        if (key == null) return;
+        if (net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles.mainProfileJson == null) {
+            net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles.load();
+        }
+        if (!net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles.mainProfileJson.profiles.containsKey(key)) {
+            android.widget.Toast.makeText(this, R.string.nexa_shortcut_missing, android.widget.Toast.LENGTH_LONG).show();
+            return;
+        }
+        net.kdt.pojavlaunch.prefs.LauncherPreferences.DEFAULT_PREF.edit()
+                .putString(net.kdt.pojavlaunch.prefs.LauncherPreferences.PREF_KEY_CURRENT_PROFILE, key).apply();
+        ExtraCore.setValue(ExtraConstants.REFRESH_VERSION_SPINNER, key);
+        // Wait for the launcher to finish starting, then press "Play"
+        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
+                () -> ExtraCore.setValue(ExtraConstants.LAUNCH_GAME, true), 3000);
+    }
+
