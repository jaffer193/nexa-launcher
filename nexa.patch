@@ -0,0 +1,92 @@
+package net.kdt.pojavlaunch.nexa;
+
+import androidx.annotation.NonNull;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+
+import net.kdt.pojavlaunch.modloaders.modpacks.api.ApiHandler;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.ModrinthHelper;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Looks for newer versions of the installed mods on Modrinth. The mods are recognised by the
+ * hash of their file, so the file names do not matter. Mods that are not on Modrinth are skipped.
+ */
+public final class ModUpdater {
+    private static final ApiHandler API = new ApiHandler("https://api.modrinth.com/v2");
+
+    private ModUpdater() {}
+
+    public static final class Update {
+        public final File file;
+        public final ModrinthHelper.FileInfo newFile;
+
+        Update(File file, ModrinthHelper.FileInfo newFile) {
+            this.file = file;
+            this.newFile = newFile;
+        }
+    }
+
+    /** One request for all the mods; returns only the mods that have a newer file */
+    public static @NonNull List<Update> check(@NonNull File modsDir, @NonNull String loader,
+                                              @NonNull String mcVersion) throws IOException {
+        Map<String, File> byHash = new LinkedHashMap<>();
+        File[] files = modsDir.listFiles();
+        if (files != null) {
+            for (File file : files) {
+                if (!file.isFile() || !file.getName().toLowerCase(Locale.ROOT).endsWith(".jar")) continue;
+                String hash = ModGuard.sha1Of(file);
+                if (hash != null) byHash.put(hash, file);
+            }
+        }
+        List<Update> updates = new ArrayList<>();
+        if (byHash.isEmpty()) return updates;
+
+        JsonObject body = new JsonObject();
+        JsonArray hashes = new JsonArray();
+        for (String hash : byHash.keySet()) hashes.add(hash);
+        body.add("hashes", hashes);
+        body.addProperty("algorithm", "sha1");
+        JsonArray loaders = new JsonArray();
+        loaders.add(loader);
+        body.add("loaders", loaders);
+        JsonArray gameVersions = new JsonArray();
+        gameVersions.add(mcVersion);
+        body.add("game_versions", gameVersions);
+
+        JsonObject response = API.post("version_files/update", body, JsonObject.class);
+        if (response == null) throw new IOException("Modrinth did not answer");
+
+        for (Map.Entry<String, File> entry : byHash.entrySet()) {
+            String hash = entry.getKey();
+            if (!response.has(hash) || !response.get(hash).isJsonObject()) continue;
+            ModrinthHelper.FileInfo info = ModrinthHelper.parseVersion(response.getAsJsonObject(hash));
+            if (info != null && info.sha1 != null && !info.sha1.equalsIgnoreCase(hash)) {
+                updates.add(new Update(entry.getValue(), info));
+            }
+        }
+        return updates;
+    }
+
+    /** Downloads the new file; the old one is removed only after the new one is saved and readable */
+    public static void apply(@NonNull Update update, @NonNull File modsDir) throws IOException {
+        File downloaded = ModrinthHelper.download(update.newFile, modsDir);
+        if (!ModGuard.readInfo(downloaded).readable) {
+            //noinspection ResultOfMethodCallIgnored
+            downloaded.delete();
+            throw new IOException(update.newFile.fileName + " was damaged");
+        }
+        if (!downloaded.getAbsolutePath().equals(update.file.getAbsolutePath())) {
+            //noinspection ResultOfMethodCallIgnored
+            update.file.delete();
+        }
+    }
+}
