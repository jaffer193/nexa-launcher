+package net.kdt.pojavlaunch.nexa;
+
+import android.graphics.Bitmap;
+
+import androidx.annotation.NonNull;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.QuickPackInstaller;
+import net.kdt.pojavlaunch.value.MinecraftAccount;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+/** Puts an edited skin where the game will use it, depending on the type of the account */
+public final class SkinUploader {
+    private SkinUploader() {}
+
+    private static byte[] toPng(Bitmap skin) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        if (!skin.compress(Bitmap.CompressFormat.PNG, 100, out)) throw new IOException("Could not encode the skin");
+        return out.toByteArray();
+    }
+
+    /** Microsoft accounts: sends the skin to the Minecraft account with the login token of the account */
+    public static void uploadToMojang(@NonNull MinecraftAccount account, @NonNull Bitmap skin, boolean slim) throws IOException {
+        if (account.accessToken == null || account.accessToken.isEmpty()) {
+            throw new IOException("The account has no login token, log in again");
+        }
+        byte[] png = toPng(skin);
+        String boundary = "----NexaSkin" + System.nanoTime();
+        HttpURLConnection connection = (HttpURLConnection) new URL(
+                "https://api.minecraftservices.com/minecraft/profile/skins").openConnection();
+        try {
+            connection.setRequestMethod("POST");
+            connection.setDoOutput(true);
+            connection.setConnectTimeout(15000);
+            connection.setReadTimeout(30000);
+            connection.setRequestProperty("Authorization", "Bearer " + account.accessToken);
+            connection.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
+            try (OutputStream out = connection.getOutputStream()) {
+                write(out, "--" + boundary + "\r\n"
+                        + "Content-Disposition: form-data; name=\"variant\"\r\n\r\n"
+                        + (slim ? "slim" : "classic") + "\r\n");
+                write(out, "--" + boundary + "\r\n"
+                        + "Content-Disposition: form-data; name=\"file\"; filename=\"skin.png\"\r\n"
+                        + "Content-Type: image/png\r\n\r\n");
+                out.write(png);
+                write(out, "\r\n--" + boundary + "--\r\n");
+            }
+            int code = connection.getResponseCode();
+            if (code != 200) {
+                String body = "";
+                InputStream error = connection.getErrorStream();
+                if (error != null) {
+                    try (InputStream in = error; ByteArrayOutputStream bytes = new ByteArrayOutputStream()) {
+                        byte[] buffer = new byte[2048];
+                        int read;
+                        while ((read = in.read(buffer)) != -1 && bytes.size() < 2048) bytes.write(buffer, 0, read);
+                        body = bytes.toString("UTF-8");
+                    }
+                }
+                throw new IOException("Mojang answered " + code
+                        + (code == 401 ? " (the login expired, log in again with your account)" : "")
+                        + (body.isEmpty() ? "" : ": " + body));
+            }
+        } finally {
+            connection.disconnect();
+        }
+    }
+
+    private static void write(OutputStream out, String text) throws IOException {
+        out.write(text.getBytes(StandardCharsets.UTF_8));
+    }
+
+    /**
+     * Local accounts have no skin on a server. The skin is applied with a resource pack that replaces
+     * the default skins (no mod needed), and also saved where the CustomSkinLoader mod looks for it.
+     * @return the message to show to the user
+     */
+    public static String saveForCustomSkinLoader(@NonNull String username, @NonNull Bitmap skin) throws IOException {
+        byte[] png = toPng(skin);
+        MinecraftProfile profile = LauncherProfiles.getCurrentProfile();
+        File gameDir = Tools.getGameDirPath(profile);
+
+        File loaderFolder = new File(gameDir, "CustomSkinLoader/LocalSkin/skins");
+        //noinspection ResultOfMethodCallIgnored
+        loaderFolder.mkdirs();
+        try (OutputStream out = new FileOutputStream(new File(loaderFolder, username + ".png"))) {
+            out.write(png);
+        }
+        SkinPackBuilder.install(gameDir, png, QuickPackInstaller.resolveMcVersion(profile.lastVersionId));
+        return "Skin applied to this profile with a resource pack (no mods needed). It is also saved for the "
+                + "CustomSkinLoader mod. Restart the game to see it.";
+    }
+
+    /** Ely.by accounts: the skin is changed on the Ely.by website, so the file is saved for uploading there */
+    public static File saveForUpload(@NonNull String username, @NonNull Bitmap skin) throws IOException {
+        byte[] png = toPng(skin);
+        File folder = new File(Tools.DIR_GAME_HOME, "nexa_skins");
+        //noinspection ResultOfMethodCallIgnored
+        folder.mkdirs();
+        String stamp = new SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(new Date());
+        File file = new File(folder, username + "_" + stamp + ".png");
+        try (OutputStream out = new FileOutputStream(file)) {
+            out.write(png);
+        }
+        return file;
+    }
+}
