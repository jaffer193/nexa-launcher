@@ -0,0 +1,78 @@
+package net.kdt.pojavlaunch.fragments;
+
+import android.os.Bundle;
+import android.view.View;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.QuickPackInstaller;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** One-tap installs of curated mod lists (FPS, PvP, Survival) into the selected profile */
+public class QuickPacksFragment extends Fragment {
+    public static final String TAG = "QuickPacksFragment";
+    private static final AtomicBoolean sBusy = new AtomicBoolean(false);
+
+    private TextView mStatus;
+
+    public QuickPacksFragment() {
+        super(R.layout.fragment_quick_packs);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        mStatus = view.findViewById(R.id.pack_status);
+        view.findViewById(R.id.pack_perf_install).setOnClickListener(v ->
+                install(getString(R.string.nexa_pack_perf_title), QuickPackInstaller.PACK_PERFORMANCE));
+        view.findViewById(R.id.pack_pvp_install).setOnClickListener(v ->
+                install(getString(R.string.nexa_pack_pvp_title), QuickPackInstaller.PACK_PVP));
+        view.findViewById(R.id.pack_survival_install).setOnClickListener(v ->
+                install(getString(R.string.nexa_pack_survival_title), QuickPackInstaller.PACK_SURVIVAL));
+    }
+
+    private void install(String packTitle, String[] slugs) {
+        if (!sBusy.compareAndSet(false, true)) {
+            Toast.makeText(requireContext(), R.string.nexa_pack_busy, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        final MinecraftProfile profile;
+        try {
+            profile = LauncherProfiles.getCurrentProfile();
+        } catch (RuntimeException e) {
+            sBusy.set(false);
+            mStatus.setText(R.string.nexa_pack_need_modded);
+            return;
+        }
+        final String workingFormat = getString(R.string.nexa_pack_working);
+        final String doneFormat = getString(R.string.nexa_pack_done);
+        final String needModded = getString(R.string.nexa_pack_need_modded);
+        mStatus.setText("…");
+
+        PojavApplication.sExecutorService.execute(() -> {
+            QuickPackInstaller.Result result;
+            try {
+                result = QuickPackInstaller.install(profile, slugs, (slug, index, total) ->
+                        Tools.runOnUiThread(() -> setStatus(String.format(workingFormat, slug, index, total))));
+            } finally {
+                sBusy.set(false);
+            }
+            final String message = result.needModdedProfile ? needModded
+                    : String.format(doneFormat, result.installed, result.skipped);
+            Tools.runOnUiThread(() -> setStatus(message));
+        });
+    }
+
+    private void setStatus(String text) {
+        if (mStatus != null && isAdded()) mStatus.setText(text);
+    }
+}
