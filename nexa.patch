+package net.kdt.pojavlaunch.nexa;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.fragment.app.Fragment;
+import androidx.fragment.app.FragmentActivity;
+
+import net.kdt.pojavlaunch.PojavApplication;
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.fragments.LogViewerFragment;
+import net.kdt.pojavlaunch.fragments.SkinFragment;
+import net.kdt.pojavlaunch.fragments.StatsFragment;
+import net.kdt.pojavlaunch.prefs.LauncherPreferences;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.File;
+import java.io.IOException;
+
+/** The "More tools" list of the main menu */
+public final class ToolsMenu {
+    private ToolsMenu() {}
+
+    /** @param importAction opens the file picker for a profile zip (it belongs to the fragment) */
+    public static void show(@NonNull final Fragment fragment, @NonNull final Runnable importAction) {
+        final FragmentActivity activity = fragment.requireActivity();
+        String[] items = {
+                activity.getString(R.string.nexa_clone_button),
+                activity.getString(R.string.nexa_tool_export),
+                activity.getString(R.string.nexa_tool_import),
+                activity.getString(R.string.nexa_tool_shortcut),
+                activity.getString(R.string.nexa_tool_stats),
+                activity.getString(R.string.nexa_tool_log),
+                activity.getString(R.string.nexa_tool_skin)
+        };
+        new AlertDialog.Builder(activity)
+                .setTitle(R.string.nexa_tools_button)
+                .setItems(items, (dialog, which) -> {
+                    switch (which) {
+                        case 0: ProfileCloner.promptAndClone(activity); break;
+                        case 1: exportProfile(activity); break;
+                        case 2: importAction.run(); break;
+                        case 3: createShortcut(activity); break;
+                        case 4: Tools.swapFragment(activity, StatsFragment.class, StatsFragment.TAG, null); break;
+                        case 5: Tools.swapFragment(activity, LogViewerFragment.class, LogViewerFragment.TAG, null); break;
+                        default: Tools.swapFragment(activity, SkinFragment.class, SkinFragment.TAG, null); break;
+                    }
+                })
+                .show();
+    }
+
+    private static void exportProfile(Activity activity) {
+        final MinecraftProfile profile;
+        try {
+            profile = LauncherProfiles.getCurrentProfile();
+        } catch (RuntimeException e) {
+            Toast.makeText(activity, R.string.nexa_clone_no_profile, Toast.LENGTH_LONG).show();
+            return;
+        }
+        final Context appContext = activity.getApplicationContext();
+        Toast.makeText(appContext, R.string.nexa_tool_exporting, Toast.LENGTH_SHORT).show();
+        PojavApplication.sExecutorService.execute(() -> {
+            String message;
+            try {
+                File zip = ProfileTransfer.export(profile);
+                message = appContext.getString(R.string.nexa_tool_exported, zip.getName(), ProfileTransfer.exportDir().getAbsolutePath());
+            } catch (IOException | RuntimeException e) {
+                e.printStackTrace();
+                message = appContext.getString(R.string.nexa_tool_export_failed, String.valueOf(e.getMessage()));
+            }
+            final String finalMessage = message;
+            Tools.runOnUiThread(() -> Toast.makeText(appContext, finalMessage, Toast.LENGTH_LONG).show());
+        });
+    }
+
+    private static void createShortcut(Activity activity) {
+        try {
+            String key = LauncherPreferences.DEFAULT_PREF.getString(LauncherPreferences.PREF_KEY_CURRENT_PROFILE, "");
+            MinecraftProfile profile = LauncherProfiles.getCurrentProfile();
+            String name = profile.name == null || profile.name.isEmpty() ? "Minecraft" : profile.name;
+            ShortcutHelper.pin(activity, key, name);
+        } catch (RuntimeException e) {
+            Toast.makeText(activity, R.string.nexa_clone_no_profile, Toast.LENGTH_LONG).show();
+        }
+    }
+}
