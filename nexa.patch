+
+        // Back up the worlds that changed since their last backup (in the background, last 3 are kept)
+        if(LauncherPreferences.DEFAULT_PREF.getBoolean(net.kdt.pojavlaunch.nexa.WorldBackup.PREF_AUTO, true)
+                && !LauncherPreferences.DEFAULT_PREF.getBoolean("nexa_safe_mode", false)) {
