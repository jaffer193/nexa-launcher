diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/QuickPackInstaller.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/QuickPackInstaller.java
new file mode 100644
index 0000000..84b38d5
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/QuickPackInstaller.java
@@ -0,0 +1,142 @@
+package net.kdt.pojavlaunch.modloaders.modpacks.api;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.utils.DownloadUtils;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.File;
+import java.util.HashMap;
+import java.util.concurrent.Callable;
+import java.util.regex.Pattern;
+
+/**
+ * Installs a fixed list of Modrinth mods (by project slug) into the mods folder of a profile.
+ * For each mod the newest version matching the profile's Minecraft version and loader is used.
+ * Mods that have no matching version are skipped.
+ */
+public final class QuickPackInstaller {
+    public static final String[] PACK_PERFORMANCE = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "entityculling", "immediatelyfast", "dynamic-fps"
+    };
+    public static final String[] PACK_PVP = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "modmenu", "appleskin", "logical-zoom", "freelook", "mouse-tweaks"
+    };
+    public static final String[] PACK_SURVIVAL = {
+            "fabric-api", "sodium", "embeddium", "lithium", "ferrite-core", "modernfix",
+            "appleskin", "xaeros-minimap", "xaeros-world-map", "jade", "mouse-tweaks"
+    };
+
+    private static final Pattern VERSION_PATTERN = Pattern.compile("^\\d+\\.\\d+(\\.\\d+)?$");
+
+    public interface Listener {
+        void onProgress(String slug, int index, int total);
+    }
+
+    public static final class Result {
+        public int installed;
+        public int skipped;
+        /** True when the selected profile is not a modded one (or cannot be understood) */
+        public boolean needModdedProfile;
+    }
+
+    private QuickPackInstaller() {}
+
+    /** @return fabric, quilt, forge, neoforge or null when the profile is vanilla/unknown */
+    public static @Nullable String detectLoader(@Nullable String versionId) {
+        if (versionId == null) return null;
+        String id = versionId.toLowerCase();
+        if (id.contains("fabric-loader") || id.startsWith("fabric")) return "fabric";
+        if (id.contains("quilt-loader") || id.startsWith("quilt")) return "quilt";
+        if (id.contains("neoforge")) return "neoforge";
+        if (id.contains("forge")) return "forge";
+        return null;
+    }
+
+    /** Extracts the Minecraft version out of a modded version id such as fabric-loader-0.15.11-1.20.1 */
+    public static @Nullable String detectMcVersion(@Nullable String versionId, @Nullable String loader) {
+        if (versionId == null || loader == null) return null;
+        String[] parts = versionId.split("-");
+        if (loader.equals("fabric") || loader.equals("quilt")) {
+            for (int i = parts.length - 1; i >= 0; i--) {
+                if (VERSION_PATTERN.matcher(parts[i]).matches()) return parts[i];
+            }
+        } else {
+            for (String part : parts) {
+                if (VERSION_PATTERN.matcher(part).matches()) return part;
+            }
+        }
+        return null;
+    }
+
+    public static @NonNull Result install(@NonNull MinecraftProfile profile, @NonNull String[] slugs,
+                                          @Nullable Listener listener) {
+        Result result = new Result();
+        String loader = detectLoader(profile.lastVersionId);
+        String mcVersion = detectMcVersion(profile.lastVersionId, loader);
+        if (loader == null || mcVersion == null) {
+            result.needModdedProfile = true;
+            return result;
+        }
+
+        File modsDir = new File(Tools.getGameDirPath(profile), "mods");
+        ApiHandler api = new ApiHandler("https://api.modrinth.com/v2");
+
+        for (int i = 0; i < slugs.length; i++) {
+            String slug = slugs[i];
+            if (listener != null) listener.onProgress(slug, i + 1, slugs.length);
+            try {
+                if (installOne(api, slug, mcVersion, loader, modsDir)) result.installed++;
+                else result.skipped++;
+            } catch (Exception e) {
+                e.printStackTrace();
+                result.skipped++;
+            }
+        }
+        return result;
+    }
+
+    private static boolean installOne(ApiHandler api, String slug, String mcVersion, String loader,
+                                      File modsDir) throws Exception {
+        HashMap<String, Object> query = new HashMap<>();
+        query.put("game_versions", "[\"" + mcVersion + "\"]");
+        query.put("loaders", "[\"" + loader + "\"]");
+        JsonArray versions = api.get("project/" + slug + "/version", query, JsonArray.class);
+        if (versions == null || versions.size() == 0) return false;
+
+        JsonObject version = versions.get(0).getAsJsonObject();
+        JsonArray files = version.getAsJsonArray("files");
+        if (files == null || files.size() == 0) return false;
+
+        JsonObject file = files.get(0).getAsJsonObject();
+        for (JsonElement element : files) {
+            JsonObject candidate = element.getAsJsonObject();
+            if (candidate.has("primary") && candidate.get("primary").getAsBoolean()) {
+                file = candidate;
+                break;
+            }
+        }
+
+        final String url = file.get("url").getAsString();
+        String fileName = file.get("filename").getAsString().replaceAll("[\\\\/:*?\"<>|]", "_");
+        String sha1 = null;
+        if (file.has("hashes") && file.getAsJsonObject("hashes").has("sha1")) {
+            sha1 = file.getAsJsonObject("hashes").get("sha1").getAsString();
+        }
+
+        final File target = new File(modsDir, fileName);
+        DownloadUtils.ensureSha1(target, sha1, (Callable<Void>) () -> {
+            DownloadUtils.downloadFile(url, target);
+            return null;
+        });
+        return true;
+    }
+}
diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/ResourcePackManager.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/ResourcePackManager.java
new file mode 100644
index 0000000..6940443
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/modloaders/modpacks/api/ResourcePackManager.java
@@ -0,0 +1,125 @@
+package net.kdt.pojavlaunch.modloaders.modpacks.api;
+
+import androidx.annotation.NonNull;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Lists the packs in the "resourcepacks" folder of a game directory and keeps the
+ * "resourcePacks" line of options.txt in sync, which is where Minecraft stores the enabled packs.
+ */
+public final class ResourcePackManager {
+    private static final String OPTION_KEY = "resourcePacks:";
+
+    private ResourcePackManager() {}
+
+    public static @NonNull File getPackDir(@NonNull File gameDir) {
+        return new File(gameDir, "resourcepacks");
+    }
+
+    public static @NonNull List<String> listPacks(@NonNull File gameDir) {
+        File[] files = getPackDir(gameDir).listFiles();
+        List<String> names = new ArrayList<>();
+        if (files == null) return names;
+        for (File file : files) {
+            String name = file.getName();
+            if (file.isDirectory() || name.toLowerCase().endsWith(".zip")) names.add(name);
+        }
+        Collections.sort(names, String.CASE_INSENSITIVE_ORDER);
+        return names;
+    }
+
+    /** Names (without the "file/" prefix) of the enabled packs */
+    public static @NonNull List<String> readEnabled(@NonNull File gameDir) {
+        List<String> enabled = new ArrayList<>();
+        try {
+            for (String line : readLines(new File(gameDir, "options.txt"))) {
+                if (!line.startsWith(OPTION_KEY)) continue;
+                String body = line.substring(OPTION_KEY.length()).trim();
+                if (body.startsWith("[")) body = body.substring(1);
+                if (body.endsWith("]")) body = body.substring(0, body.length() - 1);
+                for (String entry : body.split(",")) {
+                    String value = entry.trim();
+                    if (value.startsWith("\"")) value = value.substring(1);
+                    if (value.endsWith("\"")) value = value.substring(0, value.length() - 1);
+                    if (value.startsWith("file/")) enabled.add(value.substring(5));
+                }
+            }
+        } catch (IOException ignored) { }
+        return enabled;
+    }
+
+    public static void setEnabled(@NonNull File gameDir, @NonNull String packName, boolean enable)
+            throws IOException {
+        File optionsFile = new File(gameDir, "options.txt");
+        List<String> lines = readLines(optionsFile);
+
+        List<String> entries = new ArrayList<>();
+        int lineIndex = -1;
+        for (int i = 0; i < lines.size(); i++) {
+            String line = lines.get(i);
+            if (!line.startsWith(OPTION_KEY)) continue;
+            lineIndex = i;
+            String body = line.substring(OPTION_KEY.length()).trim();
+            if (body.startsWith("[")) body = body.substring(1);
+            if (body.endsWith("]")) body = body.substring(0, body.length() - 1);
+            if (!body.trim().isEmpty()) entries.addAll(Arrays.asList(body.split(",")));
+        }
+
+        String target = "\"file/" + packName + "\"";
+        List<String> cleaned = new ArrayList<>();
+        for (String entry : entries) {
+            String trimmed = entry.trim();
+            if (!trimmed.equals(target)) cleaned.add(trimmed);
+        }
+        if (enable) cleaned.add(target);
+
+        StringBuilder newLine = new StringBuilder(OPTION_KEY).append('[');
+        for (int i = 0; i < cleaned.size(); i++) {
+            if (i > 0) newLine.append(',');
+            newLine.append(cleaned.get(i));
+        }
+        newLine.append(']');
+
+        if (lineIndex >= 0) lines.set(lineIndex, newLine.toString());
+        else lines.add(newLine.toString());
+
+        gameDir.mkdirs();
+        try (Writer writer = new OutputStreamWriter(new FileOutputStream(optionsFile), StandardCharsets.UTF_8)) {
+            for (String line : lines) writer.write(line + "\n");
+        }
+    }
+
+    public static void delete(@NonNull File gameDir, @NonNull String packName) throws IOException {
+        setEnabled(gameDir, packName, false);
+        File pack = new File(getPackDir(gameDir), packName);
+        if (pack.isDirectory()) {
+            File[] children = pack.listFiles();
+            if (children != null) for (File child : children) child.delete();
+        }
+        pack.delete();
+    }
+
+    private static @NonNull List<String> readLines(File file) throws IOException {
+        List<String> lines = new ArrayList<>();
+        if (!file.exists()) return lines;
+        try (BufferedReader reader = new BufferedReader(
+                new InputStreamReader(new FileInputStream(file), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) lines.add(line);
+        }
+        return lines;
+    }
+}
