+package net.kdt.pojavlaunch.prefs.screens;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.os.Bundle;
+import android.text.InputType;
+import android.widget.EditText;
+import android.widget.Toast;
+
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+import androidx.preference.EditTextPreference;
+import androidx.preference.Preference;
+
+import net.kdt.pojavlaunch.R;
+import net.kdt.pojavlaunch.nexa.NexaTheme;
+
+/** Settings > Advanced > Appearance: accent colors, title and logo of the launcher */
+public class LauncherPreferenceAppearanceFragment extends LauncherPreferenceFragment {
+    private final ActivityResultLauncher<String> mLogoPicker =
+            registerForActivityResult(new ActivityResultContracts.GetContent(), uri -> {
+                if (uri == null) return;
+                boolean saved = NexaTheme.saveLogo(requireContext(), uri);
+                Toast.makeText(requireContext(),
+                        saved ? R.string.nexa_theme_saved : R.string.nexa_theme_logo_failed,
+                        Toast.LENGTH_SHORT).show();
+            });
+
+    @Override
+    public void onCreatePreferences(Bundle b, String str) {
+        addPreferencesFromResource(R.xml.pref_appearance);
+        updateColorSummaries();
+
+        requirePreference("nexa_ui_mode").setOnPreferenceClickListener(preference -> {
+            String[] modes = {getString(R.string.nexa_mode_portrait), getString(R.string.nexa_mode_wide)};
+            new AlertDialog.Builder(requireContext())
+                    .setTitle(R.string.nexa_mode_title)
+                    .setItems(modes, (dialog, which) -> {
+                        NexaTheme.setWide(requireContext(), which == 1);
+                        updateColorSummaries();
+                        Toast.makeText(requireContext(), R.string.nexa_mode_applied, Toast.LENGTH_SHORT).show();
+                        NexaTheme.applyOrientation(requireActivity()); // turns the screen now
+                    })
+                    .show();
+            return true;
+        });
+        requirePreference("nexa_theme_preset").setOnPreferenceClickListener(preference -> {
+            new AlertDialog.Builder(requireContext())
+                    .setTitle(R.string.nexa_theme_preset_title)
+                    .setItems(NexaTheme.PRESET_NAMES, (dialog, which) -> {
+                        NexaTheme.setAccent(requireContext(), NexaTheme.PRESETS[which][0], NexaTheme.PRESETS[which][1]);
+                        updateColorSummaries();
+                        Toast.makeText(requireContext(), R.string.nexa_theme_saved, Toast.LENGTH_SHORT).show();
+                    })
+                    .show();
+            return true;
+        });
+        requirePreference("nexa_bg_preset").setOnPreferenceClickListener(preference -> {
+            new AlertDialog.Builder(requireContext())
+                    .setTitle(R.string.nexa_theme_bg_title)
+                    .setItems(NexaTheme.BG_PRESET_NAMES, (dialog, which) -> {
+                        NexaTheme.setBackground(requireContext(), NexaTheme.BG_PRESETS[which]);
+                        updateColorSummaries();
+                        Toast.makeText(requireContext(), R.string.nexa_theme_saved, Toast.LENGTH_SHORT).show();
+                    })
+                    .show();
+            return true;
+        });
+        requirePreference("nexa_bg_pick").setOnPreferenceClickListener(preference -> {
+            askBackground();
+            return true;
+        });
+        requirePreference("nexa_accent_start_pick").setOnPreferenceClickListener(preference -> {
+            askColor(true);
+            return true;
+        });
+        requirePreference("nexa_accent_end_pick").setOnPreferenceClickListener(preference -> {
+            askColor(false);
+            return true;
+        });
+        requirePreference("nexa_logo_pick").setOnPreferenceClickListener(preference -> {
+            mLogoPicker.launch("image/*");
+            return true;
+        });
+        requirePreference("nexa_logo_reset").setOnPreferenceClickListener(preference -> {
+            NexaTheme.resetLogo(requireContext());
+            Toast.makeText(requireContext(), R.string.nexa_theme_saved, Toast.LENGTH_SHORT).show();
+            return true;
+        });
+        requirePreference("nexa_appearance_reset").setOnPreferenceClickListener(preference -> {
+            NexaTheme.resetAccent(requireContext());
+            NexaTheme.resetBackground(requireContext());
+            NexaTheme.resetLogo(requireContext());
+            requirePreference(NexaTheme.PREF_TITLE, EditTextPreference.class).setText("");
+            updateColorSummaries();
+            Toast.makeText(requireContext(), R.string.nexa_theme_saved, Toast.LENGTH_SHORT).show();
+            return true;
+        });
+    }
+
+    private void updateColorSummaries() {
+        Context context = requireContext();
+        Preference start = requirePreference("nexa_accent_start_pick");
+        Preference end = requirePreference("nexa_accent_end_pick");
+        requirePreference("nexa_ui_mode").setSummary(NexaTheme.isWide(context)
+                ? R.string.nexa_mode_wide : R.string.nexa_mode_portrait);
+        requirePreference("nexa_bg_pick").setSummary(NexaTheme.colorToHex(NexaTheme.backgroundColor(context)));
+        start.setSummary(NexaTheme.colorToHex(NexaTheme.accentStart(context)));
+        end.setSummary(NexaTheme.colorToHex(NexaTheme.accentEnd(context)));
+    }
+
+    private void askBackground() {
+        final Context context = requireContext();
+        final EditText input = new EditText(context);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
+        input.setText(NexaTheme.colorToHex(NexaTheme.backgroundColor(context)));
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.nexa_theme_bg_hex_title)
+                .setMessage(R.string.nexa_theme_hex_hint)
+                .setView(input)
+                .setPositiveButton(android.R.string.ok, (dialog, which) -> {
+                    Integer color = NexaTheme.parseColor(input.getText().toString());
+                    if (color == null) {
+                        Toast.makeText(context, R.string.nexa_theme_hex_invalid, Toast.LENGTH_SHORT).show();
+                        return;
+                    }
+                    NexaTheme.setBackground(context, color);
+                    updateColorSummaries();
+                    Toast.makeText(context, R.string.nexa_theme_saved, Toast.LENGTH_SHORT).show();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    /** Asks for a color written as #RRGGBB */
+    private void askColor(boolean isStart) {
+        final Context context = requireContext();
+        final EditText input = new EditText(context);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
+        input.setText(NexaTheme.colorToHex(isStart ? NexaTheme.accentStart(context) : NexaTheme.accentEnd(context)));
+        new AlertDialog.Builder(context)
+                .setTitle(isStart ? R.string.nexa_theme_start_title : R.string.nexa_theme_end_title)
+                .setMessage(R.string.nexa_theme_hex_hint)
+                .setView(input)
+                .setPositiveButton(android.R.string.ok, (dialog, which) -> {
+                    Integer color = NexaTheme.parseColor(input.getText().toString());
+                    if (color == null) {
+                        Toast.makeText(context, R.string.nexa_theme_hex_invalid, Toast.LENGTH_SHORT).show();
+                        return;
+                    }
+                    int start = isStart ? color : NexaTheme.accentStart(context);
+                    int end = isStart ? NexaTheme.accentEnd(context) : color;
+                    NexaTheme.setAccent(context, start, end);
+                    updateColorSummaries();
+                    Toast.makeText(context, R.string.nexa_theme_saved, Toast.LENGTH_SHORT).show();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+}
