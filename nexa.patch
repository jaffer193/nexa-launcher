@@ -0,0 +1,261 @@
+package net.kdt.pojavlaunch.nexa;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.MotionEvent;
+import android.view.View;
+
+import net.kdt.pojavlaunch.LwjglGlfwKeycode;
+
+/**
+ * Draws the HUD widgets (FPS, CPS, keystrokes) over the game. It never takes touches, except while
+ * the layout is being edited: then the widgets can be dragged to a new place.
+ */
+public class NexaHudView extends View {
+    public static final String[] IDS = {"fps", "cps", "keys"};
+    private static final int W_FPS = 0;
+    private static final int W_CPS = 1;
+    private static final int W_KEYS = 2;
+    private static final float[][] DEFAULT_POS = {{0.012f, 0.16f}, {0.012f, 0.25f}, {0.80f, 0.42f}};
+    private static final long TICK_MS = 250;
+
+    public static String xKey(String id) { return "nexa_hud_x_" + id; }
+    public static String yKey(String id) { return "nexa_hud_y_" + id; }
+    public static String bgKey(String id) { return "nexa_hud_bg_" + id; }
+    public static String scaleKey(String id) { return "nexa_hud_scale_" + id; }
+
+    private final float mDensity;
+    private final float[][] mPos = new float[3][2];
+    private final boolean[] mBackground = new boolean[3];
+    private final float[] mScale = new float[3];
+    private final boolean[] mShown = new boolean[3];
+
+    private final Paint mTextPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mOutlinePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mTick = new Runnable() {
+        @Override
+        public void run() {
+            if (mShown[W_FPS]) mFps = NexaClient.readFps();
+            if (mShown[W_FPS] || mShown[W_CPS] || mShown[W_KEYS] || mEditing) invalidate();
+            mHandler.postDelayed(this, TICK_MS);
+        }
+    };
+
+    private int mFps = -1;
+    private boolean mEditing = false;
+    private int mDragging = -1;
+    private float mDragOffsetX, mDragOffsetY;
+
+    public NexaHudView(Context context) {
+        super(context);
+        mDensity = context.getResources().getDisplayMetrics().density;
+        setClickable(false);
+        setFocusable(false);
+        mTextPaint.setColor(Color.WHITE);
+        mTextPaint.setTypeface(Typeface.DEFAULT_BOLD);
+        mOutlinePaint.setStyle(Paint.Style.STROKE);
+        mOutlinePaint.setStrokeWidth(2 * mDensity);
+        mOutlinePaint.setColor(Color.argb(220, 255, 255, 255));
+        reloadConfig();
+    }
+
+    /** Reads the preferences again (after a setting changed) */
+    public void reloadConfig() {
+        SharedPreferences prefs = NexaClient.prefs(getContext());
+        mShown[W_FPS] = prefs.getBoolean(NexaClient.PREF_FPS, true);
+        mShown[W_CPS] = prefs.getBoolean(NexaClient.PREF_CPS, true);
+        mShown[W_KEYS] = prefs.getBoolean(NexaClient.PREF_KEYSTROKES, false);
+        for (int i = 0; i < IDS.length; i++) {
+            mPos[i][0] = prefs.getFloat(xKey(IDS[i]), DEFAULT_POS[i][0]);
+            mPos[i][1] = prefs.getFloat(yKey(IDS[i]), DEFAULT_POS[i][1]);
+            mBackground[i] = prefs.getBoolean(bgKey(IDS[i]), true);
+            mScale[i] = prefs.getFloat(scaleKey(IDS[i]), 1f);
+        }
+        invalidate();
+    }
+
+    public void setEditing(boolean editing) {
+        mEditing = editing;
+        mDragging = -1;
+        invalidate();
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        mHandler.removeCallbacks(mTick);
+        mHandler.post(mTick);
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mHandler.removeCallbacks(mTick);
+        super.onDetachedFromWindow();
+    }
+
+    // ---- Geometry ------------------------------------------------------------------------------
+
+    private float cell(int id) { return 34 * mDensity * mScale[id]; }
+    private float gap(int id) { return 3 * mDensity * mScale[id]; }
+    private float pad(int id) { return 6 * mDensity * mScale[id]; }
+
+    private String textOf(int id) {
+        if (id == W_FPS) return "FPS: " + (mFps >= 0 ? String.valueOf(mFps) : "--");
+        return "CPS: " + NexaClient.getCps(true) + " | " + NexaClient.getCps(false);
+    }
+
+    private float widthOf(int id) {
+        if (id == W_KEYS) return 3 * cell(id) + 2 * gap(id);
+        mTextPaint.setTextSize(14 * mDensity * mScale[id]);
+        return mTextPaint.measureText(textOf(id)) + 2 * pad(id);
+    }
+
+    private float heightOf(int id) {
+        if (id == W_KEYS) return 4 * cell(id) + 3 * gap(id);
+        return 14 * mDensity * mScale[id] + 2 * pad(id);
+    }
+
+    private float leftOf(int id) {
+        float max = Math.max(0f, getWidth() - widthOf(id));
+        return Math.max(0f, Math.min(mPos[id][0] * getWidth(), max));
+    }
+
+    private float topOf(int id) {
+        float max = Math.max(0f, getHeight() - heightOf(id));
+        return Math.max(0f, Math.min(mPos[id][1] * getHeight(), max));
+    }
+
+    private boolean isVisible(int id) {
+        return mEditing || mShown[id];
+    }
+
+    // ---- Drawing -------------------------------------------------------------------------------
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        for (int id = 0; id < IDS.length; id++) {
+            if (!isVisible(id)) continue;
+            // While editing, widgets that are turned off are drawn faded so they can still be placed
+            int alpha = mShown[id] ? 255 : 110;
+            if (id == W_KEYS) drawKeys(canvas, id, alpha);
+            else drawText(canvas, id, alpha);
+            if (mEditing) {
+                mRect.set(leftOf(id), topOf(id), leftOf(id) + widthOf(id), topOf(id) + heightOf(id));
+                canvas.drawRoundRect(mRect, 6 * mDensity, 6 * mDensity, mOutlinePaint);
+            }
+        }
+    }
+
+    private void drawText(Canvas canvas, int id, int alpha) {
+        float left = leftOf(id);
+        float top = topOf(id);
+        float width = widthOf(id);
+        float height = heightOf(id);
+        if (mBackground[id]) {
+            mFillPaint.setColor(Color.argb(alpha * 130 / 255, 0, 0, 0));
+            mRect.set(left, top, left + width, top + height);
+            canvas.drawRoundRect(mRect, 6 * mDensity, 6 * mDensity, mFillPaint);
+        }
+        mTextPaint.setTextSize(14 * mDensity * mScale[id]);
+        mTextPaint.setColor(Color.argb(alpha, 255, 255, 255));
+        Paint.FontMetrics metrics = mTextPaint.getFontMetrics();
+        float baseline = top + height / 2f - (metrics.ascent + metrics.descent) / 2f;
+        canvas.drawText(textOf(id), left + pad(id), baseline, mTextPaint);
+    }
+
+    private void drawKey(Canvas canvas, String label, float left, float top, float width, float height,
+                         boolean pressed, int alpha, int id) {
+        mFillPaint.setColor(pressed ? Color.argb(alpha * 200 / 255, 255, 255, 255)
+                : Color.argb(alpha * 130 / 255, 0, 0, 0));
+        mRect.set(left, top, left + width, top + height);
+        canvas.drawRoundRect(mRect, 5 * mDensity, 5 * mDensity, mFillPaint);
+        mTextPaint.setTextSize(12 * mDensity * mScale[id]);
+        mTextPaint.setColor(pressed ? Color.argb(alpha, 0, 0, 0) : Color.argb(alpha, 255, 255, 255));
+        Paint.FontMetrics metrics = mTextPaint.getFontMetrics();
+        float baseline = top + height / 2f - (metrics.ascent + metrics.descent) / 2f;
+        float textWidth = mTextPaint.measureText(label);
+        canvas.drawText(label, left + (width - textWidth) / 2f, baseline, mTextPaint);
+    }
+
+    private void drawKeys(Canvas canvas, int id, int alpha) {
+        float left = leftOf(id);
+        float top = topOf(id);
+        float cell = cell(id);
+        float gap = gap(id);
+        float step = cell + gap;
+        float fullWidth = 3 * cell + 2 * gap;
+        float halfWidth = (fullWidth - gap) / 2f;
+
+        drawKey(canvas, "W", left + step, top, cell, cell,
+                NexaClient.isKeyDown(LwjglGlfwKeycode.GLFW_KEY_W), alpha, id);
+        drawKey(canvas, "A", left, top + step, cell, cell,
+                NexaClient.isKeyDown(LwjglGlfwKeycode.GLFW_KEY_A), alpha, id);
+        drawKey(canvas, "S", left + step, top + step, cell, cell,
+                NexaClient.isKeyDown(LwjglGlfwKeycode.GLFW_KEY_S), alpha, id);
+        drawKey(canvas, "D", left + 2 * step, top + step, cell, cell,
+                NexaClient.isKeyDown(LwjglGlfwKeycode.GLFW_KEY_D), alpha, id);
+        drawKey(canvas, "LMB", left, top + 2 * step, halfWidth, cell,
+                NexaClient.isMouseDown(true), alpha, id);
+        drawKey(canvas, "RMB", left + halfWidth + gap, top + 2 * step, halfWidth, cell,
+                NexaClient.isMouseDown(false), alpha, id);
+        drawKey(canvas, "SPACE", left, top + 3 * step, fullWidth, cell,
+                NexaClient.isKeyDown(LwjglGlfwKeycode.GLFW_KEY_SPACE), alpha, id);
+    }
+
+    // ---- Dragging (only while editing the layout) ---------------------------------------------
+
+    private int hitTest(float x, float y) {
+        for (int id = IDS.length - 1; id >= 0; id--) {
+            float left = leftOf(id);
+            float top = topOf(id);
+            if (x >= left && x <= left + widthOf(id) && y >= top && y <= top + heightOf(id)) return id;
+        }
+        return -1;
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        if (!mEditing || getWidth() == 0 || getHeight() == 0) return false;
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mDragging = hitTest(event.getX(), event.getY());
+                if (mDragging < 0) return false;
+                mDragOffsetX = event.getX() - leftOf(mDragging);
+                mDragOffsetY = event.getY() - topOf(mDragging);
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (mDragging < 0) return false;
+                mPos[mDragging][0] = (event.getX() - mDragOffsetX) / getWidth();
+                mPos[mDragging][1] = (event.getY() - mDragOffsetY) / getHeight();
+                invalidate();
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                if (mDragging < 0) return false;
+                // Save the clamped position, so the widget stays where it is shown
+                String id = IDS[mDragging];
+                NexaClient.prefs(getContext()).edit()
+                        .putFloat(xKey(id), leftOf(mDragging) / getWidth())
+                        .putFloat(yKey(id), topOf(mDragging) / getHeight())
+                        .apply();
+                mPos[mDragging][0] = leftOf(mDragging) / getWidth();
+                mPos[mDragging][1] = topOf(mDragging) / getHeight();
+                mDragging = -1;
+                invalidate();
+                return true;
+            default:
+                return false;
+        }
+    }
+}
