+package net.kdt.pojavlaunch.nexa;
+
+import android.content.Context;
+import android.net.wifi.WifiManager;
+
+import androidx.annotation.NonNull;
+
+import java.io.IOException;
+import java.net.DatagramPacket;
+import java.net.InetAddress;
+import java.net.MulticastSocket;
+import java.net.SocketTimeoutException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Finds worlds that were opened to LAN on the same Wi-Fi. Minecraft announces them every second or
+ * two on the multicast group 224.0.2.60, port 4445, with the name and the port of the world.
+ */
+public final class LanScanner {
+    private static final String GROUP = "224.0.2.60";
+    private static final int PORT = 4445;
+    private static final Pattern MOTD = Pattern.compile("\\[MOTD](.*?)\\[/MOTD]", Pattern.DOTALL);
+    private static final Pattern AD = Pattern.compile("\\[AD](\\d+)\\[/AD]");
+
+    private LanScanner() {}
+
+    public static final class LanWorld {
+        public final String motd;
+        public final String address; // host:port
+
+        LanWorld(String motd, String address) {
+            this.motd = motd;
+            this.address = address;
+        }
+    }
+
+    /** Listens for the given time (blocking, call it from a background thread) */
+    public static @NonNull List<LanWorld> scan(@NonNull Context context, int durationMs) {
+        List<LanWorld> found = new ArrayList<>();
+        WifiManager wifi = (WifiManager) context.getApplicationContext().getSystemService(Context.WIFI_SERVICE);
+        // Android drops multicast packets to save battery unless a lock is held
+        WifiManager.MulticastLock lock = wifi == null ? null : wifi.createMulticastLock("nexa-lan-scan");
+        if (lock != null) {
+            lock.setReferenceCounted(false);
+            lock.acquire();
+        }
+        MulticastSocket socket = null;
+        try {
+            socket = new MulticastSocket(PORT);
+            socket.setSoTimeout(1000);
+            socket.joinGroup(InetAddress.getByName(GROUP));
+            long end = System.currentTimeMillis() + durationMs;
+            byte[] buffer = new byte[1024];
+            while (System.currentTimeMillis() < end) {
+                DatagramPacket packet = new DatagramPacket(buffer, buffer.length);
+                try {
+                    socket.receive(packet);
+                } catch (SocketTimeoutException e) {
+                    continue;
+                }
+                String text = new String(packet.getData(), 0, packet.getLength(), StandardCharsets.UTF_8);
+                Matcher ad = AD.matcher(text);
+                if (!ad.find()) continue;
+                Matcher motd = MOTD.matcher(text);
+                String name = motd.find() ? motd.group(1).trim() : "LAN world";
+                String address = packet.getAddress().getHostAddress() + ":" + ad.group(1);
+                boolean known = false;
+                for (LanWorld world : found) if (world.address.equals(address)) known = true;
+                if (!known) found.add(new LanWorld(name, address));
+            }
+        } catch (IOException | RuntimeException e) {
+            e.printStackTrace();
+        } finally {
+            if (socket != null) socket.close();
+            if (lock != null && lock.isHeld()) lock.release();
+        }
+        return found;
+    }
+}
