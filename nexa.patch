+     */
+    public static int filterKey(int keycode, boolean isDown) {
+        synchronized (LOCK) {
+            if (keycode == LwjglGlfwKeycode.GLFW_KEY_LEFT_CONTROL && sSprintEnabled) {
+                if (!isDown) return -1;
+                sSprintHeld = !sSprintHeld;
+                setKey(keycode, sSprintHeld);
+                return sSprintHeld ? 1 : 0;
+            }
+            if (keycode == LwjglGlfwKeycode.GLFW_KEY_LEFT_SHIFT && sSneakEnabled) {
+                if (!isDown) return -1;
+                sSneakHeld = !sSneakHeld;
+                setKey(keycode, sSneakHeld);
+                return sSneakHeld ? 1 : 0;
+            }
+            setKey(keycode, isDown);
+            return isDown ? 1 : 0;
+        }
+    }
+
+    public static void onMouse(int button, boolean isDown) {
+        long now = SystemClock.uptimeMillis();
+        synchronized (LOCK) {
+            if (button == LwjglGlfwKeycode.GLFW_MOUSE_BUTTON_LEFT) {
+                sLeftDown = isDown;
+                if (isDown) sLeftClicks.addLast(now);
+            } else if (button == LwjglGlfwKeycode.GLFW_MOUSE_BUTTON_RIGHT) {
+                sRightDown = isDown;
+                if (isDown) sRightClicks.addLast(now);
+            }
+        }
+    }
+
+    private static void setKey(int keycode, boolean down) {
+        if (keycode >= 0 && keycode < KEY_COUNT) sKeyDown[keycode] = down;
+    }
+
+    // ---- State read by the HUD -----------------------------------------------------------------
+
+    public static boolean isKeyDown(int keycode) {
+        synchronized (LOCK) {
+            return keycode >= 0 && keycode < KEY_COUNT && sKeyDown[keycode];
+        }
+    }
+
+    public static boolean isMouseDown(boolean left) {
+        synchronized (LOCK) {
+            return left ? sLeftDown : sRightDown;
+        }
+    }
+
+    public static int getCps(boolean left) {
+        long now = SystemClock.uptimeMillis();
+        synchronized (LOCK) {
+            ArrayDeque<Long> clicks = left ? sLeftClicks : sRightClicks;
+            while (!clicks.isEmpty() && now - clicks.peekFirst() > CPS_WINDOW_MS) clicks.pollFirst();
+            return clicks.size();
+        }
+    }
+
+    /**
+     * The game's own frame rate. The Java side of the GLFW bridge writes it once per second, because
+     * only it sees the real buffer swaps.
+     * @return -1 when it is not available (game not started yet, or the file is stale)
+     */
+    public static int readFps() {
+        File file = new File(Tools.DIR_GAME_HOME, FPS_FILE);
+        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
+            String line = reader.readLine();
+            if (line == null) return -1;
+            String[] parts = line.split(";");
+            if (parts.length < 2) return -1;
+            long timestamp = Long.parseLong(parts[1].trim());
+            if (System.currentTimeMillis() - timestamp > 3500) return -1;
+            return Integer.parseInt(parts[0].trim());
+        } catch (IOException | RuntimeException e) {
+            return -1;
+        }
+    }
+
+    /** Forgets the saved positions of the HUD widgets and of the floating circle */
+    public static void resetHudPositions(@NonNull Context context) {
+        SharedPreferences.Editor editor = prefs(context).edit();
+        for (String id : NexaHudView.IDS) {
+            editor.remove(NexaHudView.xKey(id)).remove(NexaHudView.yKey(id));
+        }
+        editor.remove("nexa_bubble_fx").remove("nexa_bubble_fy");
+        editor.apply();
+    }
+}
