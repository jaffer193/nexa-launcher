+
+/** Shows the end of the game log, with a switch to show only the lines that look like errors */
+public class LogViewerFragment extends Fragment {
+    public static final String TAG = "LogViewerFragment";
+    private static final int MAX_BYTES = 300 * 1024;
+    private static final int MAX_LINES = 3000;
+
+    private final List<String> mAllLines = new ArrayList<>();
+    private final List<String> mShown = new ArrayList<>();
+    private boolean mErrorsOnly = false;
+    private ArrayAdapter<String> mAdapter;
+    private ListView mList;
+    private TextView mStatus;
+    private TextView mToggleButton;
+
+    public LogViewerFragment() {
+        super(R.layout.fragment_nexa_list);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        NexaTheme.applyBackground(view);
+        ((TextView) view.findViewById(R.id.nl_title)).setText(R.string.nexa_log_title);
+        mStatus = view.findViewById(R.id.nl_status);
+        mList = view.findViewById(R.id.nl_list);
+
+        mAdapter = new ArrayAdapter<String>(requireContext(), android.R.layout.simple_list_item_1, mShown) {
+            @NonNull
+            @Override
+            public View getView(int position, @Nullable View convertView, @NonNull ViewGroup parent) {
+                TextView text = (TextView) super.getView(position, convertView, parent);
+                text.setTypeface(Typeface.MONOSPACE);
+                text.setTextSize(11);
+                text.setTextColor(ContextCompat.getColor(getContext(), R.color.primary_text));
+                return text;
+            }
+        };
+        mList.setAdapter(mAdapter);
+
+        mToggleButton = view.findViewById(R.id.nl_action1);
+        mToggleButton.setOnClickListener(v -> {
+            mErrorsOnly = !mErrorsOnly;
+            applyFilter();
+        });
+        TextView copy = view.findViewById(R.id.nl_action2);
+        copy.setText(R.string.nexa_log_copy);
+        copy.setOnClickListener(v -> copyShown());
+
+        load();
+    }
+
+    private void load() {
+        mStatus.setText(R.string.nexa_log_loading);
+        PojavApplication.sExecutorService.execute(() -> {
+            final List<String> lines = readLines(new File(Tools.DIR_GAME_HOME, "latestlog.txt"));
+            Tools.runOnUiThread(() -> {
+                if (!isAdded()) return;
+                mAllLines.clear();
+                mAllLines.addAll(lines);
+                applyFilter();
+            });
+        });
+    }
+
+    private static List<String> readLines(File file) {
+        List<String> lines = new ArrayList<>();
+        if (!file.exists()) return lines;
+        try (RandomAccessFile reader = new RandomAccessFile(file, "r")) {
+            long length = reader.length();
+            long start = Math.max(0, length - MAX_BYTES);
+            reader.seek(start);
+            byte[] data = new byte[(int) (length - start)];
+            reader.readFully(data);
+            String[] split = new String(data, StandardCharsets.UTF_8).split("\n");
+            int from = Math.max(0, split.length - MAX_LINES);
+            for (int i = from; i < split.length; i++) lines.add(split[i]);
+        } catch (IOException | RuntimeException e) {
+            lines.clear();
+        }
+        return lines;
+    }
+
+    private static boolean looksLikeError(String line) {
+        String lower = line.toLowerCase(Locale.ROOT);
+        return lower.contains("error") || lower.contains("exception") || lower.contains("fatal")
+                || lower.contains("caused by") || lower.contains("crash");
+    }
+
+    private void applyFilter() {
+        mShown.clear();
+        for (String line : mAllLines) {
+            if (!mErrorsOnly || looksLikeError(line)) mShown.add(line);
+        }
+        mAdapter.notifyDataSetChanged();
+        mToggleButton.setText(mErrorsOnly ? R.string.nexa_log_show_all : R.string.nexa_log_errors_only);
+        if (mAllLines.isEmpty()) mStatus.setText(R.string.nexa_log_empty);
+        else mStatus.setText(getString(R.string.nexa_log_status, mShown.size(), mAllLines.size()));
+        if (!mShown.isEmpty()) mList.setSelection(mShown.size() - 1); // the newest lines are at the end
+    }
+
+    private void copyShown() {
+        StringBuilder text = new StringBuilder();
+        for (String line : mShown) {
+            if (text.length() > 200 * 1024) break;
+            text.append(line).append('\n');
+        }
+        ClipboardManager clipboard = (ClipboardManager) requireContext().getSystemService(Context.CLIPBOARD_SERVICE);
+        if (clipboard != null) {
+            clipboard.setPrimaryClip(ClipData.newPlainText("Nexa log", text.toString()));
+            Toast.makeText(requireContext(), R.string.nexa_log_copied, Toast.LENGTH_SHORT).show();
+        }
+    }
+}
