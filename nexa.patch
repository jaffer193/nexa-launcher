+package net.kdt.pojavlaunch.nexa;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.modloaders.modpacks.api.QuickPackInstaller;
+import net.kdt.pojavlaunch.prefs.LauncherPreferences;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+/**
+ * Checks a mod file before it goes into the mods folder of a profile:
+ * - it must be a readable .jar
+ * - it must be made for the loader of the profile (a Fabric mod does not run on Forge)
+ * - the Minecraft version it asks for must match the profile
+ * - it must not be installed already (same file, same content, or the same mod id)
+ * A mod that has no readable metadata is accepted, but reported as "could not be verified".
+ */
+public final class ModGuard {
+    private static final String PREF_TARGET_PREFIX = "nexa_target_";
+    private static final int MAX_TEXT = 256 * 1024;
+
+    private ModGuard() {}
+
+    /** The loader and Minecraft version that the mods of a profile must be made for */
+    public static final class Target {
+        public final @Nullable String loader; // fabric, quilt, forge, neoforge, or null for vanilla
+        public final @Nullable String mcVersion;
+
+        public Target(@Nullable String loader, @Nullable String mcVersion) {
+            this.loader = loader;
+            this.mcVersion = mcVersion;
+        }
+    }
+
+    public static final class Info {
+        public boolean readable;
+        /** Loaders the jar declares (some mods support several) */
+        public final Set<String> loaders = new LinkedHashSet<>();
+        public final Map<String, String> modIds = new LinkedHashMap<>();
+        public final Map<String, String> mcRanges = new LinkedHashMap<>();
+    }
+
+    public enum Reason { INVALID, NO_LOADER, WRONG_LOADER, WRONG_VERSION, ALREADY_INSTALLED }
+
+    /** The mod was refused. {@link #getMessage()} says why, in plain words. */
+    public static final class RejectedException extends IOException {
+        public final Reason reason;
+        public final @Nullable String existingFile;
+
+        RejectedException(Reason reason, String message, @Nullable String existingFile) {
+            super(message);
+            this.reason = reason;
+            this.existingFile = existingFile;
+        }
+    }
+
+    /** Result of an accepted mod */
+    public static final class Admitted {
+        public final File file;
+        public final boolean verified;
+
+        Admitted(File file, boolean verified) {
+            this.file = file;
+            this.verified = verified;
+        }
+    }
+
+    // ---- Target of a profile -------------------------------------------------------------------
+
+    public static @NonNull Target targetFor(@NonNull MinecraftProfile profile) {
+        String id = profile.lastVersionId;
+        String loader = QuickPackInstaller.detectLoader(id);
+        if (loader != null) return new Target(loader, QuickPackInstaller.detectMcVersion(id, loader));
+
+        String mc = QuickPackInstaller.resolveMcVersion(id);
+        // A guided profile whose Forge/NeoForge installer has not run yet is still a vanilla id
+        String saved = LauncherPreferences.DEFAULT_PREF.getString(targetKey(Tools.getGameDirPath(profile)), null);
+        if (saved != null) {
+            String[] parts = saved.split("\\|", -1);
+            if (parts.length == 2 && !parts[0].isEmpty() && parts[1].equals(mc)) return new Target(parts[0], mc);
+        }
+        return new Target(null, mc);
+    }
+
+    /** Remembers the loader chosen in the guided wizard for a game folder */
+    public static void rememberTarget(@NonNull File gameDir, @Nullable String loader, @Nullable String mcVersion) {
+        if (loader == null || mcVersion == null) return;
+        LauncherPreferences.DEFAULT_PREF.edit().putString(targetKey(gameDir), loader + "|" + mcVersion).apply();
+    }
+
+    private static String targetKey(File gameDir) {
+        return PREF_TARGET_PREFIX + Integer.toHexString(gameDir.getAbsolutePath().hashCode());
+    }
+
+    public static String prettyLoader(@Nullable String loader) {
+        if (loader == null) return "Vanilla";
+        switch (loader) {
+            case "fabric": return "Fabric";
+            case "quilt": return "Quilt";
+            case "forge": return "Forge";
+            case "neoforge": return "NeoForge";
+            default: return loader;
+        }
+    }
+
+    // ---- Admission -----------------------------------------------------------------------------
+
+    /**
+     * Checks the candidate file and, if it passes, copies it into the mods folder.
+     * The candidate itself is left alone (the caller deletes its temporary file).
+     * @param displayName the name shown in messages and used as the file name
+     */
+    public static @NonNull Admitted admit(@NonNull File candidate, @NonNull String displayName,
+                                          @NonNull File modsDir, @NonNull Target target) throws IOException {
+        Info info = readInfo(candidate);
+        if (!info.readable) {
+            throw new RejectedException(Reason.INVALID, displayName + ": not a valid .jar file.", null);
+        }
+        if (target.loader == null) {
+            throw new RejectedException(Reason.NO_LOADER, displayName
+                    + ": this profile has no mod loader (it is Vanilla), so mods cannot be used. "
+                    + "Choose Fabric, Forge, NeoForge or Quilt for the profile.", null);
+        }
+
+        boolean verified = !info.loaders.isEmpty();
+        String matchedLoader = null;
+        if (verified) {
+            for (String loader : info.loaders) {
+                if (isCompatible(loader, target)) {
+                    matchedLoader = loader;
+                    break;
+                }
+            }
+            if (matchedLoader == null) {
+                throw new RejectedException(Reason.WRONG_LOADER, displayName + ": this is a "
+                        + joinPretty(info.loaders) + " mod, but the profile uses "
+                        + prettyLoader(target.loader) + ".", null);
+            }
+            String range = info.mcRanges.get(matchedLoader);
+            if (range != null && target.mcVersion != null && !matchesRange(range, target.mcVersion)) {
+                throw new RejectedException(Reason.WRONG_VERSION, displayName + ": needs Minecraft "
+                        + range + ", but the profile is " + target.mcVersion + ".", null);
+            }
+        }
+
+        checkDuplicates(candidate, displayName, info, matchedLoader, modsDir);
+
+        //noinspection ResultOfMethodCallIgnored
+        modsDir.mkdirs();
+        File destination = new File(modsDir, displayName);
+        // Copy under a temporary name first: a half-written .jar would stop the whole game
+        File partial = new File(modsDir, displayName + ".part");
+        copy(candidate, partial);
+        if (destination.exists() && !destination.delete()) {
+            //noinspection ResultOfMethodCallIgnored
+            partial.delete();
+            throw new IOException(displayName + ": could not replace the old file.");
+        }
+        if (!partial.renameTo(destination)) {
+            //noinspection ResultOfMethodCallIgnored
+            partial.delete();
+            throw new IOException(displayName + ": could not be saved.");
+        }
+        return new Admitted(destination, verified);
+    }
+
+    private static void checkDuplicates(File candidate, String displayName, Info info,
+                                        @Nullable String matchedLoader, File modsDir) throws IOException {
+        File[] existing = modsDir.listFiles();
+        if (existing == null) return;
+        String sha1 = null;
+        String modId = matchedLoader != null ? info.modIds.get(matchedLoader) : null;
+        for (File file : existing) {
+            String name = file.getName();
+            if (!file.isFile() || !name.toLowerCase(Locale.ROOT).endsWith(".jar")) continue;
+            if (name.equalsIgnoreCase(displayName)) {
+                throw new RejectedException(Reason.ALREADY_INSTALLED,
+                        displayName + ": already installed.", name);
+            }
+            if (sha1 == null) sha1 = sha1Of(candidate);
+            if (sha1 != null && sha1.equals(sha1Of(file))) {
+                throw new RejectedException(Reason.ALREADY_INSTALLED,
+                        displayName + ": already installed as " + name + ".", name);
+            }
+            if (modId != null) {
+                Info other = readInfo(file);
+                for (String id : other.modIds.values()) {
+                    if (modId.equals(id)) {
+                        throw new RejectedException(Reason.ALREADY_INSTALLED, displayName
+                                + ": this mod is already installed as " + name
+                                + ". Remove that file first if you want another version.", name);
+                    }
+                }
+            }
+        }
+    }
+
+    private static boolean isCompatible(String modLoader, Target target) {
+        if (modLoader.equals(target.loader)) return true;
+        // Quilt loads Fabric mods
+        if ("quilt".equals(target.loader) && "fabric".equals(modLoader)) return true;
+        // NeoForge kept reading the old Forge format until Minecraft 1.20.4
+        if ("neoforge".equals(target.loader) && "forge".equals(modLoader) && target.mcVersion != null) {
+            try {
+                return compareVersions(target.mcVersion, "1.20.4") <= 0;
+            } catch (NumberFormatException e) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String joinPretty(Set<String> loaders) {
+        StringBuilder text = new StringBuilder();
+        for (String loader : loaders) {
+            if (text.length() > 0) text.append("/");
+            text.append(prettyLoader(loader));
+        }
+        return text.toString();
+    }
+
+    // ---- Overview of a mods folder -------------------------------------------------------------
+
+    /** One line per mod file, with a mark telling whether it fits the profile */
+    public static @NonNull List<String> describeInstalled(@NonNull File modsDir, @NonNull Target target) {
+        List<String> lines = new ArrayList<>();
+        File[] files = modsDir.listFiles();
+        if (files == null) return lines;
+        java.util.Arrays.sort(files, (a, b) -> a.getName().compareToIgnoreCase(b.getName()));
+        for (File file : files) {
+            String name = file.getName();
+            if (!file.isFile() || !name.toLowerCase(Locale.ROOT).endsWith(".jar")) continue;
+            Info info = readInfo(file);
+            String mark;
+            if (!info.readable) mark = "\u2717";
+            else if (info.loaders.isEmpty()) mark = "?";
+            else {
+                mark = "\u2717";
+                for (String loader : info.loaders) {
+                    if (target.loader != null && isCompatible(loader, target)) {
+                        String range = info.mcRanges.get(loader);
+                        boolean fits = range == null || target.mcVersion == null || matchesRange(range, target.mcVersion);
+                        mark = fits ? "\u2713" : "\u2717";
+                        break;
+                    }
+                }
+            }
+            lines.add(mark + " " + name);
+        }
+        return lines;
+    }
+
+    /**
+     * Finds .jar files in the mods folder that are not readable (empty, cut short, or not a zip at all)
+     * and renames them to .jar.broken so that the mod loader ignores them.
+     * @return the names of the files that were moved
+     */
+    public static @NonNull List<String> quarantineBroken(@NonNull File modsDir) {
+        List<String> moved = new ArrayList<>();
+        File[] files = modsDir.listFiles();
+        if (files == null) return moved;
+        for (File file : files) {
+            String name = file.getName();
+            if (!file.isFile() || !name.toLowerCase(Locale.ROOT).endsWith(".jar")) continue;
+            boolean readable;
+            try (ZipFile ignored = new ZipFile(file)) {
+                readable = true;
+            } catch (IOException | RuntimeException e) {
+                readable = false;
+            }
+            if (readable) continue;
+            File renamed = new File(modsDir, name + ".broken");
+            if (renamed.exists()) //noinspection ResultOfMethodCallIgnored
+                renamed.delete();
+            if (file.renameTo(renamed)) moved.add(name);
+        }
+        return moved;
+    }
+
+    // ---- Reading the jar -----------------------------------------------------------------------
+
+    public static @NonNull Info readInfo(@NonNull File jar) {
+        Info info = new Info();
+        try (ZipFile zip = new ZipFile(jar)) {
+            info.readable = true;
+            try {
+                readFabric(zip, info);
+                readQuilt(zip, info);
+                readToml(zip, info, "META-INF/neoforge.mods.toml", "neoforge");
+                readToml(zip, info, "META-INF/mods.toml", "forge");
+                readLegacyForge(zip, info);
+            } catch (RuntimeException | IOException e) {
+                // Broken metadata: the file is a valid zip, just not verifiable
+            }
+        } catch (IOException | RuntimeException e) {
+            info.readable = false;
+        }
+        return info;
+    }
+
+    private static @Nullable String readText(ZipFile zip, String entryName) throws IOException {
+        ZipEntry entry = zip.getEntry(entryName);
+        if (entry == null) return null;
+        try (InputStream in = zip.getInputStream(entry); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[8192];
+            int read;
+            while ((read = in.read(buffer)) != -1 && out.size() < MAX_TEXT) out.write(buffer, 0, read);
+            return out.toString("UTF-8");
+        }
+    }
+
+    private static void readFabric(ZipFile zip, Info info) throws IOException {
+        String text = readText(zip, "fabric.mod.json");
+        if (text == null) return;
+        info.loaders.add("fabric");
+        JsonObject root = JsonParser.parseString(text).getAsJsonObject();
+        if (root.has("id")) info.modIds.put("fabric", root.get("id").getAsString());
+        if (root.has("depends") && root.get("depends").isJsonObject()) {
+            JsonObject depends = root.getAsJsonObject("depends");
+            if (depends.has("minecraft")) {
+                String range = rangeText(depends.get("minecraft"));
+                if (range != null) info.mcRanges.put("fabric", range);
+            }
+        }
+    }
+
+    private static void readQuilt(ZipFile zip, Info info) throws IOException {
+        String text = readText(zip, "quilt.mod.json");
+        if (text == null) return;
+        info.loaders.add("quilt");
+        JsonObject root = JsonParser.parseString(text).getAsJsonObject();
+        if (!root.has("quilt_loader")) return;
+        JsonObject loader = root.getAsJsonObject("quilt_loader");
+        if (loader.has("id")) info.modIds.put("quilt", loader.get("id").getAsString());
+        if (loader.has("depends") && loader.get("depends").isJsonArray()) {
+            for (JsonElement dependency : loader.getAsJsonArray("depends")) {
+                if (!dependency.isJsonObject()) continue;
+                JsonObject object = dependency.getAsJsonObject();
+                if (object.has("id") && "minecraft".equals(object.get("id").getAsString()) && object.has("versions")) {
+                    String range = rangeText(object.get("versions"));
+                    if (range != null) info.mcRanges.put("quilt", range);
+                }
+            }
+        }
+    }
+
+    /** A Fabric/Quilt version requirement: a string, or a list of strings (any of them is fine) */
+    private static @Nullable String rangeText(JsonElement element) {
+        if (element.isJsonPrimitive()) return element.getAsString();
+        if (element.isJsonArray()) {
+            JsonArray array = element.getAsJsonArray();
+            StringBuilder text = new StringBuilder();
+            for (JsonElement item : array) {
+                if (!item.isJsonPrimitive()) return null;
+                if (text.length() > 0) text.append(" || ");
+                text.append(item.getAsString());
+            }
+            return text.length() == 0 ? null : text.toString();
+        }
+        return null;
+    }
+
+    private static void readToml(ZipFile zip, Info info, String entryName, String loader) throws IOException {
+        String text = readText(zip, entryName);
+        if (text == null) return;
+        info.loaders.add(loader);
+        int modsStart = text.indexOf("[[mods]]");
+        String afterMods = modsStart >= 0 ? text.substring(modsStart) : text;
+        Matcher id = Pattern.compile("(?m)^\\s*modId\\s*=\\s*\"([^\"]+)\"").matcher(afterMods);
+        if (id.find()) info.modIds.put(loader, id.group(1));
+
+        // Every [[dependencies.xyz]] block: find the one for minecraft
+        for (String block : text.split("\\[\\[dependencies\\.")) {
+            Matcher dependency = Pattern.compile("(?m)^\\s*modId\\s*=\\s*\"minecraft\"").matcher(block);
+            if (!dependency.find()) continue;
+            Matcher range = Pattern.compile("(?m)^\\s*versionRange\\s*=\\s*\"([^\"]+)\"").matcher(block);
+            if (range.find()) {
+                info.mcRanges.put(loader, range.group(1));
+                break;
+            }
+        }
+    }
+
+    private static void readLegacyForge(ZipFile zip, Info info) throws IOException {
+        if (info.loaders.contains("forge")) return;
+        String text = readText(zip, "mcmod.info");
+        if (text == null) return;
+        info.loaders.add("forge");
+        Matcher id = Pattern.compile("\"modid\"\\s*:\\s*\"([^\"]+)\"").matcher(text);
+        if (id.find()) info.modIds.put("forge", id.group(1));
+    }
+
+    // ---- Version ranges ------------------------------------------------------------------------
+
+    /**
+     * @return false only when the range is understood and the version is outside of it. Anything
+     * that cannot be read counts as a match, so that a mod is never refused by a guess.
+     */
+    static boolean matchesRange(String range, String mcVersion) {
+        try {
+            String trimmed = range.trim();
+            if (trimmed.startsWith("[") || trimmed.startsWith("(")) return matchesMaven(trimmed, mcVersion);
+            return matchesSemver(trimmed, mcVersion);
+        } catch (RuntimeException e) {
+            return true;
+        }
+    }
+
+    /** Maven style: [1.20.1,1.21)  (,1.20]  [1.20.1]  and several of them separated by commas */
+    private static boolean matchesMaven(String range, String version) {
+        for (String part : range.split("(?<=[\\]\\)])\\s*,\\s*(?=[\\[\\(])")) {
+            String p = part.trim();
+            boolean lowerInclusive = p.startsWith("[");
+            boolean upperInclusive = p.endsWith("]");
+            String body = p.substring(1, p.length() - 1);
+            if (!body.contains(",")) {
+                if (compareVersions(version, body.trim()) == 0) return true;
+                continue;
+            }
+            String[] bounds = body.split(",", -1);
+            String lower = bounds[0].trim();
+            String upper = bounds[1].trim();
+            boolean ok = true;
+            if (!lower.isEmpty()) {
+                int c = compareVersions(version, lower);
+                ok = lowerInclusive ? c >= 0 : c > 0;
+            }
+            if (ok && !upper.isEmpty()) {
+                int c = compareVersions(version, upper);
+                ok = upperInclusive ? c <= 0 : c < 0;
+            }
+            if (ok) return true;
+        }
+        return false;
+    }
+
+    /** Fabric style: ">=1.20 <1.21", "~1.20.1", "1.20.x", "*", with || for alternatives */
+    private static boolean matchesSemver(String range, String version) {
+        for (String alternative : range.split("\\|\\|")) {
+            boolean all = true;
+            for (String token : alternative.trim().split("\\s+")) {
+                if (!matchesToken(token, version)) {
+                    all = false;
+                    break;
+                }
+            }
+            if (all) return true;
+        }
+        return false;
+    }
+
+    private static boolean matchesToken(String token, String version) {
+        if (token.isEmpty() || token.equals("*")) return true;
+        String op = "";
+        for (String candidate : new String[]{">=", "<=", ">", "<", "=", "~", "^"}) {
+            if (token.startsWith(candidate)) {
+                op = candidate;
+                break;
+            }
+        }
+        String value = token.substring(op.length());
+        if (value.isEmpty()) return true;
+        if (value.endsWith(".x") || value.endsWith(".*")) {
+            String prefix = value.substring(0, value.length() - 2);
+            return version.equals(prefix) || version.startsWith(prefix + ".");
+        }
+        int c = compareVersions(version, value);
+        switch (op) {
+            case ">=": return c >= 0;
+            case "<=": return c <= 0;
+            case ">": return c > 0;
+            case "<": return c < 0;
+            case "=": return c == 0;
+            case "~": return c >= 0 && sameLeading(version, value, 2);
+            case "^": return c >= 0 && sameLeading(version, value, 1);
+            default: return c == 0 || version.startsWith(value + ".");
+        }
+    }
+
+    private static boolean sameLeading(String a, String b, int count) {
+        String[] pa = a.split("\\.");
+        String[] pb = b.split("\\.");
+        for (int i = 0; i < count; i++) {
+            String x = i < pa.length ? pa[i] : "0";
+            String y = i < pb.length ? pb[i] : "0";
+            if (!x.equals(y)) return false;
+        }
+        return true;
+    }
+
+    /** Compares dotted numbers. Throws NumberFormatException for names like "24w14a". */
+    static int compareVersions(String a, String b) {
+        String[] pa = a.split("\\.");
+        String[] pb = b.split("\\.");
+        for (int i = 0; i < Math.max(pa.length, pb.length); i++) {
+            int x = i < pa.length ? Integer.parseInt(pa[i]) : 0;
+            int y = i < pb.length ? Integer.parseInt(pb[i]) : 0;
+            if (x != y) return Integer.compare(x, y);
+        }
+        return 0;
+    }
+
+    // ---- Files ---------------------------------------------------------------------------------
+
+    private static @Nullable String sha1Of(File file) {
+        try (InputStream in = new FileInputStream(file)) {
+            MessageDigest digest = MessageDigest.getInstance("SHA-1");
+            byte[] buffer = new byte[8192];
+            int read;
+            while ((read = in.read(buffer)) != -1) digest.update(buffer, 0, read);
+            StringBuilder hex = new StringBuilder();
+            for (byte b : digest.digest()) hex.append(String.format("%02x", b));
+            return hex.toString();
+        } catch (IOException | NoSuchAlgorithmException e) {
+            return null;
+        }
+    }
+
+    private static void copy(File from, File to) throws IOException {
+        try (InputStream in = new FileInputStream(from); OutputStream out = new FileOutputStream(to)) {
+            byte[] buffer = new byte[8192];
+            int read;
+            while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+        }
+    }
+}
